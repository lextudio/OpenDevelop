# ignore all obj and bin folders (even in subdirectories)
obj/
bin/
# MSBuild leaves a WPF markup-compilation project beside the real one when a build is interrupted;
# obj/ does not cover it because it sits in the project directory.
*_wpftmp.csproj
/REVISION
/build/*
/AddIns/
/doc/ChangeLog.html
/data/resources/StringResources.*.resources
/src/AddIns/Analysis/Profiler/Controller/Data/UnmanagedCallTreeNode64.cs
/src/AddIns/Analysis/Profiler/Controller/Profiler64.cs
/src/AddIns/Analysis/Profiler/Controller/structs64.cs
/src/AddIns/Analysis/Profiler/Hook/Callback.x64.obj
/src/AddIns/Analysis/Profiler/Hook/x64
/src/AddIns/Analysis/Profiler/Hook/Win32
/src/Tools/UpdateAssemblyInfo/bin
/src/Setup/SharpDevelop.Setup.wixproj.user
/src/Main/ICSharpCode.SharpDevelop.Sda/ICSharpCode.SharpDevelop.Sda.dll.config
/src/Main/SharpDevelop/app.config
/src/Main/GlobalAssemblyInfo.cs
/src/Main/GlobalAssemblyInfo.vb
/src/AddIns/Misc/UsageDataCollector/UsageDataCollector.AddIn/AnalyticsMonitor.AppProperties.cs

/src/AddIns/Misc/PackageManagement/Packages/AvalonEdit/lib
/packages/
/src/Tools/ResGet/*.log


*.ide/
*.sdsettings
*.DotSettings.user
*.suo
.DS_Store
tests/fixtures/SampleTestProject/OpenCover/
__Instrumented/
tests/fixtures/LocalNuGetFeed/
# CodeCoverage addin run output (ProjectCodeCoverageResultsFileName.cs writes coverage.xml
# into the instrumented fixture's output directory during od.code-coverage.run).
tests/fixtures/CoverageFixture/CoverageTests/CodeCoverage/coverage.xml
*.app/
.od/
*.dmg
/artifacts/
/tmp/opencode/

# keep the macOS and Windows packaging assets tracked
/build/*
!/build/linux/
!/build/macos/
!/build/windows/
!/build/patch-librewinforms-deps.ps1
# shared PowerShell module imported by launch.ps1 / dist.macos.ps1
!/build/common.psm1
# regenerates build/macos/opendevelop.icns and build/windows/opendevelop.ico from images/opendevelop.png
!/build/make-branding-assets.sh
tests/fixtures/SampleTestProject/CodeCoverage/
/tests/OpenDevelop.IntegrationTests/TestResults/
/OpenDevelop-win*/
*.zip
*.7z
*.tar.xz
tests/fixtures/CoverageFixture/CoverageTests/CodeCoverage/
tmp/
