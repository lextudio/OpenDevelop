<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.SharpDevelop.Widgets</RootNamespace>
    <AssemblyName>ICSharpCode.SharpDevelop.Widgets</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Project\ICSharpCode.Core.csproj" />
    <ProjectReference Include="..\..\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" />
    <!-- Shared designer DTOs (DesignerElementNode) for the common Document Outline pad. -->
    <ProjectReference Include="..\..\Designer\Designer.Remote\Designer.Remote.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Uses ProGPU's portable System.Drawing.Common, not the real Microsoft one: the real
         assembly's GDI+ P/Invoke layer unconditionally throws PlatformNotSupportedException off
         Windows for essentially every Font/Bitmap/Graphics operation (confirmed - it dropped Unix
         libgdiplus support), so nothing built against it can actually run here. Keeping the whole
         app on one assembly identity (ProGPU's) also avoids the "real assembly loaded process-wide
         starves WinForms designer code of ProGPU-only APIs like Graphics.FromProGpuDrawingContext"
         conflict - only one physical System.Drawing.Common can be loaded per process. -->
    <PackageReference Include="ProGPU.System.Drawing.Common" Version="0.1.0-preview.47" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms-only: no cross-platform/WPF equivalent, out of MVP scope (see docs/opendevelop.md) -->
    <Compile Remove="CustomWindowsFormsHost.cs" />
    <Compile Remove="MouseWheelHandler.cs" />
    <Compile Remove="SideBar\**\*.cs" />
    <Compile Remove="DesignTimeSupport\**\*.cs" />
    <Compile Remove="ListViewSorting\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
  </ItemGroup>
</Project>
