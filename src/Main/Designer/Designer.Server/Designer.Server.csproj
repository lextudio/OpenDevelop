<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- See Designer.Remote: this code is the child-side protocol bootstrap, not IDE UI. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <AssemblyName>ICSharpCode.Designer.Server</AssemblyName>
    <RootNamespace>ICSharpCode.SharpDevelop.Designer.Remote</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
	<ProjectReference Include="..\Designer.Remote\Designer.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc pulls MessagePack transitively; reference it directly so NuGet unifies on the
         centrally pinned release instead of resolving the vulnerable 2.5.x (NU1902/NU1903). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
