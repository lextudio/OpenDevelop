<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Isolated markup hosts must run on the designed app's CLR major. Keep the shared,
         runtime-neutral protocol usable by the net9 and net10 Microsoft WinUI children. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <AssemblyName>ICSharpCode.Designer.Remote</AssemblyName>
    <RootNamespace>ICSharpCode.SharpDevelop.Designer.Remote</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc pulls MessagePack transitively; reference it directly so NuGet unifies on the
         centrally pinned release instead of resolving the vulnerable 2.5.x (NU1902/NU1903). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
