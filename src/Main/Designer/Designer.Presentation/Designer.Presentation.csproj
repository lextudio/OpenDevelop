<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ICSharpCode.Designer.Presentation</AssemblyName>
    <RootNamespace>ICSharpCode.SharpDevelop.Designer.Presentation</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- DesignerTypeIcons resolves VS Image Library glyphs through PresentationResourceService,
         and DesignerElementNode / DesignerToolboxItemInfo come from the designer protocol. -->
    <ProjectReference Include="..\..\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" />
    <ProjectReference Include="..\Designer.Remote\Designer.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc pulls MessagePack transitively; reference it directly so NuGet unifies on the
         centrally pinned release instead of resolving the vulnerable 2.5.x (NU1902/NU1903). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
