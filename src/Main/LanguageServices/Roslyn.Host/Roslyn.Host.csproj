<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ICSharpCode.Roslyn.Host</AssemblyName>
    <RootNamespace>ICSharpCode.SharpDevelop.LanguageServices.Host</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LanguageServices.Roslyn/LanguageServices.Roslyn.csproj" />
    <ProjectReference Include="../../Designer/Designer.Server/Designer.Server.csproj" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc pulls MessagePack transitively; reference it directly so NuGet unifies on the
         centrally pinned release instead of resolving the vulnerable 2.5.x (NU1902/NU1903). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
