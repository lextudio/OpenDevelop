<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ICSharpCode.LanguageServices.Roslyn</AssemblyName>
    <RootNamespace>ICSharpCode.SharpDevelop.LanguageServices</RootNamespace>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LanguageServices.Contracts/LanguageServices.Contracts.csproj" />
    <ProjectReference Include="../../../Libraries/ResourceFiles/ResourceFiles.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" />
  </ItemGroup>
  <ItemGroup>
    <!-- Version and platform attributes come from the shared file the other 60 projects link.
         Without it this assembly carried no product version and was not declared Windows-only,
         which is what made every call into the rest of the product report CA1416. -->
    <Compile Include="../../GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
  </ItemGroup>
</Project>
