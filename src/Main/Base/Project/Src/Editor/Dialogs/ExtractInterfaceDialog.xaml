<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="ICSharpCode.SharpDevelop.Editor.Dialogs.ExtractInterfaceDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sd="http://icsharpcode.net/sharpdevelop/core"
	Title="{sd:Localize SharpDevelop.Refactoring.ExtractInterfaceCommand}"
	WindowStyle="ToolWindow"
	Style="{x:Static sd:GlobalStyles.DialogWindowStyle}"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen"
	Width="420"
	SizeToContent="Height">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="150" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="{sd:Localize Dialog.Refactoring.ExtractInterface.InterfaceName}" Margin="0,0,0,2" />
		<TextBox Grid.Row="1" Name="interfaceNameTextBox" Margin="0,0,0,8"
		         Text="{Binding Path=InterfaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Grid.Row="2" Text="{sd:Localize Dialog.Refactoring.ExtractInterface.NewFileName}" Margin="0,0,0,2" />
		<TextBox Grid.Row="3" Name="newFileNameTextBox" Margin="0,0,0,8"
		         Text="{Binding Path=NewFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Grid.Row="4" Text="{sd:Localize Dialog.Refactoring.ExtractInterface.SelectPublicMembers}" Margin="0,0,0,2" />
		<ListBox Grid.Row="5" Name="membersListBox" Margin="0,0,0,8" SelectionMode="Multiple">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<CheckBox Grid.Row="6" Name="addInterfaceToClassCheckBox"
		          Content="{sd:Localize Dialog.Refactoring.ExtractInterface.AddInterfaceToClass}"
		          IsChecked="{Binding AddInterfaceToClass, Mode=TwoWay}" Margin="0,0,0,4" />

		<Grid Grid.Row="8" Margin="0,8,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button Content="{sd:Localize Global.OKButtonText}" Name="okButton" Click="OkButtonClick"
			        IsDefault="True" IsEnabled="{Binding IsValid}"
			        Height="23" Width="75" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Column="1" />
			<Button Content="{sd:Localize Global.CancelButtonText}" Name="cancelButton" IsCancel="True"
			        Height="23" Width="75" HorizontalAlignment="Right" Grid.Column="2" />
		</Grid>
	</Grid>
</Window>
