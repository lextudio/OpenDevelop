<AddIn name="OpenDevelop Project Browser"
       author="OpenDevelop"
       description="AddInTree-backed WPF Project Browser commands (CPS-based), ported from UnoDevelop">
  <!--
    R6b (see doc/technotes/solution-explorer.md): wires ProjectBrowserController/Service and its
    commands into the AddInTree. Deliberately uses its own /SharpDevelop/Pads/ProjectBrowser/...
    path namespace instead of the legacy /SharpDevelop/Pads/ProjectBrowser/... paths already owned
    by the WinForms ExtTreeView-based ProjectBrowserPad (out of MVP scope, see
    ProjectBrowserPadStub.cs) - reusing those paths would double-register menu items (old WinForms
    commands + these) under the same ids. R6c will add the actual WPF pad/tree view that consumes
    these menu paths and binds IProjectBrowserController/IProjectBrowserHost.
  -->
  <Manifest>
    <Identity name="ICSharpCode.SharpDevelop.ProjectBrowser" version="1.0"/>
  </Manifest>

  <!-- Every class referenced below (ProjectBrowserController, ProjectBrowserPad, the
       *ProjectBrowserCommand types) is compiled into the SharpDevelop.exe assembly itself
       (src/Main/SharpDevelop/...), so AddIn.FindType needs a Runtime/Import pointing at the host
       assembly to resolve them. Without this, FindType has zero runtimes to search and every
       Service/Pad/MenuItem class attribute below silently resolves to null (logged as
       "Cannot find class: ..." at AddInTree load time), so the service is never registered and
       every DevFlow action depending on it (e.g. od.open-solution) 404s. -->
  <Runtime>
    <Import assembly=":OpenDevelop"/>
    <!-- Project Options remains implemented by the base SharpDevelop assembly.  Context-menu
         command classes are resolved in this add-in's Runtime scope, not the main add-in's. -->
    <Import assembly=":ICSharpCode.SharpDevelop"/>
  </Runtime>

  <!-- Reuses the native "SolutionOpen" condition evaluator already registered by
       ICSharpCode.SharpDevelop.addin (ICSharpCode.SharpDevelop.SolutionOpenConditionEvaluator,
       in Base/Project/Src/Internal/ConditionEvaluators/CombineOpenEvaluator.cs) - registering a
       second evaluator under the same name here throws AddInLoadException("Duplicate condition
       evaluator: SolutionOpen") while loading the main addin, which aborts that addin's load
       partway through and silently drops every condition evaluator/doozer registered after it
       (including "WindowActive"), breaking most of the workbench's menu conditions. -->

  <Path name="/SharpDevelop/Services">
    <Service id="ICSharpCode.SharpDevelop.Services.IProjectBrowserController"
             class="ICSharpCode.SharpDevelop.Services.ProjectBrowserController" />
  </Path>

  <Path name="/SharpDevelop/Workbench/Pads">
    <!-- MEF-migrated pad (ProjectBrowserViewModel). The startup ShowPad loop skips it via
         IsMefToolPane, but the descriptor is still required for PadDescriptor routing:
         GetPad/BringPadToFront and DevFlow's od.show-pad resolve pads through
         PadContentCollection + LegacyPadClass. Left matches the Default layout template. -->
    <Pad id="ProjectBrowser"
         category="Main"
         title="${res:ProjectBrowser.PadTitle}"
         class="ICSharpCode.SharpDevelop.Services.ProjectBrowserPad"
         defaultPosition="Left" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Add">
    <MenuItem id="NewProject" label="${res:ProjectBrowser.ContextMenu.NewProject}" class="ICSharpCode.SharpDevelop.Commands.NewProjectProjectBrowserCommand" />
    <Condition name="Ownerstate" ownerstate="Solution">
      <MenuItem id="ExistingProject" label="${res:ProjectBrowser.ContextMenu.ExistingProject}" class="ICSharpCode.SharpDevelop.Commands.AddExistingProjectProjectBrowserCommand" />
      <MenuItem id="NewSolutionFolder" label="${res:ProjectBrowser.ContextMenu.NewSolutionFolder}" class="ICSharpCode.SharpDevelop.Commands.NewSolutionFolderProjectBrowserCommand" />
      <MenuItem id="AddSolutionItems" label="${res:ProjectBrowser.ContextMenu.ExistingItem}" class="ICSharpCode.SharpDevelop.Commands.AddSolutionItemsProjectBrowserCommand" />
    </Condition>
    <MenuItem id="NewItem" label="${res:ProjectBrowser.ContextMenu.NewItem}" class="ICSharpCode.SharpDevelop.Commands.NewItemProjectBrowserCommand" />
    <MenuItem id="NewFolder" label="${res:ProjectBrowser.ContextMenu.NewFolder}" class="ICSharpCode.SharpDevelop.Commands.NewFolderProjectBrowserCommand" />
    <MenuItem id="NewFile" label="${res:ProjectBrowser.ContextMenu.NewFile}" class="ICSharpCode.SharpDevelop.Commands.NewFileProjectBrowserCommand" />
    <MenuItem id="ExistingFile" label="${res:ProjectBrowser.ContextMenu.AddExistingFile}" class="ICSharpCode.SharpDevelop.Commands.AddExistingFileProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="AddExisting" />
    </MenuItem>
    <MenuItem id="ExistingFolder" label="${res:ProjectBrowser.ContextMenu.AddExistingFolder}" class="ICSharpCode.SharpDevelop.Commands.AddExistingFolderProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="AddExisting" />
    </MenuItem>
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Open">
    <MenuItem id="Open" label="${res:Gui.ProjectBrowser.Open}" class="ICSharpCode.SharpDevelop.Commands.OpenProjectBrowserItemCommand">
      <Condition name="Ownerstate" ownerstate="Openable" />
    </MenuItem>
    <MenuItem id="OpenWith" label="${res:Gui.ProjectBrowser.OpenWith}" class="ICSharpCode.SharpDevelop.Commands.OpenWithProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="OpenWith" />
    </MenuItem>
    <!-- A project node already gets "Open Folder in Explorer" from ContextMenu/ProjectActions. -->
    <ComplexCondition>
      <Not>
        <Condition name="Ownerstate" ownerstate="Project" />
      </Not>
      <MenuItem id="OpenFolder" label="${res:ProjectBrowser.ContextMenu.OpenFolder}" class="ICSharpCode.SharpDevelop.Commands.OpenFolderProjectBrowserCommand" />
    </ComplexCondition>
    <MenuItem id="OpenTerminal" label="${res:ProjectBrowser.ContextMenu.OpenInTerminal}" class="ICSharpCode.SharpDevelop.Commands.OpenTerminalProjectBrowserCommand" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Edit">
    <MenuItem id="Cut" label="${res:ProjectBrowser.ContextMenu.Cut}" class="ICSharpCode.SharpDevelop.Commands.CutProjectBrowserItemCommand" />
    <MenuItem id="Copy" label="${res:ProjectBrowser.ContextMenu.Copy}" class="ICSharpCode.SharpDevelop.Commands.CopyProjectBrowserItemCommand" />
    <MenuItem id="Paste" label="${res:ProjectBrowser.ContextMenu.Paste}" class="ICSharpCode.SharpDevelop.Commands.PasteProjectBrowserItemCommand" />
    <MenuItem id="EditSeparator" type="Separator" />
    <MenuItem id="Rename" label="${res:ProjectBrowser.ContextMenu.Rename}" class="ICSharpCode.SharpDevelop.Commands.RenameProjectBrowserItemCommand">
      <Condition name="Ownerstate" ownerstate="Renameable" />
    </MenuItem>
    <MenuItem id="Delete" label="${res:ProjectBrowser.ContextMenu.Delete}" class="ICSharpCode.SharpDevelop.Commands.DeleteProjectBrowserItemCommand">
      <Condition name="Ownerstate" ownerstate="Deletable" />
    </MenuItem>
    <MenuItem id="RemoveFromProject" label="${res:ProjectBrowser.ContextMenu.RemoveFromProject}" class="ICSharpCode.SharpDevelop.Commands.RemoveFromProjectProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="RemovableFromSolution" />
    </MenuItem>
    <MenuItem id="CopyPath" label="${res:ProjectBrowser.ContextMenu.CopyPath}" class="ICSharpCode.SharpDevelop.Commands.CopyPathProjectBrowserCommand" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Membership">
    <MenuItem id="IncludeInProject" label="${res:ProjectBrowser.ContextMenu.IncludeInProject}" class="ICSharpCode.SharpDevelop.Commands.IncludeInProjectProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="IncludeInProject" />
    </MenuItem>
    <MenuItem id="ExcludeFromProject" label="${res:ProjectBrowser.ContextMenu.ExcludeFromProject}" class="ICSharpCode.SharpDevelop.Commands.ExcludeFromProjectProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="ExcludeFromProject" />
    </MenuItem>
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/SolutionNode">
    <MenuItem id="Refresh" label="${res:ProjectBrowser.ContextMenu.Refresh}" class="ICSharpCode.SharpDevelop.Commands.RefreshProjectBrowserCommand" />
    <MenuItem id="Add" label="${res:ProjectBrowser.ContextMenu.Add}" type="Menu">
      <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Add" />
    </MenuItem>
    <MenuItem id="Separator1" type="Separator" />
    <MenuItem id="CopyPath" label="${res:ProjectBrowser.ContextMenu.CopyPath}" class="ICSharpCode.SharpDevelop.Commands.CopyPathProjectBrowserCommand" />
    <MenuItem id="OpenFolder" label="${res:ProjectBrowser.ContextMenu.OpenFolder}" class="ICSharpCode.SharpDevelop.Commands.OpenFolderProjectBrowserCommand" />
    <MenuItem id="OpenTerminal" label="${res:ProjectBrowser.ContextMenu.OpenInTerminal}" class="ICSharpCode.SharpDevelop.Commands.OpenTerminalProjectBrowserCommand" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/SolutionFolderNode">
    <MenuItem id="Add" label="${res:ProjectBrowser.ContextMenu.Add}" type="Menu">
      <MenuItem id="NewProject" label="${res:ProjectBrowser.ContextMenu.NewProject}" class="ICSharpCode.SharpDevelop.Commands.NewProjectProjectBrowserCommand" />
      <MenuItem id="ExistingProject" label="${res:ProjectBrowser.ContextMenu.ExistingProject}" class="ICSharpCode.SharpDevelop.Commands.AddExistingProjectProjectBrowserCommand" />
      <MenuItem id="NewSolutionFolder" label="${res:ProjectBrowser.ContextMenu.NewSolutionFolder}" class="ICSharpCode.SharpDevelop.Commands.NewSolutionFolderProjectBrowserCommand" />
      <MenuItem id="AddSolutionItems" label="${res:ProjectBrowser.ContextMenu.ExistingItem}" class="ICSharpCode.SharpDevelop.Commands.AddSolutionItemsProjectBrowserCommand" />
    </MenuItem>
    <MenuItem id="Separator1" type="Separator" />
    <MenuItem id="Rename" label="${res:ProjectBrowser.ContextMenu.Rename}" class="ICSharpCode.SharpDevelop.Commands.RenameProjectBrowserItemCommand" />
    <MenuItem id="RemoveFromSolution" label="${res:ProjectBrowser.ContextMenu.Remove}" class="ICSharpCode.SharpDevelop.Commands.RemoveFromProjectProjectBrowserCommand" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/SolutionItemNode">
    <MenuItem id="Open" label="${res:Gui.ProjectBrowser.Open}" class="ICSharpCode.SharpDevelop.Commands.OpenProjectBrowserItemCommand" />
    <MenuItem id="OpenWith" label="${res:Gui.ProjectBrowser.OpenWith}" class="ICSharpCode.SharpDevelop.Commands.OpenWithProjectBrowserCommand" />
    <MenuItem id="OpenFolder" label="${res:ProjectBrowser.ContextMenu.OpenFolder}" class="ICSharpCode.SharpDevelop.Commands.OpenFolderProjectBrowserCommand" />
    <MenuItem id="OpenTerminal" label="${res:ProjectBrowser.ContextMenu.OpenInTerminal}" class="ICSharpCode.SharpDevelop.Commands.OpenTerminalProjectBrowserCommand" />
    <MenuItem id="Separator1" type="Separator" />
    <MenuItem id="CopyPath" label="${res:ProjectBrowser.ContextMenu.CopyPath}" class="ICSharpCode.SharpDevelop.Commands.CopyPathProjectBrowserCommand" />
    <MenuItem id="RemoveFromSolution" label="${res:ProjectBrowser.ContextMenu.Remove}" class="ICSharpCode.SharpDevelop.Commands.RemoveFromProjectProjectBrowserCommand" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/ProjectNode">
    <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Open" />
    <MenuItem id="Separator1" type="Separator" />
    <MenuItem id="Refresh" label="${res:ProjectBrowser.ContextMenu.Refresh}" class="ICSharpCode.SharpDevelop.Commands.RefreshProjectBrowserCommand" />
    <MenuItem id="Add" label="${res:ProjectBrowser.ContextMenu.Add}" type="Menu">
      <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Add" />
    </MenuItem>
    <MenuItem id="AddReferenceDialog" label="${res:ProjectBrowser.ContextMenu.AddReference}" class="ICSharpCode.SharpDevelop.Commands.AddReferenceProjectBrowserCommand" />
    <!-- Selecting a project node makes it the current project, which is what ViewProjectOptions opens. -->
    <MenuItem id="ProjectOptions" label="${res:ProjectBrowser.ContextMenu.ProjectOptions}" class="ICSharpCode.SharpDevelop.Project.Commands.ViewProjectOptions" />
    <!-- Set Startup Project comes from ContextMenu/ProjectActions in ICSharpCode.SharpDevelop.addin, which the
         main Project menu shares, so it is not repeated here. -->
    <MenuItem id="Separator2" type="Separator" />
    <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Edit" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/FolderNode">
    <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Open" />
    <MenuItem id="Separator1" type="Separator" />
    <MenuItem id="Add" label="${res:ProjectBrowser.ContextMenu.Add}" type="Menu">
      <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Add" />
    </MenuItem>
    <MenuItem id="Separator2" type="Separator" />
    <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Edit" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/FileNode">
    <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Open" />
    <MenuItem id="ViewInBrowser" label="${res:ProjectBrowser.ContextMenu.ViewInBrowser}" icon="Icons.22x22.Browser" class="ICSharpCode.SharpDevelop.Commands.ViewInBrowserProjectBrowserCommand" />
    <MenuItem id="Separator1" type="Separator" />
    <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Membership" />
    <MenuItem id="RunCustomTool" label="${res:ProjectBrowser.ContextMenu.RunCustomTool}" class="ICSharpCode.SharpDevelop.Commands.RunCustomToolProjectBrowserCommand" />
    <MenuItem id="Separator2" type="Separator" />
    <Include path="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/Common/Edit" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/ReferenceNode">
    <MenuItem id="OpenProjectReference" label="${res:Gui.ProjectBrowser.Open}" class="ICSharpCode.SharpDevelop.Commands.OpenProjectReferenceProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="OpenReference" />
    </MenuItem>
    <MenuItem id="Separator0" type="Separator" />
    <MenuItem id="RemoveReference" label="${res:ProjectBrowser.ContextMenu.Remove}" class="ICSharpCode.SharpDevelop.Commands.RemoveReferenceProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="RemovableReference" />
    </MenuItem>
    <MenuItem id="CopyPath" label="${res:ProjectBrowser.ContextMenu.CopyPath}" class="ICSharpCode.SharpDevelop.Commands.CopyPathProjectBrowserCommand" />
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/PackageReferenceNode">
    <MenuItem id="RemoveReference" label="${res:ProjectBrowser.ContextMenu.Remove}" class="ICSharpCode.SharpDevelop.Commands.RemoveReferenceProjectBrowserCommand">
      <Condition name="Ownerstate" ownerstate="RemovableReference" />
    </MenuItem>
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/UnknownNode">
  </Path>

  <Path name="/SharpDevelop/Pads/ProjectBrowser/ToolBar/Standard">
    <Condition name="SolutionOpen" action="Disable">
      <ToolbarItem id="Refresh" tooltip="${res:ProjectBrowser.ContextMenu.Refresh}" class="ICSharpCode.SharpDevelop.Commands.RefreshProjectBrowserCommand" />
    </Condition>
  </Path>
</AddIn>
