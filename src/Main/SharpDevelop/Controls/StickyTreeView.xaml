<UserControl x:Class="ICSharpCode.SharpDevelop.Controls.StickyTreeView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Virtualized: only rows in view get containers, recycled while scrolling (a solution with
             hundreds of expanded projects otherwise realizes and lays out thousands of rows on the UI
             thread). Pixel scrolling keeps offsets in DIP for the sticky-header geometry. Expansion state
             therefore lives in the items (bind IsExpanded two-way), never only in a container. -->
        <TreeView x:Name="tree"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <!-- This layer is deliberately a sibling of the TreeView.  StickyTreeView measures the
             ScrollViewer viewport and positions this border against that viewport, rather than
             assuming the TreeView's outer bounds are the viewport's bounds. -->
        <Border x:Name="stickyHeaderPanel"
                VerticalAlignment="Top"
                Background="{DynamicResource ToolWindowBackground}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <ItemsControl x:Name="stickyHeaders"
                          PreviewMouseWheel="StickyHeadersOnPreviewMouseWheel" />
        </Border>
    </Grid>
</UserControl>
