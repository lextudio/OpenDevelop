<gui:OptionPanel x:Class="ICSharpCode.SharpDevelop.OptionPanels.UpdatesOptions"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
                 xmlns:gui="clr-namespace:ICSharpCode.SharpDevelop.Gui;assembly=ICSharpCode.SharpDevelop">
    <StackPanel Margin="8">
        <TextBlock Text="{core:Localize UpdatesOptions.Updates}" FontWeight="SemiBold" />
        <CheckBox x:Name="automaticCheckBox"
                  Margin="0,10,0,0"
                  Content="{core:Localize UpdatesOptions.AutoCheckWeekly}" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="checkNowButton"
                    Content="{core:Localize UpdatesOptions.CheckNow}"
                    Padding="10,3"
                    Click="CheckNowButton_Click" />
            <TextBlock x:Name="checkResultText"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</gui:OptionPanel>
