<gui:OptionPanel x:Class="ICSharpCode.SharpDevelop.OptionPanels.IdeThemeOptions"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
                 xmlns:gui="clr-namespace:ICSharpCode.SharpDevelop.Gui;assembly=ICSharpCode.SharpDevelop">
    <StackPanel Margin="8">
        <TextBlock Text="{core:Localize Dialog.Options.IDEOptions.IdeTheme.Title}" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,10"
                   Text="{core:Localize Dialog.Options.IDEOptions.IdeTheme.Description}"
                   TextWrapping="Wrap" />
        <ComboBox x:Name="themeComboBox" Width="240" HorizontalAlignment="Left">
            <ComboBoxItem Content="{core:Localize Dialog.Options.IDEOptions.IdeTheme.Light}" Tag="Light" />
            <ComboBoxItem Content="{core:Localize Dialog.Options.IDEOptions.IdeTheme.Dark}" Tag="Dark" />
            <ComboBoxItem Content="{core:Localize Dialog.Options.IDEOptions.IdeTheme.Blue}" Tag="Blue" />
        </ComboBox>
        <TextBlock Margin="0,10,0,0"
                   Foreground="Gray"
                   Text="{core:Localize Dialog.Options.IDEOptions.IdeTheme.Note}"
                   TextWrapping="Wrap" />
    </StackPanel>
</gui:OptionPanel>
