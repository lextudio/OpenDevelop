<gui:OptionPanel x:Class="ICSharpCode.SharpDevelop.OptionPanels.KeyboardShortcutsOptions"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
                 xmlns:gui="clr-namespace:ICSharpCode.SharpDevelop.Gui;assembly=ICSharpCode.SharpDevelop">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="100" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{core:Localize Dialog.Options.IDEOptions.Keyboard.Description}" TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="searchBox" Grid.Column="0" Margin="0,0,6,0"
                     AutomationProperties.Name="{core:Localize Dialog.Options.IDEOptions.Keyboard.Search}"
                     TextChanged="SearchChanged" PreviewKeyDown="SearchKeyDown" />
            <CheckBox x:Name="gestureSearchBox" Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"
                      Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.SearchByShortcut}"
                      ToolTip="{core:Localize Dialog.Options.IDEOptions.Keyboard.SearchByShortcut.Tooltip}"
                      Checked="GestureSearchChanged" Unchecked="GestureSearchChanged" />
            <ComboBox x:Name="filterBox" Grid.Column="2" Width="130" SelectedIndex="0"
                      AutomationProperties.Name="{core:Localize Dialog.Options.IDEOptions.Keyboard.Filter.All}"
                      SelectionChanged="FilterChanged">
                <ComboBoxItem Tag="All" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Filter.All}" />
                <ComboBoxItem Tag="Customized" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Filter.Customized}" />
                <ComboBoxItem Tag="Unassigned" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Filter.Unassigned}" />
                <ComboBoxItem Tag="Conflicts" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Filter.Conflicts}" />
            </ComboBox>
        </Grid>

        <ListView x:Name="commandList" Grid.Row="2" SelectionMode="Single" SelectionChanged="SelectionChanged"
                  AutomationProperties.Name="{core:Localize Dialog.Options.IDEOptions.Keyboard.Column.Command}"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,4,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="20" DisplayMemberBinding="{Binding Mark}" />
                    <GridViewColumn Header="{core:Localize Dialog.Options.IDEOptions.Keyboard.Column.Command}" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="{core:Localize Dialog.Options.IDEOptions.Keyboard.Column.Shortcut}" Width="110" DisplayMemberBinding="{Binding Shortcut}" />
                    <GridViewColumn Header="{core:Localize Dialog.Options.IDEOptions.Keyboard.Column.Default}" Width="95" DisplayMemberBinding="{Binding Default}" />
                    <GridViewColumn Header="{core:Localize Dialog.Options.IDEOptions.Keyboard.Column.Scope}" Width="100" DisplayMemberBinding="{Binding ScopeName}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="selectedText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="locationsText" Foreground="Gray" TextWrapping="Wrap" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="captureBox" Grid.Column="0" IsReadOnly="True" IsEnabled="False"
                         AutomationProperties.Name="{core:Localize Dialog.Options.IDEOptions.Keyboard.Capture.Prompt}"
                         PreviewKeyDown="CaptureKeyDown" TextChanged="CaptureTextChanged" GotKeyboardFocus="CaptureFocused" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button x:Name="assignButton" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Assign}" IsEnabled="False" Click="AssignClick" Margin="0,0,4,0" Padding="8,2" />
                    <Button x:Name="removeButton" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Remove}" IsEnabled="False" Click="RemoveClick" Margin="0,0,4,0" Padding="8,2" />
                    <Button x:Name="resetButton" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Reset}" IsEnabled="False" Click="ResetClick" Padding="8,2" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="messageText" Margin="0,4,0,0" Foreground="DarkOrange" TextWrapping="Wrap" Visibility="Collapsed" />
            <Button x:Name="reassignButton" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.Reassign}" Visibility="Collapsed"
                    HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2" Click="ReassignClick" />
            <Button x:Name="resetAllButton" Content="{core:Localize Dialog.Options.IDEOptions.Keyboard.ResetAll}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,2" Click="ResetAllClick" />
        </StackPanel>
    </Grid>
</gui:OptionPanel>
