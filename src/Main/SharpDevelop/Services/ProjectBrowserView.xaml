<UserControl x:Class="ICSharpCode.SharpDevelop.Services.ProjectBrowserView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ICSharpCode.SharpDevelop.Services"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <!-- One row's visuals, shared by the tree itself and the sticky header overlay below, so
             a pinned row is pixel-identical to the real one it stands in for. -->
        <DataTemplate x:Key="ProjectBrowserNodeRow">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16"
                      Height="16"
                      Margin="0,0,4,0">
                    <Image Width="16"
                           Height="16"
                           Source="{Binding Icon}" />
                    <Image Width="16"
                           Height="16"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Source="{Binding LinkedFileOverlayIcon}" />
                    <Image Width="8"
                           Height="8"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Source="{Binding SourceControlOverlayIcon}"
                           automation:AutomationProperties.AutomationId="{Binding OverlayStatusKey}" />
                </Grid>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type services:ProjectBrowserNodeModel}"
                                  ItemsSource="{Binding Children}">
            <ContentPresenter Content="{Binding}"
                              ContentTemplate="{StaticResource ProjectBrowserNodeRow}" />
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0"
                 ToolBarTray.IsLocked="True"
                 KeyboardNavigation.TabNavigation="None">
            <Button Command="{Binding ShowPropertiesCommand}"
                    ToolTip="Properties"
                    Padding="3">
                <Image Width="16"
                       Height="16"
                       Source="{Binding PropertiesIcon}" />
            </Button>
            <Separator />
            <ToggleButton IsChecked="{Binding ShowAllFiles, Mode=TwoWay}"
                          ToolTip="Show All Files"
                          Padding="3">
                <Image Width="16"
                       Height="16"
                       Source="{Binding ShowAllFilesIcon}" />
            </ToggleButton>
            <Button Command="{Binding RefreshCommand}"
                    ToolTip="Refresh"
                    Padding="3">
                <Image Width="16"
                       Height="16"
                       Source="{Binding RefreshIcon}" />
            </Button>
            <Button Command="{Binding CollapseAllCommand}"
                    ToolTip="Collapse All"
                    Padding="3">
                <Image Width="16"
                       Height="16"
                       Source="{Binding CollapseAllIcon}" />
            </Button>
        </ToolBar>
        <TreeView x:Name="treeView"
                  Grid.Row="1"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ItemsSource="{Binding RootNodes}"
                  MouseDoubleClick="TreeViewOnMouseDoubleClick"
                  PreviewMouseRightButtonDown="TreeViewOnPreviewMouseRightButtonDown"
                  SelectedItemChanged="TreeViewOnSelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        <!-- Sticky headers: the solution/project rows the current scroll position sits under stay
             pinned here so the tree never scrolls to a point where you cannot tell which project
             the visible files belong to. Opaque, so real rows scroll underneath it. Only rows
             whose own header has already scrolled off the top are pinned (see the view's
             UpdateStickyHeaders), which is what keeps a row from being drawn twice. -->
        <Border x:Name="stickyHeaderPanel"
                Grid.Row="1"
                VerticalAlignment="Top"
                Background="{DynamicResource ToolWindowBackground}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <!-- Rows are plain UIElements built and Margin-assigned directly in code-behind
                 (UpdateStickyHeaders), not through an ItemTemplate: binding Margin to a per-row
                 Thickness property here left every row unindented (Margin stayed 0 regardless of
                 the bound value), so the reliable fix is to skip data-binding for this property
                 and set it as a plain CLR assignment on each row's own element instead. -->
            <ItemsControl x:Name="stickyHeaders"
                          PreviewMouseWheel="StickyHeadersOnPreviewMouseWheel" />
        </Border>
        <TextBlock Grid.Row="1"
                   Margin="12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Foreground="{DynamicResource MutedForeground}"
                   IsHitTestVisible="False"
                   Text="Loading projects…">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
