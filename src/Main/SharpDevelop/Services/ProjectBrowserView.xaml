<UserControl x:Class="ICSharpCode.SharpDevelop.Services.ProjectBrowserView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
             xmlns:services="clr-namespace:ICSharpCode.SharpDevelop.Services"
             xmlns:controls="clr-namespace:ICSharpCode.SharpDevelop.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <!-- The same visual is used for real and pinned rows.  Vertical spacing belongs to this
             template, so both representations have the identical measured pitch. -->
        <DataTemplate x:Key="ProjectBrowserNodeRow">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Grid Width="16" Height="16" Margin="0,0,4,0">
                    <Image Width="16" Height="16" Source="{Binding Icon}" />
                    <Image Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Source="{Binding LinkedFileOverlayIcon}" />
                    <Image Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Source="{Binding SourceControlOverlayIcon}"
                           automation:AutomationProperties.AutomationId="{Binding OverlayStatusKey}" />
                </Grid>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type services:ProjectBrowserNodeModel}"
                                  ItemsSource="{Binding Children}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProjectBrowserNodeRow}" />
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True" KeyboardNavigation.TabNavigation="None">
            <Button Command="{Binding ShowPropertiesCommand}" ToolTip="{core:Localize ProjectBrowser.Toolbar.Properties}" Padding="3"><Image Width="16" Height="16" Source="{Binding PropertiesIcon}" /></Button>
            <Separator />
            <ToggleButton IsChecked="{Binding ShowAllFiles, Mode=TwoWay}" ToolTip="{core:Localize ProjectBrowser.Toolbar.ShowAllFiles}" Padding="3"><Image Width="16" Height="16" Source="{Binding ShowAllFilesIcon}" /></ToggleButton>
            <Button Command="{Binding RefreshCommand}" ToolTip="{core:Localize ProjectBrowser.Toolbar.Refresh}" Padding="3"><Image Width="16" Height="16" Source="{Binding RefreshIcon}" /></Button>
            <Button Command="{Binding CollapseAllCommand}" ToolTip="{core:Localize ProjectBrowser.Toolbar.CollapseAll}" Padding="3"><Image Width="16" Height="16" Source="{Binding CollapseAllIcon}" /></Button>
        </ToolBar>
        <controls:StickyTreeView x:Name="treeView" Grid.Row="1"
                                 ItemsSource="{Binding RootNodes}"
                                 StickyHeaderTemplate="{StaticResource ProjectBrowserNodeRow}">
            <controls:StickyTreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" /></Style>
            </controls:StickyTreeView.ItemContainerStyle>
        </controls:StickyTreeView>
        <TextBlock Grid.Row="1" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Foreground="{DynamicResource MutedForeground}" IsHitTestVisible="False" Text="{core:Localize ProjectBrowser.Loading}">
            <TextBlock.Style>
                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
