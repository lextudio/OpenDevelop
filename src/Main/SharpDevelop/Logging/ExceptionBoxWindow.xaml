<Window x:Class="ICSharpCode.SharpDevelop.Logging.ExceptionBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unhandled exception"
        Width="760" Height="480"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock x:Name="messageText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="Bold" />

		<TextBox x:Name="detailsTextBox" Grid.Row="1"
		         IsReadOnly="True" IsReadOnlyCaretVisible="True"
		         TextWrapping="NoWrap"
		         FontFamily="Consolas, Courier New"
		         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
		         AcceptsReturn="True" AcceptsTab="True" />

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="copyButton" Content="Copy to Clipboard" Padding="12,4" Margin="0,0,8,0" Click="CopyButton_Click" />
			<Button x:Name="continueButton" Content="Continue" Padding="12,4" Margin="0,0,8,0" Click="ContinueButton_Click" IsDefault="True" Visibility="Collapsed" />
			<Button x:Name="exitButton" Content="Exit" Padding="12,4" Click="ExitButton_Click" IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>
