<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.SharpDevelop</RootNamespace>
    <AssemblyName>OpenDevelop</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <!-- LibreWPF's generated portable bootstrap is needed on non-Windows hosts only.  On
         Windows its direct portable PresentationFramework reference is resolved before the
         platform guard can return, so omit it and use the normal Windows startup path.
         This MUST stay on for a macOS/Linux build: the bootstrap is what calls
         WpfPortableWindowActivation.TryRegisterPresentationFrameworkActivation(), and without
         those callbacks registered Window.Show() never creates a ProGpuWpfWindowHost - the app
         then runs with a Dock icon and no window at all, because nothing ever creates the real
         native window behind the (otherwise perfectly happy) WPF Window. -->
    <ProGpuWpfEnablePortableBootstrap Condition="!$([MSBuild]::IsOSPlatform('Windows'))">true</ProGpuWpfEnablePortableBootstrap>
    <ProGpuWpfEnablePortableBootstrap Condition="'$(ProGpuWpfEnablePortableBootstrap)' == ''">false</ProGpuWpfEnablePortableBootstrap>
    <!-- Gates the LibreWPF-only API use in WorkbenchStartup (Dispatcher.NativeInputPump,
         WpfPortableWindowActivation) - neither exists in Microsoft's WPF, so it can only compile
         against the LibreWPF portable references this SDK supplies. Undefined until now, which
         silently compiled out the NativeInputPump wiring there and let Application.Run() return
         the moment the dispatcher queue drained, exiting the app seconds after startup. -->
    <DefineConstants Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);LIBREWPF_CUSTOM_EXTENSIONS</DefineConstants>
    <!-- WinForms\**\*.cs (WinFormsService/SDWindowsFormsHost/WinFormsMenuService/WinFormsToolbarService)
         needs the real LibreWinForms implementation, same as ICSharpCode.SharpDevelop.csproj -
         see that project's UseWindowsForms comment for why the WinForms bridge is back. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\..\build\windows\opendevelop.ico</ApplicationIcon>
    <!-- One platform-neutral Windows distribution: the app is started with the user's own `dotnet`
         ("dotnet OpenDevelop.dll"), so no per-architecture native apphost is shipped. The apphost is
         the ONLY file dotnet publish emits for a specific architecture; everything else is AnyCPU IL
         plus the runtimes/<rid>/ native tree, which one payload can carry for every CPU.
         macOS still keeps its apphost: it is the .app bundle's Contents/MacOS launcher today, and
         replacing it with an architecture-neutral launcher script is tracked separately. -->
    <UseAppHost Condition="!$([MSBuild]::IsOSPlatform('OSX'))">false</UseAppHost>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);436;1591;CA1416;WFO1000</NoWarn>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the resolver consumed by external addin projects; the macOS bundle copies its
         output beside the other MSBuild SDK resolvers. It is not an app runtime reference. -->
    <ProjectReference Include="..\..\SDK\OpenDevelop.Addin.SdkResolver\OpenDevelop.Addin.SdkResolver.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="Dom\TreeNodeFactoryService.cs" />
    <PackageReference Include="Microsoft.Build" />
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Runtime" />
    <!-- See the matching comment on the NuGet.Commands PackageVersion in
         Directory.Packages.props: this is not called directly, it just needs to land in
         our own output so the in-process MSBuild engine's NuGet SDK resolver can load it. -->
    <PackageReference Include="NuGet.Commands" />
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="log4net" />
    <!-- Without this, Microsoft.CodeAnalysis.CSharp.Features (Roslyn) only floors this app's own
         resolution of System.Composition.AttributedModel at 9.0.0, while the
         ICSharpCode.ILSpyX (used by ILSpyAddIn, hosted in-process) pins it exactly to 10.0.10. Two
         different versions of the same simple-named assembly loaded into one process throws
         FileLoadException ("manifest definition does not match the assembly reference") the
         moment ILSpyAddIn.dll loads - align this app's own resolution to the same version so only
         one copy is ever in play. -->
    <PackageReference Include="System.Composition.AttributedModel" />
    <!-- The agent is present in release bundles too. Startup keeps it disabled there unless an
         integration-test launch explicitly sets OD_TEST_MODE=1. -->
    <PackageReference Include="LeXtudio.DevFlow.Agent.LibreWpf" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="NuGet.Core">
      <HintPath>..\..\AddIns\Misc\PackageManagement\RequiredLibraries\NuGet.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Embedded so WpfWorkbench.xaml can set Window.Icon explicitly. Without an explicit Icon, a
         WPF window falls back to its HOSTING PROCESS's own exe icon - which used to be this same
         opendevelop.ico automatically (the app hosted itself, via UseAppHost). Now that the app is
         launched as "dotnet exec OpenDevelop.dll" (by OpenDevelop.Launcher's apphost, or by hand),
         the hosting process is dotnet.exe, and the taskbar/Alt-Tab icon would otherwise be
         dotnet.exe's generic one. Embedding the icon here and setting it explicitly makes the
         running window's icon correct regardless of which process hosts it. -->
    <Resource Include="..\..\..\build\windows\opendevelop.ico" Link="Resources\opendevelop.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\AvalonDock\source\Components\AvalonDock.Core\AvalonDock.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\AvalonDock\source\Components\AvalonDock\AvalonDock.csproj" />
    <ProjectReference Include="..\..\Libraries\AvalonDock\source\Components\AvalonDock.Serializer.Xml\AvalonDock.Serializer.Xml.csproj" />
    <ProjectReference Include="..\..\Libraries\AvalonDock\source\Components\AvalonDock.Themes.VS2013\AvalonDock.Themes.VS2013.csproj" />
    <ProjectReference Include="..\..\Libraries\AvalonEdit\ICSharpCode.AvalonEdit\ICSharpCode.AvalonEdit.csproj" />
    <ProjectReference Include="..\..\Libraries\VSEditorCompat\OpenDevelop.VSEditorCompat.csproj" />
    <ProjectReference Include="..\..\Libraries\ICSharpCode.TypeSystem.Abstractions\ICSharpCode.TypeSystem.Abstractions.csproj" />
    <ProjectReference Include="..\Base\Project\ICSharpCode.SharpDevelop.csproj" />
    <ProjectReference Include="..\Core\Project\ICSharpCode.Core.csproj" />
    <ProjectReference Include="..\ICSharpCode.Core.WinForms\ICSharpCode.Core.WinForms.csproj" />
    <ProjectReference Include="..\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" />
    <ProjectReference Include="..\ICSharpCode.SharpDevelop.Widgets\Project\ICSharpCode.SharpDevelop.Widgets.csproj" />
	<ProjectReference Include="..\Designer\Designer.Shell\Designer.Shell.csproj" />
    <ProjectReference Include="..\..\AddIns\Misc\StartPage\Project\StartPage.csproj" Private="false" />
    <ProjectReference Include="..\..\..\externals\cps\src\ProjectSystem\Microsoft.VisualStudio.ProjectSystem.Shim.csproj" />
    <ProjectReference Include="..\..\..\externals\cps\src\ProjectSystemManaged\Microsoft.VisualStudio.ProjectSystem.Managed.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Templates\Bundled\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
    <EmbeddedResource Include="..\..\..\data\resources\StringResources.resx">
      <Link>Resources\StringResources.resx</Link>
    </EmbeddedResource>
    <!-- BitmapResources.resources was removed in favour of the pngResourceMap
         in ICSharpCode.Core.Presentation/PresentationResourceService.cs, which
         resolves icons via pack: URIs from Resources/VS2017/*.png -->
  </ItemGroup>
  <!-- SharpDevelopMain.FindApplicationRootPath walks UP from the exe's own output
       directory looking for data\resources\languages\LanguageDefinition.xml, and
       sets ApplicationRootPath to whatever directory it finds it in - NOT the exe's
       output directory itself. In this repo layout that resolves to the OpenDevelop
       repo root (this csproj's directory, three levels up), because that's where
       data\resources\languages\LanguageDefinition.xml actually lives (the original
       old-style build shared one top-level bin\ output folder directly under the
       repo root, so this "coincidence" is really by design upstream). AddInTree then
       loads *.addin from $(ApplicationRootPath)\AddIns - i.e. the REPO ROOT's AddIns
       folder, not this project's own bin output. Without this, AddInTree loads with
       zero menu/toolbar/pad definitions (Menu renders at height=0, no docked pads)
       even though the exe "boots" with no exception. Copy after build, since a
       plain Content/CopyToOutputDirectory item only reaches this project's own
       $(OutDir). ICSharpCode.SharpDevelop.addin (main menu, main toolbar, base pad
       registrations) is the minimum needed for a non-empty workbench; add more MVP
       AddIns (AvalonEdit.AddIn, etc.) here once their projects are ported. -->
  <Target Name="DeployAddInsToRepoRoot" AfterTargets="Build">
    <ItemGroup>
      <SharpDevelopAddIn Include="..\Base\Project\ICSharpCode.SharpDevelop.addin" />
      <SharpDevelopAddIn Include="ICSharpCode.SharpDevelop.ProjectBrowser.addin" />
    </ItemGroup>
    <Copy SourceFiles="@(SharpDevelopAddIn)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\..\AddIns" SkipUnchangedFiles="true" />
  </Target>
  <!-- LibreWPF.Transport has generic managed assets as well as RID-specific versions of
       PresentationCore and DirectWriteForwarder.  The SDK restores the generic transport
       payload late in the build, which is correct for the rest of WPF but overwrites these
       architecture-specific binaries.  Restore therefore records the selected RID in
       RuntimeIdentifier; copy just those two assets last so an ordinary app build is runnable
       on ARM64, x64, and x86 without a launcher-side DLL list. -->
  <Target Name="RestoreLibreWpfArchitectureRuntimeAssets" AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' != '' And '$(NuGetPackageRoot)' != '' And '$(ProGpuWpfManagedPackageVersion)' != ''">
    <ItemGroup>
      <_LibreWpfArchitectureRuntimeAsset Include="$(NuGetPackageRoot)librewpf.transport\$(ProGpuWpfManagedPackageVersion)\runtimes\$(RuntimeIdentifier)\lib\net10.0\PresentationCore.dll"
                                            Condition="Exists('$(NuGetPackageRoot)librewpf.transport\$(ProGpuWpfManagedPackageVersion)\runtimes\$(RuntimeIdentifier)\lib\net10.0\PresentationCore.dll')" />
      <_LibreWpfArchitectureRuntimeAsset Include="$(NuGetPackageRoot)librewpf.transport\$(ProGpuWpfManagedPackageVersion)\runtimes\$(RuntimeIdentifier)\lib\net10.0\DirectWriteForwarder.dll"
                                            Condition="Exists('$(NuGetPackageRoot)librewpf.transport\$(ProGpuWpfManagedPackageVersion)\runtimes\$(RuntimeIdentifier)\lib\net10.0\DirectWriteForwarder.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibreWpfArchitectureRuntimeAsset)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- Microsoft.Build.NuGetSdkResolver.dll is NOT bundled by this build/publish anymore - see
       ICSharpCode.SharpDevelop.Project.MSBuildInternals.InitializeMSBuildEnvironment(). It is a
       ReadyToRun image built for the architecture of whichever SDK produced it, so a copy taken at
       build/publish time (from $(MSBuildToolsPath) on THIS machine) is only correct when this
       machine's own architecture happens to match the eventual $(RuntimeIdentifier) - cross-
       publishing the win-x64 distribution from an ARM64 dev machine (as dist.ps1 does) shipped the
       ARM64 copy, which crashes every SDK-style project load at runtime with "The SDK resolver
       assembly ... could not be loaded ... Format of the executable (.exe) or library (.dll) is
       invalid" (a mismatched R2R image fails the OS loader outright - no IL/JIT fallback). Instead,
       InitializeMSBuildEnvironment() deploys this DLL itself at first run, sourced from a .NET SDK
       it has confirmed matches the actually-running process's architecture
       (DotNetSdkService.ResolveEffectiveSdkForInProcessHosting()) - correct on every machine
       unconditionally, with no packaging-time knowledge of the eventual RuntimeIdentifier needed.
       When no architecture-matching SDK is installed at all, that same code logs
       NoCompatibleInProcessSdkFound instead of shipping something that would crash. -->
  <!-- Microsoft.CSharp.CurrentVersion.targets derives CSharpCoreTargetsPath from the hosted engine's
       own tool directory, and that really is this app's directory: MSBuild resolves
       $(MSBuildToolsPath) from its own toolset, which outranks the environment variable
       MSBuildInternals sets. (Measured: with Roslyn\ removed the import fails naming
       "<app dir>\Roslyn\Microsoft.CSharp.Core.targets", never the SDK's copy.) So the Roslyn
       .targets do have to sit beside the engine.

       What does NOT have to ship is Roslyn\bincore\ - 46.24 MB of compiler binaries (csc, vbc,
       VBCSCompiler, Microsoft.CodeAnalysis.*). The in-process engine only EVALUATES projects; it
       cannot run SDK tasks at all (see MinimalMSBuildEngine's type comment), and real builds go
       out-of-process through the selected SDK, which brings its own compiler. Those binaries were
       also the single largest source of wrong-architecture files in the payload, since
       $(MSBuildToolsPath) here is the BUILD machine's SDK: a win-x64 package cross-published from
       an ARM64 machine shipped an ARM64 csc.dll - and, caught one packaging round later, an ARM64
       Microsoft.Build.Tasks.CodeAnalysis.dll (the Csc/Vbc task assembly, which sits in Roslyn's
       root rather than in bincore and so survived an exclusion aimed at bincore alone).

       Hence the selection below is *.targets/*.props ONLY: plain text, no architecture, nothing to
       get wrong. That makes the whole class of mistake unrepresentable, instead of relying on an
       exclusion list that must enumerate every binary. A UsingTask naming an assembly that is not
       deployed costs evaluation nothing - it is resolved only when the task actually runs, which in
       this engine never happens. -->
  <Target Name="DeployRoslynBuildTools" AfterTargets="Build">
    <ItemGroup>
      <_RoslynBuildTools Include="$(MSBuildToolsPath)\Roslyn\**\*.targets;$(MSBuildToolsPath)\Roslyn\**\*.props" />
    </ItemGroup>
    <Copy SourceFiles="@(_RoslynBuildTools)"
          DestinationFiles="@(_RoslynBuildTools->'$(OutDir)Roslyn\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- dotnet publish does not mirror $(OutDir) - Publish only stages files explicitly marked
       ResolvedFileToPublish, so the AfterTargets="Build" Roslyn copy above (consumed by a dev/debug
       launch out of bin\) never reaches a published app's own publish\ directory. Repeat it into
       $(PublishDir) so a distributed build (dist.ps1's packaged OpenDevelop.exe) resolves SDK-style
       projects the same way a dev launch does. (The matching NuGetSdkResolver copy used to live
       here too - see the comment above DeployRoslynBuildTools for why that one moved to runtime.) -->
  <Target Name="DeployRoslynBuildToolsToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <!-- Same targets/props-only selection as DeployRoslynBuildTools - see its comment. -->
      <_RoslynBuildToolsPublish Include="$(MSBuildToolsPath)\Roslyn\**\*.targets;$(MSBuildToolsPath)\Roslyn\**\*.props" />
    </ItemGroup>
    <Copy SourceFiles="@(_RoslynBuildToolsPublish)"
          DestinationFiles="@(_RoslynBuildToolsPublish->'$(PublishDir)Roslyn\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- Out of MVP scope: Mono.Cecil (real submodule) is not referenced by this exe - AssemblyParserService.cs/
         GlobalAssemblyCacheService.cs/Fusion.cs used real Mono.Cecil, out of scope per MVP policy 1. -->
    <Compile Remove="Parser\AssemblyParserService.cs" />
    <Compile Remove="Parser\Fusion.cs" />
    <Compile Remove="Parser\GlobalAssemblyCacheService.cs" />
    <!-- Out of MVP scope: SharpTreeView-based Class Browser (MVP policy 3). -->
    <Compile Remove="Dom\**\*.cs" />
    <Page Remove="Dom\**\*.xaml" />
    <None Include="Dom\**\*.xaml" />
    <!-- WinForms<->WPF bridge (WinFormsService/SDWindowsFormsHost/WinFormsMenuService/
         WinFormsToolbarService) is back in the build - see the matching re-include note in
         ICSharpCode.SharpDevelop.csproj's WinForms\I*.cs entries. -->
    <!-- Out of MVP scope: WinForms dialogs (project configuration editor, open-with dialog) with no WPF
         replacement yet. -->
    <Compile Remove="Project\Configuration\AddNewConfigurationDialog.cs" />
    <Compile Remove="Project\Configuration\AddNewConfigurationDialog.Designer.cs" />
    <Compile Remove="Project\Configuration\EditAvailableConfigurationsDialog.cs" />
    <Compile Remove="Project\Configuration\EditAvailableConfigurationsDialog.Designer.cs" />
    <Compile Remove="Project\Configuration\SolutionConfigurationEditor.cs" />
    <Compile Remove="Project\Configuration\SolutionConfigurationEditor.Designer.cs" />
    <Compile Remove="Workbench\DisplayBinding\AddOpenWithEntryDialog.cs" />
    <Compile Remove="Workbench\DisplayBinding\AddOpenWithEntryDialog.Designer.cs" />
    <Compile Remove="Workbench\DisplayBinding\OpenWithDialog.cs" />
    <Compile Remove="Workbench\DisplayBinding\OpenWithDialog.Designer.cs" />
    <!-- Out of MVP scope: out-of-process MSBuild worker subsystem (BuildJob/EventTypes/EventSource linked
         from the separate ICSharpCode.SharpDevelop.BuildWorker WinForms console project, which is itself
         out of scope per docs/opendevelop.md). Not needed to boot an empty WPF workbench window; real build
         integration is deferred (R6+). -->
    <Compile Remove="Project\Build\MSBuildEngine\**\*.cs" />
    <!-- Out of MVP scope: WinForms Form-based splash screen; replaced by Startup\SplashScreenForm.cs (a
         plain static class keeping only the pure command-line-parsing logic SharpDevelopMain.cs needs). -->
    <Compile Remove="Startup\SplashScreen.cs" />
  </ItemGroup>
  <!--
    Unlike FormsDesigner.csproj, this exe's WinFormsService implements IWinFormsService (defined
    in ICSharpCode.SharpDevelop.csproj against the REAL netcore System.Drawing.Common, matching
    IconService.GetBitmap etc. there) - so the real assembly stays the default here. WinFormsService.cs
    no longer calls into WinFormsResourceService's Font/Bitmap/Icon members (which are compiled
    against the unrelated ProGPU.System.Drawing.Common identity) for exactly this reason - see the
    comment on WinFormsService.LoadFont/GetResourceServiceBitmap.
  -->
  <Target Name="RemoveDesktopRuntimeFramework" AfterTargets="ProcessFrameworkReferences" BeforeTargets="FixupRuntimeFrameworkVersions" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <RuntimeFramework Remove="@(RuntimeFramework)" Condition="'%(RuntimeFramework.Identity)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveTransitiveDesktopFramework" AfterTargets="ResolvePackageAssets" BeforeTargets="AddTransitiveFrameworkReferences" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="@(TransitiveFrameworkReference)" Condition="'%(TransitiveFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\LanguageServices\Roslyn.Host\Roslyn.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CollectRoslynHostRuntime" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\LanguageServices\Roslyn.Host\Roslyn.Host.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_RoslynHostAssembly" />
    </MSBuild>
    <ItemGroup>
      <_RoslynHostRuntime Include="%(_RoslynHostAssembly.RootDir)%(_RoslynHostAssembly.Directory)**\*" />
    </ItemGroup>
  </Target>
  <Target Name="DeployRoslynHostRuntime" AfterTargets="Build" DependsOnTargets="CollectRoslynHostRuntime">
    <Copy SourceFiles="@(_RoslynHostRuntime)"
          DestinationFiles="@(_RoslynHostRuntime->'$(TargetDir)RoslynHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishRoslynHostRuntime" AfterTargets="Publish" DependsOnTargets="CollectRoslynHostRuntime">
    <Copy SourceFiles="@(_RoslynHostRuntime)"
          DestinationFiles="@(_RoslynHostRuntime->'$(PublishDir)RoslynHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
