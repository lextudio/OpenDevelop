<Window x:Class="ICSharpCode.SharpDevelop.Templates.NewItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
        Title="{core:Localize Dialog.NewItem.Title}"
        Width="740" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <Window.Resources>
    <Style TargetType="ListViewItem">
      <Setter Property="Padding" Value="4" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Label Grid.Row="0" Content="{core:Localize Dialog.NewItem.ItemNameLabel}" Target="{Binding ElementName=NameBox}" />
    <TextBox x:Name="NameBox"
             Grid.Row="0"
             Margin="105,0,0,8"
             ToolTip="{core:Localize Dialog.NewItem.ItemNameToolTip}"
             TextChanged="OnNameChanged" />

    <Grid Grid.Row="1" Margin="0,4,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Label Content="{core:Localize Dialog.NewItem.ItemTypeLabel}" Target="{Binding ElementName=CategoryTree}" Padding="0,0,0,4" />
        <TreeView x:Name="CategoryTree" ToolTip="{core:Localize Dialog.NewItem.ItemTypeToolTip}" SelectedItemChanged="OnCategoryChanged" />
      </StackPanel>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" ToolTip="{core:Localize Dialog.NewItem.SearchToolTip}" TextChanged="OnSearchChanged" />
        <ListView x:Name="TemplateList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectionChanged" Margin="0,6,0,6">
          <ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedForeground}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="7"><StackPanel><TextBlock x:Name="TemplateTitleText" FontWeight="SemiBold" /><TextBlock x:Name="TemplateDescriptionText" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" /><TextBlock x:Name="TemplateDetailsText" Margin="0,4,0,0" Foreground="{DynamicResource MutedForeground}" /></StackPanel></Border>
      </Grid>
    </Grid>

    <TextBlock x:Name="CreatePathText" Grid.Row="2" Foreground="{DynamicResource MutedForeground}"
               TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
    <StackPanel Grid.Row="3" Margin="0,0,0,6">
      <Label Content="{core:Localize Dialog.NewItem.TemplateOptionsLabel}" Target="{Binding ElementName=TemplateOptionsPanel}" Padding="0,0,0,3" />
      <ScrollViewer Height="95" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TemplateOptionsPanel" /></ScrollViewer>
    </StackPanel>
    <Label Grid.Row="4" Content="{core:Localize Dialog.NewItem.AdvancedTemplateOptionsLabel}" Target="{Binding ElementName=ParametersBox}" />
    <TextBox x:Name="ParametersBox"
             Grid.Row="4"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             Margin="0,20,0,8"
             MinHeight="42"
             MaxHeight="64"
             ToolTip="{core:Localize Dialog.NewItem.TemplateOptionsToolTip}" />

    <TextBlock x:Name="StatusText"
               Grid.Row="5"
               Foreground="{DynamicResource MutedForeground}"
               Margin="0,0,0,8" />

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="AddButton"
              Content="Add"
              IsEnabled="False"
              Click="OnAddClick"
              Margin="0,0,8,0"
              Padding="12,4" />
      <Button Content="{core:Localize Global.Cancel}"
              Click="OnCancelClick"
              Padding="12,4" />
    </StackPanel>
  </Grid>
</Window>
