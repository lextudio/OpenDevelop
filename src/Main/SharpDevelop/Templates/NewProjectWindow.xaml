<Window x:Class="ICSharpCode.SharpDevelop.Templates.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
        Title="{core:Localize Dialog.NewProject.Title}"
        Width="780" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <Window.Resources>
    <Style TargetType="ListViewItem">
      <Setter Property="Padding" Value="4" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Label Grid.Row="0" Content="{core:Localize Dialog.NewProject.ProjectNameLabel}" Target="{Binding ElementName=NameBox}" />
    <TextBox x:Name="NameBox"
             Grid.Row="0"
             Margin="105,0,0,4"
             ToolTip="{core:Localize Dialog.NewProject.ProjectNameToolTip}"
             TextChanged="OnNameChanged" />

    <Label Grid.Row="1" Content="{core:Localize Dialog.NewProject.LocationLabel}" Target="{Binding ElementName=LocationBox}" />
    <Grid Grid.Row="1" Margin="105,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="LocationBox"
             Grid.Column="0"
             ToolTip="{core:Localize Dialog.NewProject.LocationToolTip}"
             TextChanged="OnLocationChanged" />
      <Button Grid.Column="1" Content="{core:Localize Dialog.NewProject.Browse}" Margin="8,0,0,0" Padding="10,2"
              ToolTip="{core:Localize Dialog.NewProject.BrowseToolTip}"
              Click="OnBrowseLocationClick" />
    </Grid>

    <Label x:Name="SolutionNameLabel" Grid.Row="2" Content="{core:Localize Dialog.NewProject.SolutionNameLabel}" Target="{Binding ElementName=SolutionNameBox}" />
    <TextBox x:Name="SolutionNameBox" Grid.Row="2" Margin="105,0,0,4"
             ToolTip="{core:Localize Dialog.NewProject.SolutionNameToolTip}"
             TextChanged="OnSolutionNameChanged" />
    <CheckBox x:Name="CreateSolutionDirectoryBox" Grid.Row="3" Grid.ColumnSpan="2"
              Content="{core:Localize Dialog.NewProject.CreateDirectoryForSolution}" IsChecked="True"
              ToolTip="{core:Localize Dialog.NewProject.CreateDirectoryForSolutionToolTip}"
              Checked="OnSolutionDirectoryChanged" Unchecked="OnSolutionDirectoryChanged" />

    <Grid Grid.Row="4" Margin="0,4,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Label Content="{core:Localize Dialog.NewProject.ProjectTypeLabel}" Target="{Binding ElementName=CategoryTree}" Padding="0,0,0,4" />
        <TreeView x:Name="CategoryTree" ToolTip="{core:Localize Dialog.NewProject.ProjectTypeToolTip}"
                  SelectedItemChanged="OnCategoryChanged" />
      </StackPanel>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" ToolTip="{core:Localize Dialog.NewProject.SearchToolTip}" TextChanged="OnSearchChanged" />
          <ComboBox x:Name="LanguageBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="{core:Localize Dialog.NewProject.LanguageToolTip}" SelectionChanged="OnLanguageChanged" />
        </Grid>
        <ListView x:Name="TemplateList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectionChanged" Margin="0,6,0,6">
          <ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedForeground}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="7">
          <StackPanel><TextBlock x:Name="TemplateTitleText" FontWeight="SemiBold" /><TextBlock x:Name="TemplateDescriptionText" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" /><TextBlock x:Name="TemplateDetailsText" Margin="0,4,0,0" Foreground="{DynamicResource MutedForeground}" /></StackPanel>
        </Border>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="5" Margin="0,0,0,6">
      <Label Content="{core:Localize Dialog.NewProject.TemplateOptionsLabel}" Target="{Binding ElementName=TemplateOptionsPanel}" Padding="0,0,0,3" />
      <ScrollViewer Height="115" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="TemplateOptionsPanel" />
      </ScrollViewer>
    </StackPanel>
    <Label Grid.Row="6" Content="{core:Localize Dialog.NewProject.AdvancedTemplateOptionsLabel}" Target="{Binding ElementName=ParametersBox}" />
    <TextBox x:Name="ParametersBox" Grid.Row="6"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             ToolTip="{core:Localize Dialog.NewProject.TemplateOptionsToolTip}"
             Margin="0,20,0,8" MinHeight="42" MaxHeight="64" />

    <TextBlock x:Name="StatusText"
               Grid.Row="7"
               Foreground="{DynamicResource MutedForeground}"
               Margin="0,0,0,8" />

    <TextBlock x:Name="CreatePathText"
               Grid.Row="8"
               Foreground="{DynamicResource MutedForeground}"
               TextTrimming="CharacterEllipsis"
               ToolTip="{core:Localize Dialog.NewProject.CreateInToolTip}"
               Margin="0,0,0,8" />

    <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CreateButton"
              Content="{core:Localize Dialog.NewProject.Create}"
              IsEnabled="False"
              Click="OnCreateClick"
              Margin="0,0,8,0"
              Padding="12,4" />
      <Button Content="{core:Localize Global.Cancel}"
              Click="OnCancelClick"
              Padding="12,4" />
    </StackPanel>
  </Grid>
</Window>
