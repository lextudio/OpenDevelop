<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Semantic application theme tokens (doc/technotes/ilspy.md "Immediate next actions" #5 /
        "Full application theming", 2026-08-02). See Theme.Light.xaml for the token list and the
        scope note (main shell chrome only, this pass).
    -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="ToolWindowBackground" Color="#FF252526" />
    <SolidColorBrush x:Key="Border" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Foreground" Color="#FFF1F1F1" />
    <SolidColorBrush x:Key="MutedForeground" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Selection" Color="#FF007ACC" />
</ResourceDictionary>
