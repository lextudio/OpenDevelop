<Window x:Class="ICSharpCode.SharpDevelop.Startup.SplashScreenForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDevelop"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Width="640" Height="346" WindowStartupLocation="CenterScreen"
        Background="#FF120F45">
	<!-- The WPF rewrite of the original WinForms splash (Startup/SplashScreen.cs, excluded via
	     <Compile Remove>): same type name (SplashScreenForm), so the port is obvious at a glance.
	     Artwork on top, the latest core/addin progress message docked at the bottom. -->
	<!-- Compact layout: the 2:1 artwork at its exact aspect (640x320, so Uniform never
	     letterboxes it), with a status line and unobtrusive version at the bottom. HighQuality scaling because the
	     source is 1774x887 and the default scaler aliases the text in the artwork. -->
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Height="26" Padding="12,0" Background="#FF120F45">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="Status" Foreground="#FFB9B6D6" FontSize="11" VerticalAlignment="Center"
				           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Starting OpenDevelop…" />
				<TextBlock x:Name="Version" Grid.Column="1" Foreground="#FFB9B6D6" FontSize="11"
				           VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="NoWrap" />
			</Grid>
		</Border>
		<Image x:Name="Artwork" Width="640" Height="320" Stretch="Uniform"
		       RenderOptions.BitmapScalingMode="HighQuality"
		       Source="pack://application:,,,/OpenDevelop;component/Startup/social.png" />
	</DockPanel>
</Window>
