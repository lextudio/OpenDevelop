<Project Sdk="LibreWPF.Sdk">

  <!-- LibreWPF (macOS/Linux) variant of the WPF Hot Reload agent. Everything shared - the linked
       agent sources, assembly identity and compile settings - lives in WpfHotReload.Agent.Shared.props;
       this project only chooses the SDK and the deploy subdirectory. The Microsoft WPF variant is
       the sibling project WpfHotReload.Agent.Microsoft. -->
  <PropertyGroup>
    <HotReloadAgentRuntime>librewpf</HotReloadAgentRuntime>
  </PropertyGroup>

  <Import Project="..\WpfHotReload.Agent.Shared.props" />

</Project>
