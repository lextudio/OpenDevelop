<Project>

  <!-- Common to every WpfHotReload agent variant. A variant picks its own SDK (LibreWPF.Sdk for
       the portable host, Microsoft.NET.Sdk for Windows Desktop WPF) and its own deploy
       subdirectory, but the agent sources, assembly identity and compile settings must stay
       identical - otherwise the IDE would inject a differently-built agent per runtime, and the
       reflection-based agent would no longer be "the same source serves both". -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WpfHotReload.Runtime</RootNamespace>
    <AssemblyName>WpfHotReload.Agent</AssemblyName>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- StartupHook must sit in the default namespace with this exact name: the runtime looks for
         a type literally called "StartupHook" with a static Initialize(). -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <!-- LibreWPF.Sdk targets the host RID (osx-arm64 on Apple silicon) when it builds, so restore
         must write the matching RID-specific target too. Without this the solution's RID-less
         restore omits it and the following no-restore build fails with NETSDK1047 ("doesn't have a
         target for 'net10.0-windows/osx-arm64'"). Declaring the RIDs here keeps restore and build
         consistent on every host; the SDK still picks one at build time. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- vscode-wpf's own agent, source-linked rather than copied so it keeps its own licence and
       dependency boundary, and so a fix on either side stays in one place. It only needs the WPF
       diagnostic APIs, which it resolves by reflection, so the same source compiles against
       LibreWPF for macOS/Linux as against Microsoft WPF. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\externals\vscode-wpf\src\WpfHotReload.Runtime\WpfHotReloadAgent.cs" Link="WpfHotReloadAgent.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\externals\vscode-wpf\src\WpfHotReload.Runtime\StartupHook.cs" Link="StartupHook.cs" />
  </ItemGroup>

  <!-- Deploy next to the IDE, under HotReload/<runtime>/, so the adapter can pick the variant that
       matches the debuggee's runtime (WpfApplicationHotReloadAdapter.LocateAgent). The agent is
       never loaded into the IDE: it is handed to the debuggee's runtime through
       DOTNET_STARTUP_HOOKS, so it only has to exist on disk at a known path. That is also why this
       is a plain copy and not a ProjectReference - referencing it would pull the agent's assembly
       into the IDE's own load context for no reason. -->
  <Target Name="DeployAgentToShell" AfterTargets="Build">
    <PropertyGroup>
      <_ShellHotReloadDir>$(MSBuildThisFileDirectory)..\SharpDevelop\bin\$(Configuration)\$(TargetFramework)\HotReload\$(HotReloadAgentRuntime)\</_ShellHotReloadDir>
    </PropertyGroup>
    <ItemGroup>
      <_AgentPayload Include="$(TargetDir)$(TargetName).dll" />
      <_AgentPayload Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentPayload)" DestinationFolder="$(_ShellHotReloadDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
