<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds Microsoft.VisualStudio.Text.Logic from the MIT-licensed sources in
       externals/vs-editor-api; see Microsoft.VisualStudio.CoreUtility.csproj for why the
       NuGet package is not used. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Microsoft.VisualStudio.Text.Logic</AssemblyName>
    <RootNamespace>Microsoft.VisualStudio.Text.Logic</RootNamespace>
    <Version>16.0.0</Version>
    <AssemblyVersion>16.0.0.0</AssemblyVersion>
    <FileVersion>16.0.0.0</FileVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS1572;CS1573;CS0649;CS0414;CS0169;CS3021;SYSLIB0003;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextLogic\**\*.cs"
             Exclude="..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextLogic\**\*AssemblyInfo.cs;..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextLogic\**\bin\**;..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextLogic\**\obj\**"
             LinkBase="vs-editor-api\Text\Def\TextLogic" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Microsoft.VisualStudio.CoreUtility\Microsoft.VisualStudio.CoreUtility.csproj" />
    <ProjectReference Include="..\Microsoft.VisualStudio.Text.Data\Microsoft.VisualStudio.Text.Data.csproj" />
    <PackageReference Include="System.ComponentModel.Composition" />
  </ItemGroup>
</Project>
