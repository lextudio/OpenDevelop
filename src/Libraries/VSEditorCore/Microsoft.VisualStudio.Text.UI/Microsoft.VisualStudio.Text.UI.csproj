<Project Sdk="LibreWPF.Sdk">
  <!-- Builds Microsoft.VisualStudio.Text.UI from the MIT-licensed sources in
       externals/vs-editor-api; see Microsoft.VisualStudio.CoreUtility.csproj for why the
       NuGet package is not used.

       This is the one assembly of the four that uses WPF types (WindowsBase /
       PresentationCore), so it builds through LibreWPF.Sdk like OpenDevelop.VSEditorCompat,
       which references it. The WPF/Cocoa view implementations are not part of the upstream
       open-source layers and are not needed here. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Microsoft.VisualStudio.Text.UI</AssemblyName>
    <RootNamespace>Microsoft.VisualStudio.Text.Editor</RootNamespace>
    <Version>16.0.0</Version>
    <AssemblyVersion>16.0.0.0</AssemblyVersion>
    <FileVersion>16.0.0.0</FileVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS1572;CS1573;CS0649;CS0414;CS0169;CS3021;SYSLIB0003;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextUI\**\*.cs"
             Exclude="..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextUI\**\*AssemblyInfo.cs;..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextUI\**\bin\**;..\..\..\..\externals\vs-editor-api\src\Editor\Text\Def\TextUI\**\obj\**"
             LinkBase="vs-editor-api\Text\Def\TextUI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Microsoft.VisualStudio.CoreUtility\Microsoft.VisualStudio.CoreUtility.csproj" />
    <ProjectReference Include="..\Microsoft.VisualStudio.Text.Data\Microsoft.VisualStudio.Text.Data.csproj" />
    <ProjectReference Include="..\Microsoft.VisualStudio.Text.Logic\Microsoft.VisualStudio.Text.Logic.csproj" />
    <PackageReference Include="Microsoft.VisualStudio.Validation" />
    <PackageReference Include="System.ComponentModel.Composition" />
  </ItemGroup>
</Project>
