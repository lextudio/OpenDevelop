<Project Sdk="LibreWPF.Sdk">
  <!--
    SharpTreeView duplicate resolution (2026-08-02, doc/technotes/ilspy.md). This project used to
    contain OpenDevelop's own SharpTreeNode/SharpTreeView implementation. It now instead:
      - references ICSharpCode.ILSpyX.TreeView (the extracted, dependency-light node/collection/
        flattener/platform-abstraction model, which ships inside the ICSharpCode.ILSpyX package -
        ICSharpCode.ILSpyX.TreeView.csproj) for the SharpTreeNode/SharpTreeNodeCollection model,
      - links ILSpy's Controls/TreeView/* WPF control layer (SharpTreeView/SharpTreeViewItem/
        SharpTreeNodeView/SharpGridView, plus automation-peer and type-to-search support that
        OpenDevelop's own control never had) instead of OpenDevelop's own control implementation,
      - adds an OpenDevelop-authored partial-class extension (SharpTreeNode.OpenDevelop.cs) for the
        GetModel/Model/ShowContextMenu members ILSpyX's SharpTreeNode does not have, since these
        are used pervasively by OpenDevelop's ClassBrowser/Debugger/UnitTesting/etc. node classes.
    This keeps the project/assembly name and the "http://icsharpcode.net/sharpdevelop/treeview"
    XAML namespace stable so existing consumer XAML (AndroidSdkManagerWindow.xaml,
    AnalysisProjectOptionsPanel.xaml, DependencyMatrixView.xaml, CommonResources.xaml,
    SearchForIssuesDialog.xaml) needs no changes; only consumer .cs files with
    `using ICSharpCode.TreeView;` need repointing to `ICSharpCode.ILSpyX.TreeView`.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.TreeView</RootNamespace>
    <AssemblyName>ICSharpCode.TreeView</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\Main\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416;WFO1000;CS0067;CS0108;CS0114;CS0618;CS0649</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" />
    <!-- The SharpTreeNode/SharpTreeNodeCollection/TreeFlattener model comes from the published
         ICSharpCode.ILSpyX package: ICSharpCode.ILSpyX.TreeView is compiled INTO it and is not
         published separately. -->
    <PackageReference Include="ICSharpCode.ILSpyX" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TomsToolbox.Wpf.Styles" />
    <PackageReference Include="TomsToolbox.Composition.MicrosoftExtensions" />
  </ItemGroup>

  <!--
    The ILSpy WPF control-layer source now LIVES here (ILSpy/Controls/TreeView/**), it is no longer
    linked out of an ILSpy checkout: this project is the owner of the tree control per
    the 2026-08-02 duplicate-type decision, and keeping the files in the fork meant every
    submodule update could silently move or delete them. Default SDK item globbing picks them up,
    and the physical path is deliberately the old Link path so the compiled resource name stays
    "ilspy/controls/treeview/sharptreeview.baml" - which is what Themes/Generic.xaml's qualified
    "/ICSharpCode.TreeView;component/ILSpy/Controls/TreeView/SharpTreeView.xaml" resolves to.

    ILSpy/NativeMethods.cs lives here too (SharpTreeViewTextSearch.cs needs
    NativeMethods.GetDoubleClickTime()); ILSpyAddIn links this one copy rather than owning a second.
  -->

  <ItemGroup>
    <Compile Include="..\..\..\Main\GlobalAssemblyInfo.cs" Link="Properties\GlobalAssemblyInfo.cs" />
  </ItemGroup>
</Project>
