<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        WPF's default-style lookup for a control type looks for "/themes/generic.xaml" in the
        control's OWN assembly (see doc/technotes/ilspy.md "Root cause: linked theme resource
        names" for the same gotcha hit by ILSpyAddIn). ILSpy's own SharpTreeView.xaml (linked
        above as ILSpy\Controls\TreeView\SharpTreeView.xaml, not at the assembly root) carries the
        actual default styles for SharpTreeView/SharpTreeViewItem/SharpTreeNodeView/SharpGridView/
        InsertMarker/EditTextBox - merge it here rather than duplicating its content, so this
        project's only authored file is this thin merge, not a copy of ILSpy's styles.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ICSharpCode.TreeView;component/ILSpy/Controls/TreeView/SharpTreeView.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
