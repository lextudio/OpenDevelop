<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>LeXtudio.OpenDevelop.ResourceFiles</RootNamespace>
    <AssemblyName>LeXtudio.OpenDevelop.ResourceFiles</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\Main\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
    <Description>Resource file parsers and models for OpenDevelop - .resx/.resources entry reading and writing, and .ico/.cur directory parsing. No WinForms/System.Drawing dependency, for the ResourceEditor addin's WPF-only migration.</Description>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
