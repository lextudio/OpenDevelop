<Project Sdk="LibreWPF.Sdk">
  <!-- Compatibility layer implementing the public Microsoft Visual Studio Editor Platform
       text model over AvalonEdit (see doc/technotes/vs-editor-api.md). This first PR is a pure
       text-model spike: no view, no tagging, no classification, no MEF, no projection.

       Design rule (from vs-editor-api.md section 7): AvalonEdit must NOT reference
       Microsoft.VisualStudio.Text.*; the dependency points only this way:

           Microsoft.VisualStudio.Text.*  &lt;-  OpenDevelop.VSEditorCompat  -&gt;  ICSharpCode.AvalonEdit

       The left side is built from externals/vs-editor-api by src/Libraries/VSEditorCore, not
       taken from the Microsoft NuGet packages: those packages' LICENSE restricts them to
       Visual Studio use and forbids redistributing them inside another application (see
       doc/technotes/licensing-audit.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LeXtudio.OpenDevelop.VSEditor</RootNamespace>
    <AssemblyName>OpenDevelop.VSEditorCompat</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SignAssembly>false</SignAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build the editor contracts from externals/vs-editor-api (MIT) instead of the
         Microsoft.VisualStudio.Text.* NuGet packages, whose LICENSE limits use to Visual
         Studio and forbids redistributing the assemblies inside another application - the
         same problem that retired Microsoft.VisualStudio.Shared.VSCodeDebugProtocol. See
         src/Libraries/VSEditorCore and doc/technotes/licensing-audit.md.

         Build all three from one source checkout - do not mix them with NuGet copies
         (vs-editor-api.md §38). Text.UI carries the non-WPF view contracts
         (ITextView/ITextCaret/ITextSelection/IViewScroller); the WPF-only UI.Wpf assembly
         stays out (sections 5.1 and 36). -->
    <ProjectReference Include="..\VSEditorCore\Microsoft.VisualStudio.Text.Data\Microsoft.VisualStudio.Text.Data.csproj" />
    <ProjectReference Include="..\VSEditorCore\Microsoft.VisualStudio.Text.Logic\Microsoft.VisualStudio.Text.Logic.csproj" />
    <ProjectReference Include="..\VSEditorCore\Microsoft.VisualStudio.Text.UI\Microsoft.VisualStudio.Text.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.AvalonEdit.LibreWPF" />
  </ItemGroup>
</Project>
