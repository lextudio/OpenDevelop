<Project Sdk="LibreWPF.Sdk">
  <!-- Compatibility layer implementing the public Microsoft Visual Studio Editor Platform
       text model over AvalonEdit (see doc/technotes/vs-editor-api.md). This first PR is a pure
       text-model spike: no view, no tagging, no classification, no MEF, no projection.

       Design rule (from vs-editor-api.md section 7): AvalonEdit must NOT reference
       Microsoft.VisualStudio.Text.*; the dependency points only this way:

           Microsoft.VisualStudio.Text.*  &lt;-  OpenDevelop.VSEditorCompat  -&gt;  ICSharpCode.AvalonEdit

       The left side is the lextudio/vs-editor-api fork's MIT build (a package), not
       taken from the Microsoft NuGet packages: those packages' LICENSE restricts them to
       Visual Studio use and forbids redistributing them inside another application (see
       doc/technotes/licensing-audit.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LeXtudio.OpenDevelop.VSEditor</RootNamespace>
    <AssemblyName>OpenDevelop.VSEditorCompat</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SignAssembly>false</SignAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The editor contracts are the lextudio/vs-editor-api fork's MIT builds, published to GitHub Packages
         under Microsoft's own ids (NuGet.Config maps these ids to the lextudio sources only), NOT Microsoft's
         packages: those are licensed for Visual Studio use only and forbid redistribution inside another
         application (the same problem that retired Microsoft.VisualStudio.Shared.VSCodeDebugProtocol). See
         doc/technotes/licensing-audit.md. The packages are one 17.3.198.1 set built from one source
         snapshot (vs-editor-api.md section 38). Text.UI carries the non-WPF view contracts
         (ITextView/ITextCaret/ITextSelection/IViewScroller); the WPF-only UI.Wpf assembly stays out
         (sections 5.1 and 36). -->
    <PackageReference Include="Microsoft.VisualStudio.Text.Data" />
    <PackageReference Include="Microsoft.VisualStudio.Text.Logic" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.AvalonEdit.LibreWPF" />
  </ItemGroup>
</Project>
