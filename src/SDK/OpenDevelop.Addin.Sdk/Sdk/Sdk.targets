<Project>
  <PropertyGroup>
    <OpenDevelopTrimHostAssemblies Condition="'$(OpenDevelopTrimHostAssemblies)' == ''">true</OpenDevelopTrimHostAssemblies>
    <OpenDevelopPruneDeploymentAssets Condition="'$(OpenDevelopPruneDeploymentAssets)' == ''">true</OpenDevelopPruneDeploymentAssets>
    <OpenDevelopAddinKind Condition="'$(OpenDevelopAddinKind)' == ''">InProcess</OpenDevelopAddinKind>
    <OpenDevelopHostBin Condition="'$(OpenDevelopHostBin)' == '' And '$(OpenDevelopRepoRoot)' != ''">$(OpenDevelopRepoRoot)src/Main/SharpDevelop/bin/$(Configuration)/net10.0-windows/</OpenDevelopHostBin>
    <OpenDevelopHostManifest Condition="'$(OpenDevelopHostManifest)' == '' And '$(OpenDevelopHostBin)' != ''">$(OpenDevelopHostBin)OpenDevelop.host-assemblies.txt</OpenDevelopHostManifest>
  </PropertyGroup>
  <!-- Run/Debug support: make the addin project startable so F5 launches a second OpenDevelop
       with this addin loaded (what SharpDevelop's AddIn project template did historically - the
       trailing-quote hack in SplashScreen.cs is a fossil of exactly that).
       
       These are the plain MSBuild properties DotNetStartBehavior reads via GetEvaluatedProperty,
       and StartAction=Program makes IsStartable depend only on StartProgram being non-empty, so a
       Library becomes startable without any project-system change. Everything is Condition-guarded
       so a project can override any single piece.
       
       Set in .targets rather than .props because OpenDevelopHostBin is only known after the
       consuming repo's Directory.Build.targets (or the project itself) has set OpenDevelopRoot. -->
  <PropertyGroup Condition="'$(OpenDevelopAddin)' == 'true' And '$(OpenDevelopAddinKind)' == 'InProcess'">
    <OpenDevelopDebugHost Condition="'$(OpenDevelopDebugHost)' == '' And '$(OpenDevelopHostBin)' != ''">$(OpenDevelopHostBin)OpenDevelop</OpenDevelopDebugHost>
    <!-- Per-project, stable across runs so the experimental instance remembers its own layout,
         and never the developer's real profile. -->
    <OpenDevelopDebugConfigDir Condition="'$(OpenDevelopDebugConfigDir)' == ''">$(MSBuildProjectDirectory)/.od-experimental-instance</OpenDevelopDebugConfigDir>
	<!-- Test-only opt-in. Normal addin F5 remains DevFlow-off so it cannot collide with the
	     developer's primary IDE; a caller can allocate a separate child endpoint explicitly. -->
	<OpenDevelopDebugDevFlowArgument Condition="'$(OpenDevelopDebugDevFlowPort)' == ''">-devflow:off</OpenDevelopDebugDevFlowArgument>
	<OpenDevelopDebugDevFlowArgument Condition="'$(OpenDevelopDebugDevFlowPort)' != ''">-devflow:$(OpenDevelopDebugDevFlowPort)</OpenDevelopDebugDevFlowArgument>
    <StartAction Condition="'$(StartAction)' == ''">Program</StartAction>
    <StartProgram Condition="'$(StartProgram)' == '' And '$(OpenDevelopDebugHost)' != ''">$(OpenDevelopDebugHost)</StartProgram>
    <!-- No trailing separator on either path: SplashScreenForm.SetCommandLineArgs rewrites a
         trailing quote into a backslash, which would corrupt the directory. -->
    <!-- OutputPath is conventionally project-relative (and MSBuild evaluates relative paths in
         property functions against the project's own directory), but the child instance's working
         directory is OpenDevelopHostBin, not this project's directory - a relative -addindir: value
         resolved a plain HintPath-style OutputPath (no explicit absolute OutputPath, e.g. a
         freshly-generated addin from the project template) against the WRONG base and pointed at a
         directory that doesn't exist. GetFullPath is a no-op on the Stride-addin-style case where
         OutputPath is already absolute. -->
    <StartArguments Condition="'$(StartArguments)' == '' And '$(OpenDevelopDebugHost)' != ''">-addindir:"$([System.IO.Path]::GetFullPath('$(OutputPath)').TrimEnd('\/'))" -configdir:"$(OpenDevelopDebugConfigDir.TrimEnd('\/'))" $(OpenDevelopDebugDevFlowArgument)</StartArguments>
    <StartWorkingDirectory Condition="'$(StartWorkingDirectory)' == '' And '$(OpenDevelopHostBin)' != ''">$(OpenDevelopHostBin)</StartWorkingDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(OpenDevelopAddin)' == 'true' And '@(OpenDevelopAddinManifest)' == ''">
    <OpenDevelopAddinManifest Include="$(MSBuildProjectDirectory)/*.addin" />
  </ItemGroup>
  <!-- In-process addins run in OpenDevelop's default AssemblyLoadContext. Shared assemblies
       are resolved from the host base directory, so copying them into every AddIns leaf is
       redundant. Do this before CopyLocal writes the closure; the post-build trim below remains
       necessary to remove stale files produced before the host manifest became available.

       A missing manifest deliberately fails open. This supports a newly-created out-of-tree
       addin before its target IDE has been built. Out-of-process hosts are separate applications
       with their own deps.json closure and are never filtered. -->
  <Target Name="RemoveHostProvidedFilesFromAddInCopyLocal"
          BeforeTargets="GetCopyToOutputDirectoryItems;_CopyFilesMarkedCopyLocal"
          Condition="'$(OpenDevelopAddin)' == 'true'
                     And '$(OpenDevelopAddinKind)' != 'OutOfProcessHost'
                     And '$(OpenDevelopTrimHostAssemblies)' == 'true'
                     And (Exists('$(OpenDevelopHostManifest)') Or Exists('$(OpenDevelopHostPublishManifest)') Or '$(OpenDevelopHostPublishDir)' != '')">
    <!-- A package build supplies the final publish manifest. A normal SDK build uses the
         host output manifest; the directory glob is compatibility-only for older callers. -->
    <ReadLinesFromFile File="$(OpenDevelopHostManifest)"
                       Condition="Exists('$(OpenDevelopHostManifest)') And !Exists('$(OpenDevelopHostPublishManifest)')">
      <Output TaskParameter="Lines" ItemName="_OpenDevelopHostCopyLocalFile" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(OpenDevelopHostPublishManifest)" Condition="Exists('$(OpenDevelopHostPublishManifest)')">
      <Output TaskParameter="Lines" ItemName="_OpenDevelopHostCopyLocalFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_OpenDevelopHostCopyLocalFile Include="$(OpenDevelopHostPublishDir)/**/*"
                                          Condition="!Exists('$(OpenDevelopHostManifest)') And !Exists('$(OpenDevelopHostPublishManifest)') And Exists('$(OpenDevelopHostPublishDir)')" />
      <_OpenDevelopHostCopyLocalFile Remove="@(OpenDevelopAlwaysCopy)"
                                          MatchOnMetadata="Filename;Extension"
                                          MatchOnMetadataOptions="PathLike" />
      <ReferenceCopyLocalPaths Remove="@(_OpenDevelopHostCopyLocalFile)"
                               MatchOnMetadata="Filename;Extension"
                               MatchOnMetadataOptions="PathLike" />
      <!-- Package targets may inject copy candidates outside ReferenceCopyLocalPaths. -->
      <None Remove="@(_OpenDevelopHostCopyLocalFile)"
            MatchOnMetadata="Filename;Extension"
            MatchOnMetadataOptions="PathLike" />
      <Content Remove="@(_OpenDevelopHostCopyLocalFile)"
               MatchOnMetadata="Filename;Extension"
               MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
  </Target>
  <Target Name="OpenDevelopValidateAddin" BeforeTargets="Build" Condition="'$(OpenDevelopAddin)' == 'true'">
    <Error Condition="'$(OpenDevelopAddinKind)' != 'InProcess' And '$(OpenDevelopAddinKind)' != 'InProcessDependency' And '$(OpenDevelopAddinKind)' != 'OutOfProcessHost'" Text="OpenDevelopAddinKind must be InProcess, InProcessDependency, or OutOfProcessHost, not '$(OpenDevelopAddinKind)'." />
    <Error Condition="'$(OpenDevelopAddinKind)' == 'InProcess' And '@(OpenDevelopAddinManifest)' == ''" Text="No .addin manifest was found. Add one beside the project or declare OpenDevelopAddinManifest explicitly." />
    <!-- A RuntimeIdentifier makes the compiler stamp the output for one architecture; OpenDevelop
         loads AddIns into a process whose architecture follows the user's dotnet host, so such an
         assembly throws "The assembly architecture is not compatible with the current process
         architecture" - at load time, on the user's machine, never on the build machine that
         produced it. Checking this input beats inspecting PE headers afterwards, because the
         message can say what to do.

         Error only for a distribution build; warn otherwise. In THIS repo most AddIn projects use
         Sdk="LibreWPF.Sdk" directly and are merely recognised as AddIns by Directory.Build.targets,
         so they get these targets but not this SDK's props - and LibreWPF.Sdk assigns
         RuntimeIdentifier = $(NETCoreSdkRuntimeIdentifier) by default. Erroring unconditionally
         therefore breaks every ordinary `dotnet build` (it did: StartPage.csproj and others). What
         actually has to be clean is what gets packaged, and dist.ps1 additionally verifies the PE
         machine of every assembly in the payload. Third-party AddIns that do consume this SDK get
         ProGpuWpfUseCurrentRuntimeIdentifier=false from its props, so a RID there is deliberate and
         the warning is accurate for them too. -->
    <Error Condition="'$(RuntimeIdentifier)' != '' And '$(OpenDevelopAllowRidSpecificAddin)' != 'true' And '$(OpenDevelopDistributionBuild)' == 'true'"
           Text="This AddIn is being packaged for RuntimeIdentifier '$(RuntimeIdentifier)', so its output will only load in a $(RuntimeIdentifier) process. OpenDevelop AddIns must be AnyCPU: remove RuntimeIdentifier, or pass -p:ProGpuWpfUseCurrentRuntimeIdentifier=false if LibreWPF.Sdk supplied it. If this AddIn genuinely ships per-architecture builds, set OpenDevelopAllowRidSpecificAddin=true and deploy one copy per architecture." />
    <Warning Condition="'$(RuntimeIdentifier)' != '' And '$(OpenDevelopAllowRidSpecificAddin)' != 'true' And '$(OpenDevelopDistributionBuild)' != 'true'"
             Text="This AddIn is being built for RuntimeIdentifier '$(RuntimeIdentifier)', so its output only loads in a $(RuntimeIdentifier) process. That is fine for local development, but a distribution build will reject it. See doc/technotes/addin-sdk.md, 'Architecture: addins are AnyCPU'." />
  </Target>

  <PropertyGroup>
    <!-- Out-of-process hosts are started as "dotnet exec <host>.dll", never through an apphost (see
         DesignerHostProcessClient). The generated .exe would be the only architecture-specific file
         such a project produces, so suppressing it is what keeps an OutOfProcessHost AnyCPU.
         Set unconditionally: the .NET SDK's props default UseAppHost to true long before this file
         is imported, so an "only if unset" guard would never fire. -->
    <UseAppHost Condition="'$(OpenDevelopAddinKind)' == 'OutOfProcessHost'">false</UseAppHost>
  </PropertyGroup>
  <Target Name="OpenDevelopDeployAddinManifest" AfterTargets="Build" DependsOnTargets="OpenDevelopValidateAddin" Condition="'$(OpenDevelopAddin)' == 'true' And '$(OpenDevelopAddinKind)' == 'InProcess'">
    <Copy SourceFiles="@(OpenDevelopAddinManifest)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="OpenDevelopTrimAddinOutput" AfterTargets="OpenDevelopDeployAddinManifest;Build" Condition="'$(OpenDevelopAddin)' == 'true' And '$(OpenDevelopAddinKind)' != 'OutOfProcessHost' And '$(OpenDevelopTrimHostAssemblies)' == 'true' And '$(OpenDevelopHostBin)' != '' And Exists('$(OpenDevelopHostManifest)')">
    <!-- The manifest is deliberately generated from the host's final TargetDir.  Do not glob
         OpenDevelopHostBin here: distribution builds run this target for every add-in, and that
         made every project repeatedly enumerate the complete host closure and then probe every
         matching file in its output directory.  The manifest is both the smaller, authoritative
         candidate set and the correct ownership boundary: a same-named private add-in DLL that
         is not in the shipped host closure must not be removed. -->
    <ReadLinesFromFile File="$(OpenDevelopHostManifest)">
      <Output TaskParameter="Lines" ItemName="_OpenDevelopHostAssemblyName" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_OpenDevelopRedundantAssembly Include="@(_OpenDevelopHostAssemblyName->'$(OutputPath)%(Identity)')" />
      <_OpenDevelopRedundantAssembly Remove="@(_OpenDevelopRedundantAssembly)" Condition="!Exists('%(Identity)')" />
      <_OpenDevelopRedundantAssembly Remove="@(OpenDevelopAlwaysCopy)" MatchOnMetadata="Filename" />
    </ItemGroup>
    <Delete Files="@(_OpenDevelopRedundantAssembly)" />
    <Message Importance="normal" Text="OpenDevelop Addin SDK: removed @(_OpenDevelopRedundantAssembly->Count()) host-provided assemblies from $(OutputPath)." Condition="@(_OpenDevelopRedundantAssembly->Count()) &gt; 0" />
  </Target>
  <Target Name="OpenDevelopRestorePortableWpfHostRuntime"
          AfterTargets="Build"
          BeforeTargets="OpenDevelopPruneAddinDeploymentAssets;DeployToAddIns"
          Condition="'$(OpenDevelopAddin)' == 'true' And '$(OpenDevelopAddinKind)' == 'OutOfProcessHost' And '$(OpenDevelopDistributionBuild)' == 'true'">
    <ItemGroup>
      <!-- LibreWPF intentionally exposes reference assemblies from ref/net10.0.
           RID-less publish can omit their lib/net10.0 implementations, which a
           child process cannot resolve from the parent application's base dir. -->
      <_OpenDevelopPortableWpfReference Include="@(ReferencePath)"
        Condition="$([System.String]::Copy('%(FullPath)').ToLowerInvariant().Contains('/librewpf.transport/')) And $([System.String]::Copy('%(FullPath)').Contains('/ref/'))" />
      <_OpenDevelopPortableWpfRuntime Include="$([System.String]::Copy('%(_OpenDevelopPortableWpfReference.FullPath)').Replace('/ref/', '/lib/'))"
        Condition="Exists('%(Identity)')" />
      <!-- dist.ps1 builds AddIns with ProGpuWpfCopyPackageRuntimeAssets=false because in-process
           AddIns share the IDE's copy. A child host has no such parent directory to fall back
           to, so restore the ProGPU.* / LibreWPF.Interop implementations it references too;
           without them the portable bootstrap dies with FileNotFoundException for
           ProGPU.Wpf.Interop before JSON-RPC connects. -->
      <_OpenDevelopProGpuReference Include="@(ReferencePath)"
        Condition="($([System.String]::Copy('%(FullPath)').ToLowerInvariant().Replace('\','/').Contains('/progpu.')) Or $([System.String]::Copy('%(FullPath)').ToLowerInvariant().Replace('\','/').Contains('/librewpf.interop/'))) And $([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/lib/'))" />
      <_OpenDevelopPortableWpfRuntime Include="@(_OpenDevelopProGpuReference)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_OpenDevelopPortableWpfRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="OpenDevelop Addin SDK: restored @(_OpenDevelopPortableWpfRuntime->Count()) portable WPF runtime assemblies for $(MSBuildProjectName)." Condition="@(_OpenDevelopPortableWpfRuntime->Count()) &gt; 0" />
  </Target>
  <Target Name="OpenDevelopPruneAddinDeploymentAssets"
          BeforeTargets="DeployToAddIns"
          AfterTargets="OpenDevelopTrimAddinOutput;OpenDevelopDeployAddinManifest;Build"
          Condition="'$(OpenDevelopAddin)' == 'true' And '$(OpenDevelopDistributionBuild)' == 'true' And '$(OpenDevelopPruneDeploymentAssets)' == 'true'">
    <ItemGroup>
      <!-- Delete an XML file only when a same-directory DLL proves that it is API
           documentation. AddIn-owned XML layouts/configuration remain untouched. -->
      <_OpenDevelopDeploymentAssembly Include="$(OutputPath)**/*.dll" />
      <_OpenDevelopXmlDocumentation Include="@(_OpenDevelopDeploymentAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
                                    Condition="Exists('%(Identity)')" />
      <!-- ref/ and foreign runtime RID roots are complete subtrees that can never be useful in
           the current distribution. Remove those directories atomically instead of handing
           MSBuild one Delete item per file; a clean macOS distribution otherwise spends a
           noticeable amount of time unlinking thousands of files one by one. -->
      <!-- During an isolated parallel staging build the reference assemblies remain live build
           inputs for projects scheduled later in the graph.  Preserve them until the coordinator
           has finished; the staging deployment target excludes ref/**, so they never reach the
           final AddIns tree. -->
      <_OpenDevelopReferenceDirectory Include="$(OutputPath)ref"
                                           Condition="Exists('$(OutputPath)ref') And '$(OpenDevelopDistributionStagingRoot)' == ''" />
      <!-- A distribution contains one OS family only. Keep Windows native payloads for both
           win-x64 and win-arm64, but never carry macOS/Linux/Unix package payloads into either
           Windows architecture. The converse preserves only the macOS family. -->
      <_OpenDevelopForeignRuntimeAsset Include="$(OutputPath)**/runtimes/win*/**/*;$(OutputPath)**/runtimes/linux*/**/*;$(OutputPath)**/runtimes/unix*/**/*"
                                       Condition="'$(OpenDevelopDistributionRidFamily)' == 'osx'" />
      <_OpenDevelopForeignRuntimeAsset Include="$(OutputPath)**/runtimes/osx*/**/*;$(OutputPath)**/runtimes/linux*/**/*;$(OutputPath)**/runtimes/unix*/**/*"
                                       Condition="'$(OpenDevelopDistributionRidFamily)' == 'win'" />
      <_OpenDevelopForeignRuntimeDirectory Include="@(_OpenDevelopForeignRuntimeAsset->'%(RootDir)%(Directory)')" />
      <_OpenDevelopForeignNativeAsset Include="$(OutputPath)**/*.dylib;$(OutputPath)**/*.so"
                                       Condition="'$(OpenDevelopDistributionRidFamily)' == 'win'" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_OpenDevelopForeignRuntimeDirectory)">
      <Output TaskParameter="Filtered" ItemName="_OpenDevelopForeignRuntimeDirectoryToRemove" />
    </RemoveDuplicates>
    <RemoveDir Directories="@(_OpenDevelopReferenceDirectory);@(_OpenDevelopForeignRuntimeDirectoryToRemove)" />
    <Delete Files="@(_OpenDevelopXmlDocumentation);@(_OpenDevelopForeignNativeAsset)" />
    <Message Importance="normal"
             Text="OpenDevelop Addin SDK: pruned @(_OpenDevelopXmlDocumentation->Count()) XML docs, @(_OpenDevelopReferenceDirectory->Count()) reference directories, @(_OpenDevelopForeignRuntimeDirectoryToRemove->Count()) foreign runtime directories, and @(_OpenDevelopForeignNativeAsset->Count()) foreign native assets from $(OutputPath)."
             Condition="@(_OpenDevelopXmlDocumentation->Count()) &gt; 0 Or @(_OpenDevelopReferenceDirectory->Count()) &gt; 0 Or @(_OpenDevelopForeignRuntimeDirectoryToRemove->Count()) &gt; 0 Or @(_OpenDevelopForeignNativeAsset->Count()) &gt; 0" />
  </Target>
</Project>
