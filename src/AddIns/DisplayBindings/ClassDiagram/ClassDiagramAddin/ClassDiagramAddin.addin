<?xml version="1.0" encoding="utf-8" ?>
<AddIn name="Class Diagram" author="OpenDevelop Team"
       description="Shows a Roslyn-based class diagram of the current project."
       addInManagerHidden="preinstalled">
  <Manifest><Identity name="ClassDiagram" /></Manifest>
  <Runtime><Import assembly="ClassDiagramAddin.dll" /></Runtime>
  <Path name="/SharpDevelop/Pads/ProjectBrowser/ContextMenu/ProjectNode">
    <MenuItem id="ShowClassDiagram" label="Class Diagram"
              class="ICSharpCode.ClassDiagram.ShowClassDiagramCommand"
              icon="Icons.16x16.Class" />
  </Path>
  <Path name="/SharpDevelop/Workbench/FileFilter">
    <FileFilter id="ClassDiagramFileFilter" name="Class Diagrams (*.cd)"
                extensions="*.cd" mimeType="text/xml" />
  </Path>
  <Path name="/SharpDevelop/Workbench/DisplayBindings">
    <DisplayBinding id="ClassDiagram"
                    class="ICSharpCode.ClassDiagram.ClassDiagramDisplayBinding"
                    insertbefore="Text" fileNamePattern="\.(cd)$"
                    title="Class Diagram" />
  </Path>
</AddIn>
