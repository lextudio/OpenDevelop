    <RootNamespace>ICSharpCode.ClassDiagram</RootNamespace>
    <AssemblyName>ClassDiagram.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.Msagl" Version="1.1.6" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ClassDiagramAddin\Src\ClassDiagramDocument.cs" Link="ClassDiagramDocument.cs" />
    <Compile Include="..\ClassDiagramAddin\Src\MsaglClassDiagramLayoutEngine.cs" Link="MsaglClassDiagramLayoutEngine.cs" />
  </ItemGroup>
</Project>
