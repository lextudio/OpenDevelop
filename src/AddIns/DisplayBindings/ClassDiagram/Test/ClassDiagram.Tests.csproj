<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>ICSharpCode.ClassDiagram.Tests.Program</StartupObject>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnitLite" />
    <ProjectReference Include="..\Core\ClassDiagram.Core.csproj" />
  </ItemGroup>
</Project>
