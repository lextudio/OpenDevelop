<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.AvalonEdit.AddIn</RootNamespace>
    <AssemblyName>ICSharpCode.AvalonEdit.AddIn</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\Main\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
    <OutputPath>..\..\..\..\AddIns\DisplayBindings\AvalonEdit\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Libraries\AvalonEdit\ICSharpCode.AvalonEdit\ICSharpCode.AvalonEdit.csproj" Private="false" />
    <!-- Private="false": OpenDevelop.VSEditorCompat (and its Microsoft.VisualStudio.Text.*
         contract packages) are provided by the SharpDevelop app project so there is exactly
         one loaded copy - the CodeEditor registers its AvalonTextBuffer into the document
         service container, and the DevFlow actions / extensions resolve the same buffer by
         interface identity. -->
    <ProjectReference Include="..\..\..\Libraries\VSEditorCompat\OpenDevelop.VSEditorCompat.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Libraries\ICSharpCode.TypeSystem.Abstractions\ICSharpCode.TypeSystem.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.SharpDevelop.Widgets\Project\ICSharpCode.SharpDevelop.Widgets.csproj" Private="false" />
    <!-- For IdeThemeService (theme-aware editor syntax colors, see ThemeAwareHighlightingColorizer). -->
    <ProjectReference Include="..\..\..\Main\SharpDevelop\SharpDevelop.csproj" Private="false" />
    <!-- Private="true" (the default - not "false" like the other addin-infra references above):
         AvalonEditViewContent.ToolsContent directly evaluates ICSharpCode.WpfDesign.AddIn.
         WpfToolbox.Instance (a hard compile-time reference, not reflection), so this addin's own
         output folder genuinely needs ICSharpCode.WpfDesign.AddIn.dll (and its own Designer/
         XamlDom/core dependencies) copied locally - AssemblyLocator.cs's AppDomain.AssemblyResolve
         hook only re-resolves assemblies already loaded once elsewhere, it doesn't search other
         addins' folders on demand. WpfDesign.AddIn.csproj's own "WpfDesign.addin" manifest is
         separately prevented from tagging along via CopyToOutputDirectory (see its own comment),
         so this doesn't reintroduce the duplicate-AddInTree-identity problem in unrelated addins'
         folders (PackageManagement, CodeCoverage, ILSpyAddIn) that never reference this project. -->
    <ProjectReference Include="..\WpfDesign\WpfDesign.AddIn\WpfDesign.AddIn.csproj" />
    <!-- Same reasoning as the WpfDesign.AddIn reference above: AvalonEditViewContent.ToolsContent
         also hard-references ICSharpCode.WinUIXamlDesigner.WinUIXamlToolbox.Instance for a WinUI/
         Uno .xaml file's Source tab. -->
    <ProjectReference Include="..\WinUIXamlDesigner\WinUIXamlDesigner.AddIn\ICSharpCode.WinUIXamlDesigner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- VSEditorViewDevFlowActions.cs: lets tests/OpenDevelop.IntegrationTests verify real
         ITextViewLine geometry (vs-editor-api.md sections 22/64) against the app's actual running
         Dispatcher - a bare in-process WPF Window/UpdateLayout() in a unit test process hangs on
         this repo's LibreWPF/macOS stack (no native message loop), so [DevFlowUIThread] is the
         only way to force real layout deterministically. Same conditional dev-inner-loop pattern
         as XamlBinding.csproj. -->
    <ProjectReference Include="..\..\..\..\..\..\wpf-labs\src\DevFlow\LeXtudio.DevFlow.Agent.Core\LeXtudio.DevFlow.Agent.Core.csproj" Private="False" Condition="'$(Configuration)' == 'Debug' And Exists('..\..\..\..\..\..\wpf-labs\src\DevFlow\LeXtudio.DevFlow.Agent.Core\LeXtudio.DevFlow.Agent.Core.csproj')" />
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" Version="0.2.2" Condition="'$(Configuration)' == 'Debug' And !Exists('..\..\..\..\..\..\wpf-labs\src\DevFlow\LeXtudio.DevFlow.Agent.Core\LeXtudio.DevFlow.Agent.Core.csproj')" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
    <None Include="AvalonEdit.AddIn.addin" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="Resources\IncrementalSearchCursor.cur" />
    <EmbeddedResource Include="Resources\ReverseIncrementalSearchCursor.cur" />
  </ItemGroup>
</Project>
