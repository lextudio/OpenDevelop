<AddIn name        = "ILSpy AddIn"
       author      = "Daniel Grunwald"
       copyright   = "prj:///doc/copyright.txt"
       description = "Can open ILSpy on a selected class or member."
       addInManagerHidden = "preinstalled">
	
	<Manifest>
		<Identity name="ICSharpCode.ILSpyAddIn" />
	</Manifest>
	
	<Runtime>
		<Import assembly = "ILSpyAddIn.dll"/>
	</Runtime>
	
	<Path name="/SharpDevelop/Services/NavigateToEntityService">
		<Class id="ILSpy" class="ICSharpCode.ILSpyAddIn.NavigateToDecompiledEntityService"/>
	</Path>
	
	<Path name = "/SharpDevelop/Parser">
		<Parser id    = "ILSpy"
		        insertbefore="C#"
		        supportedfilenamepattern="^ilspy\://"
		        class = "ICSharpCode.ILSpyAddIn.ILSpyParser" />
	</Path>
	
	<Path name="/SharpDevelop/Services/DebuggerService/ModuleContextMenu">
		<MenuItem id="OpenLoadedModuleInILSpy"
		          label="${res:ILSpyAddIn.OpenILSpyCommand}"
		          icon="ILSpy"
		          class="ICSharpCode.ILSpyAddIn.OpenLoadedModuleInILSpyCommand" />
	</Path>

	<Path name = "/SharpDevelop/Workbench/DisplayBindings/UrlBased">
		<DisplayBinding id = "ILSpyView"
		                class = "ICSharpCode.ILSpyAddIn.ILSpyDisplayBinding"
		                fileNamePattern = "^ilspy://"
		                title = "ILSpy Decompiler View"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/DisplayBindings">
		<!-- .dll/.exe route to the hosted ILSpy (open + auto-enter the ILSpy layout) instead of
		     failing with "no display binding". Also adds the Assemblies entry to File > Open's
		     filter list via the FileFilter path below. -->
		<DisplayBinding id = "Assembly"
		                class = "ICSharpCode.ILSpyAddIn.AssemblyDisplayBinding"
		                title = "ILSpy Assembly"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/FileFilter">
		<!-- Mirrors real ILSpy's own open dialog (ILSpy Commands/OpenCommand.cs). -->
		<FileFilter id         = "Assemblies"
		            name       = ".NET assemblies (*.dll;*.exe;*.winmd;*.wasm)"
		            extensions = "*.dll;*.exe;*.winmd;*.wasm"/>
		<FileFilter id         = "NuGetPackages"
		            name       = "NuGet Packages (*.nupkg)"
		            extensions = "*.nupkg"/>
		<FileFilter id         = "Pdb"
		            name       = "Portable Program Database (*.pdb)"
		            extensions = "*.pdb"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/ToolBar/ILSpy">
		<!-- Main-toolbar entry point for opening an assembly into the hosted ILSpy. Kept on the
		     main toolbar (not just File > Open > Assembly...) because this host's LibreWPF layer
		     cannot open nested menu popups - a top-level button is the reliable path. Lives on
		     its own strip so more ILSpy commands can join it later. -->
		<!-- Ordered to mirror real ILSpy's own toolbar (ILSpy/Controls/MainToolBar.xaml composes
		     [ExportToolbarCommand] categories in this order): Navigation, then Open, then View.
		     The Custom items are vector-icon buttons - see Commands/IlSpyToolBarButtons.cs for why
		     they can't be plain type="Item" entries with an icon= attribute. -->
		<ToolbarItem id = "BrowseBack"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyBrowseBackToolBarButton"/>
		<ToolbarItem id = "BrowseForward"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyBrowseForwardToolBarButton"/>
		<ToolbarItem id = "NavigationSeparator" type = "Separator"/>
		<ToolbarItem id = "OpenAssembly"
		             icon = "Assembly"
		             tooltip = "Open Assembly..."
		             class = "ICSharpCode.ILSpyAddIn.Commands.OpenAssemblyCommand"/>
		<ToolbarItem id = "Refresh"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyRefreshToolBarButton"/>
		<ToolbarItem id = "OpenSeparator" type = "Separator"/>
		<ToolbarItem id = "ShowSearch"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyShowSearchToolBarButton"/>
		<ToolbarItem id = "SortAssemblyList"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpySortAssemblyListToolBarButton"/>
		<ToolbarItem id = "CollapseAll"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyCollapseAllToolBarButton"/>
		<ToolbarItem id = "ApiVisibilitySeparator" type = "Separator"/>
		<!-- API-visibility radio group over LanguageSettings.ShowApiLevel, mirroring the three
		     CheckBoxes real ILSpy hardcodes in ILSpy/Controls/MainToolBar.xaml. -->
		<ToolbarItem id = "ShowPublicOnly"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyShowPublicOnlyToggle"/>
		<ToolbarItem id = "ShowPublicAndInternal"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyShowPublicAndInternalToggle"/>
		<ToolbarItem id = "ShowAll"
		             type = "Custom"
		             class = "ICSharpCode.ILSpyAddIn.Commands.IlSpyShowAllToggle"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/MainMenu/File/Open">
		<MenuItem id = "OpenAssembly"
		          label = "Assembly..."
		          insertafter = "Project"
		          class = "ICSharpCode.ILSpyAddIn.Commands.OpenAssemblyCommand"/>
	</Path>

	<Path name="/SharpDevelop/Autostart">
		<Class id="ICSharpCode.ILSpyAddIn.RegisterDevFlowActionsCommand"
		       class="ICSharpCode.ILSpyAddIn.Commands.RegisterDevFlowActionsCommand"/>
	</Path>

	<!-- doc/technotes/ilspy.md "Immediate next actions" #4 - registers the "ILSpy" named layout
	     as an AddIn-contributed template instead of a shell-hardcoded LayoutConfig.xml row. -->
	<Path name="/SharpDevelop/Workbench/LayoutTemplates">
		<Class id="IlSpyLayoutTemplateProvider"
		       class="ICSharpCode.ILSpyAddIn.IlSpyLayoutTemplateProvider"/>
	</Path>
</AddIn>
