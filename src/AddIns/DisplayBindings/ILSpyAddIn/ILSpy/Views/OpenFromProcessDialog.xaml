<Window x:Class="ICSharpCode.ILSpy.Views.OpenFromProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open from Running Process"
        Width="850" Height="560" MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Label x:Name="FilterLabel" />
            <TextBox x:Name="FilterBox" Width="200" Margin="6,0,0,0" />
            <Button x:Name="RefreshButton" Content="Refresh" Margin="12,0,0,0" MinWidth="72" />
        </StackPanel>

        <!-- Process list -->
        <ListView Grid.Row="1" x:Name="ProcessList" Margin="0,0,0,6"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="PID" Width="60"
                                    DisplayMemberBinding="{Binding Pid}" />
                    <GridViewColumn Header="Process" Width="180"
                                    DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Header="Runtime" Width="180"
                                    DisplayMemberBinding="{Binding Runtime}" />
                    <GridViewColumn Header="Architecture" Width="80"
                                    DisplayMemberBinding="{Binding Architecture}" />
                    <GridViewColumn Header="Entry Assembly" Width="180"
                                    DisplayMemberBinding="{Binding EntryAssembly}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Modules label -->
        <TextBlock Grid.Row="2" x:Name="ModulesLabel" Margin="0,0,0,6" TextWrapping="Wrap" />

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="3" x:Name="LoadingBar" Height="16" Margin="0,0,0,6"
                     IsIndeterminate="True" Visibility="Collapsed" />

        <!-- Module list -->
        <ListView Grid.Row="4" x:Name="ModuleList" Margin="0,0,0,6"
                  SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200"
                                    DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Location" Width="350"
                                    DisplayMemberBinding="{Binding Location}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Error message -->
        <TextBlock Grid.Row="5" x:Name="ErrorText" Margin="0,0,0,6"
                   Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- Visibility hint -->
        <TextBlock Grid.Row="6" x:Name="VisibilityHint" Margin="0,0,0,6"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   TextWrapping="Wrap" />

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddSelectedButton" Content="Add Selected" MinWidth="90" Margin="0,0,6,0" />
            <Button x:Name="AddEntryAssemblyButton" Content="Add Entry Assembly" MinWidth="120" Margin="0,0,6,0" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="72" />
        </StackPanel>
    </Grid>
</Window>
