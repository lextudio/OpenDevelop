<AddIn name="Stride Game Studio integration" author="LeXtudio" description="Hosts the Stride asset/scene editors inside OpenDevelop." addInManagerHidden="preinstalled">
  <Manifest><Identity name="ICSharpCode.StrideGameStudio" /></Manifest>
  <Runtime>
    <Import assembly="ICSharpCode.StrideGameStudio.dll" />
    <!-- Stride asset core, deployed next to this addin (Private references). Listed so the
         addin runtime probes this folder for them. -->
    <Import assembly="Stride.Core.dll" />
    <Import assembly="Stride.Core.Assets.dll" />
  </Runtime>
  <Path name="/SharpDevelop/Workbench/DisplayBindings">
    <!-- Primary: nothing else opens .sdpkg packages. Scene-asset bindings join in later slices. -->
    <DisplayBinding id="StrideGameStudioPackage" type="Primary" class="ICSharpCode.StrideGameStudio.StridePackageDisplayBinding" fileNamePattern="\.sdpkg$" />
    <!-- Scene assets open in the fused scene editor (single-session/overlay: whichever scene was
         opened last owns the one native overlay window). -->
    <DisplayBinding id="StrideGameStudioScene" type="Primary" class="ICSharpCode.StrideGameStudio.StrideSceneAssetDisplayBinding" fileNamePattern="\.sdscene$" />
    <!-- Prefab assets open in the fused prefab editor (reuses the scene editor viewport with a
         PrefabEditorViewModel factory). -->
    <DisplayBinding id="StrideGameStudioPrefab" type="Primary" class="ICSharpCode.StrideGameStudio.StridePrefabDisplayBinding" fileNamePattern="\.sprefab$" />
  </Path>
  <Path name="/SharpDevelop/Workbench/AutostartAfterWorkbenchInitialized">
    <Class id="ICSharpCode.StrideGameStudio.RegisterStrideProjectTreeContributorCommand"
           class="ICSharpCode.StrideGameStudio.RegisterStrideProjectTreeContributorCommand"/>
  </Path>
</AddIn>
