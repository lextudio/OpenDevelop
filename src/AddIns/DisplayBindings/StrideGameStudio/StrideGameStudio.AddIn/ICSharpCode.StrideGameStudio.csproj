<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.StrideGameStudio</RootNamespace>
    <AssemblyName>ICSharpCode.StrideGameStudio</AssemblyName>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <OutputPath>..\..\..\..\..\AddIns\DisplayBindings\StrideGameStudio\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Override point: where the local stride port clone lives. -->
    <StrideCheckoutRoot Condition="'$(StrideCheckoutRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\..\stride\</StrideCheckoutRoot>
  </PropertyGroup>
  <!-- OpenDevelopTrimAddinOutput (OpenDevelop.Addin.Sdk/Sdk/Sdk.targets) deletes any DLL from this
       addin's output whose filename also exists in the host app's own bin folder, assuming the
       host's copy is a safe substitute. That assumption breaks for NuGet.ProjectModel: the host
       app also ships a copy (for AddInManager2's own NuGet usage), but at a different version
       (7.6.0.0) than Stride's PackageSession.Dependencies needs (a strict strong-named load of
       exactly 7.3.1.0, confirmed via a FileNotFoundException naming that exact version) - so the
       host's copy is NOT interchangeable here. OpenDevelopAlwaysCopy is the Sdk's own escape
       hatch (matched by %(Filename), see the trim target) for exactly this situation. -->
  <ItemGroup>
    <OpenDevelopAlwaysCopy Include="NuGet.ProjectModel.dll" />
    <!-- Same version mismatch as NuGet.ProjectModel above: the host ships its own AvalonDock
         (for OpenDevelop's own docking UI) at a different version than Stride.GameStudio's
         AvalonDock 4.72.1.0, which Stride.Core.Assets.Editor's own WPF views need at that exact
         strong name. Confirmed via a live FileNotFoundException naming that exact version once
         the NuGet.ProjectModel fix let session loading get this far. -->
    <OpenDevelopAlwaysCopy Include="AvalonDock.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <!-- For the [DevFlowAction] diagnostics in StrideGameStudioDevFlowActions. Private=false: the
         host already loads this assembly (it runs the agent), and a second copy in the addin folder
         would be a different instance of the same attribute types, so discovery would not match. -->
    <Reference Include="LeXtudio.DevFlow.Agent.Core">
      <HintPath>..\..\..\..\Main\SharpDevelop\bin\$(Configuration)\net10.0-windows\LeXtudio.DevFlow.Agent.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Exposes $(StrideCheckoutRoot) to runtime code as STRIDE_SOURCE_ROOT (see
       StrideEditorHost.cs's static constructor and StrideDefaultTemplates.Load's fork patch) -
       StrideDefaultTemplates.Load needs the source-tree location of Stride.Assets.Presentation/
       Stride.SpriteStudio.Offline's .sdpkg files, since this addin consumes Stride via raw file
       references rather than a NuGet-restored install that PackageStore could otherwise find. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StrideCheckoutRoot</_Parameter1>
      <_Parameter2>$(StrideCheckoutRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Stride editor assemblies from the local port clone (see
       doc/technotes/stride-game-studio.md). Deliberately MINIMAL for the fusion skeleton:
       only the asset core travels with the addin; scene-editor hosting layers join in later
       slices. Private=true so they deploy next to this addin's dll. -->
  <ItemGroup>
    <Reference Include="Stride.Core">
      <HintPath>$(StrideCheckoutRoot)sources\core\Stride.Core\bin\Debug\net10.0\Stride.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Stride.Core.Assets">
      <HintPath>$(StrideCheckoutRoot)sources\assets\Stride.Core.Assets\bin\Debug\net10.0\Stride.Core.Assets.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- PackageVersion/UFile (touched by Meta.Version and AssetItem.Location) live here. -->
    <Reference Include="Stride.Core.Design">
      <HintPath>$(StrideCheckoutRoot)sources\assets\Stride.Core.Assets\bin\Debug\net10.0\Stride.Core.Design.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Transitive NuGet deps of the Stride asset core that MSBuild's reference resolution
         does NOT copy (they are not project outputs). Stride.Core.Assets' module initializer
         binds ServiceWire at first touch - missing it killed the view with a
         TypeInitializationException on open. Keep in lock-step with stride's packages. -->
    <Reference Include="ServiceWire">
      <HintPath>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)servicewire/5.6.0/lib/netstandard2.0/ServiceWire.dll'))</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- Engine closure for the LIVE viewport (fusion milestone 2). The headless Game renders a
       frame every tick; the presenter shows it. Private=true so they deploy next to this addin. -->
  <ItemGroup>
    <Reference Include="Stride.Engine"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Engine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Games"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Games.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Graphics"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Graphics.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Input"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Input.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Rendering"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Rendering.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Shaders"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Shaders.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Shaders.Effects"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Shaders.Effects.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Shaders.Compilers"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Shaders.Compilers.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Shaders.Parsers"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Shaders.Parsers.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Shaders.Spirv"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Shaders.Spirv.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Core"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Core.IO"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Core.IO.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Core.Mathematics"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Core.Mathematics.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Core.MicroThreading"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Core.MicroThreading.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Core.Serialization"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Core.Serialization.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Foundation"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Foundation.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.Audio"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.Audio.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Stride.VirtualReality"><HintPath>$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\Stride.VirtualReality.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Vortice.Vulkan"><HintPath>$(HOME)/.nuget/packages/vortice.vulkan/3.0.3/lib/net9.0/Vortice.Vulkan.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Silk.NET.Core"><HintPath>$(HOME)/.nuget/packages/silk.net.core/2.23.0/lib/netstandard2.0/Silk.NET.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SixLabors.ImageSharp"><HintPath>$(HOME)/.nuget/packages/sixlabors.imagesharp/3.1.12/lib/net6.0/SixLabors.ImageSharp.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <!-- Windowed viewport (supersedes the headless+readback route, see
       doc/technotes/stride-game-studio.md "G4 viewport stability/perf investigation" and
       "Composition-bridge probes"): GameContextSDL needs Silk.NET.SDL for SDL_GetWindowWMInfo,
       and the LibreWPF-side Cocoa NSWindow is obtained via LibreWPF.ProGPU's public diagnostics
       entry point (ProGpuWpfDiagnostics.TryGetWindowHost) + Silk.NET.Windowing's own
       INativeWindow.Cocoa. -->
  <ItemGroup>
    <Reference Include="Silk.NET.SDL"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Silk.NET.SDL.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Silk.NET.Windowing.Common"><HintPath>$(HOME)/.nuget/packages/silk.net.windowing.common/2.23.0/lib/netstandard2.1/Silk.NET.Windowing.Common.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="ProGPU.Wpf"><HintPath>$(HOME)/.nuget/packages/librewpf.progpu/0.1.0-preview.45/lib/net10.0/ProGPU.Wpf.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <!-- Real-content integration (doc/technotes/stride-game-studio.md "Real-content integration
       plan"): SessionViewModel/EditorViewModel/AssetsPlugin/PluginService/StrideEditorPlugin, all
       reused as-is from Stride.GameStudio's own editor stack. These references are compile-time
       only (Private=false) - the ~50-assembly transitive closure (asset compiler, shader
       compiler, WPF transport, ...) is copied wholesale by CopyGameStudioEditorClosure below,
       the same "copy the whole bin folder next to ours" approach already proven for the engine
       closure, rather than hand-listing every transitive dependency. -->
  <ItemGroup>
    <Reference Include="Stride.Core.Assets.Editor"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.Core.Assets.Editor.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stride.Assets.Presentation"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.Assets.Presentation.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stride.GameStudio"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.GameStudio.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stride.Editor"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.Editor.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stride.Core.Presentation"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.Core.Presentation.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stride.Core.Presentation.Wpf"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.Core.Presentation.Wpf.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stride.Core.Translation"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.Core.Translation.dll</HintPath><Private>false</Private></Reference>
    <!-- SceneAsset (real entity/transform data for gap 2's viewport rendering) lives here. -->
    <Reference Include="Stride.Assets"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.Assets.dll</HintPath><Private>false</Private></Reference>
    <!-- PackageSession.UpdateDependencies (opening a session whose package has a referenced
         .csproj) touches NuGet.ProjectModel's LockFileFormat directly - not one of our own
         <Reference> items, so it was never a real SDK-recognized reference. Wildcard-copying it
         via CopyGameStudioEditorClosure alone didn't stick: the SDK's own incremental-clean step
         deleted it on every subsequent build as an "unrecognized" file (confirmed via `-v:normal`
         showing "Copying file... NuGet.ProjectModel.dll" immediately followed by "Deleting file
         ...NuGet.ProjectModel.dll" in the same build). Making it a real Reference puts it through
         the SDK's own copy-local pipeline instead, which the incremental-clean step DOES track. -->
    <Reference Include="NuGet.ProjectModel"><HintPath>$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\NuGet.ProjectModel.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="CopyStrideRuntimes" AfterTargets="Build">
    <ItemGroup>
      <StrideRt Include="$(StrideCheckoutRoot)sources\engine\Stride.Engine\bin\Debug\net10.0\runtimes\**\*" />
      <!-- Stride.GameStudio targets net10.0-windows, so its own NuGet runtime-asset selection
           only pulls Windows-flavored "runtimes/*/native" folders (e.g. libbulletc.dll) even with
           RuntimeIdentifier unset on macOS - the osx-arm64 native asset only shows up in plain
           net10.0 (non-Windows-targeted) projects that consume the same native package, such as
           Stride.Physics's own bin output. Pull those in too so bulletc etc. resolve on macOS. -->
      <StrideRt Include="$(StrideCheckoutRoot)sources\engine\Stride.Physics\bin\Debug\net10.0\runtimes\**\*" />
      <!-- Same TFM issue again for FFmpeg (avutil/avcodec/...) and every other native dep
           Stride.Assets.Presentation itself pulls in - its own (non-Windows-targeted-adjacent,
           but still net10.0-windows) bin folder DOES carry the full osx-arm64 native set though,
           since it builds directly against those NuGet packages. Superset of what's needed here
           (bulletc/freetype/etc. duplicate the sources above; SkipUnchangedFiles makes that free). -->
      <StrideRt Include="$(StrideCheckoutRoot)sources\editor\Stride.Assets.Presentation\bin\Debug\net10.0-windows\runtimes\**\*" />
      <!-- ...and Stride.EffectCompilerServer's, which is a further superset: it is the only one
           carrying libstride_spirv_tools. Without it SpirvTools' static ctor throws on first shader
           compilation, EditorServiceGame catches that into Faulted, and from then on Update returns
           immediately - so every GameSystem stops (scene stays on screen, frame counter keeps
           climbing, no editor service ever runs again). -->
      <StrideRt Include="$(StrideCheckoutRoot)sources\tools\Stride.EffectCompilerServer\bin\Debug\net10.0-windows\runtimes\**\*" />
      <!-- Native SDL2 isn't part of Stride's own runtimes output (it's a separate NuGet
           package); GameContextSDL needs it at load time (see stride-game-studio.md's SDL
           probes - Silk.NET.SDL.GetApi() fails without it on the load path). -->
      <NativeSdl Include="$(HOME)/.nuget/packages/ultz.native.sdl/2.32.10/runtimes/osx/native/libSDL2-2.0.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(StrideRt)" DestinationFiles="@(StrideRt->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- NativeLibraryHelper.TryFindLibraryPath's first (and most specific) probe is
         Path.Combine(ownerAssemblyDir, "runtimes", "<rid>", "native") - and Stride.Video.dll
         (FFmpegUtils's owner type) lives in the "Vulkan/" per-graphics-API subfolder, not this
         addin's own root, so it needs its own copy of the runtimes tree placed there too. -->
    <Copy SourceFiles="@(StrideRt)" DestinationFiles="@(StrideRt->'$(OutputPath)Vulkan\runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeSdl)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <!-- Silk.NET.SDL's DefaultPathResolver.BaseDirectoryResolver only ever probes
         AppContext.BaseDirectory (the MAIN app's own output folder, not this addin's output
         folder) for a bare library name like "libSDL2-2.0.dylib" - confirmed via a standalone
         probe against the decompiled resolver chain (DefaultPathResolver/PassthroughResolver
         only try the OS's default dlopen search, which needs DYLD_LIBRARY_PATH - stripped by
         macOS SIP, see StrideEditorHost.cs). So the dylib must ALSO land next to OpenDevelop's
         own executable, not just next to this addin's assembly. -->
    <Copy SourceFiles="@(NativeSdl)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\..\Main\SharpDevelop\bin\$(Configuration)\net10.0-windows\" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\Main\SharpDevelop\bin\$(Configuration)\net10.0-windows\')" />
    <!-- Same "bare-name native loaders only probe the MAIN app's own output folder" pattern as
         SDL2 above, applied to Vortice.Vulkan's loader for libvulkan.1.dylib (which fronts
         MoltenVK here) - "Failed to load Vulkan Portability library" when only the addin folder
         had a copy. Not yet 100% confirmed same root cause as SDL2 (Vortice uses its own loader,
         not Silk.NET's), but costs nothing to also place it next to the main app's exe. -->
    <ItemGroup>
      <NativeVulkan Include="$(OutputPath)runtimes\osx-arm64\native\libvulkan.1.dylib" Condition="Exists('$(OutputPath)runtimes\osx-arm64\native\libvulkan.1.dylib')" />
      <NativeVulkan Include="$(OutputPath)runtimes\osx-arm64\native\MoltenVK_icd.json" Condition="Exists('$(OutputPath)runtimes\osx-arm64\native\MoltenVK_icd.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeVulkan)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\..\Main\SharpDevelop\bin\$(Configuration)\net10.0-windows\" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\Main\SharpDevelop\bin\$(Configuration)\net10.0-windows\')" />
  </Target>
  <!-- Wholesale copy of Stride.GameStudio's own bin output: this is a plain net10.0-windows IL
       folder (AppendRuntimeIdentifierToOutputPath=false), so copying it next to this addin's own
       dll and letting the OpenDevelop host process (already past its own framework-startup gate)
       resolve everything via simple sibling-file probing works, same mechanism already used for
       every other Stride.* reference in this project - see the technote's RID-mismatch finding
       for why this simple-copy approach avoids the cross-RID deps.json issues a *separate*,
       independently-restored process hit when reusing Stride.GameStudio.dll as a live dependency. -->
  <Target Name="CopyGameStudioEditorClosure" AfterTargets="Build">
    <ItemGroup>
      <GameStudioFiles Include="$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\**\*" Exclude="$(StrideCheckoutRoot)sources\editor\Stride.GameStudio\bin\Debug\net10.0-windows\Stride.GameStudio.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(GameStudioFiles)" DestinationFiles="@(GameStudioFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><None Include="ICSharpCode.StrideGameStudio.addin" /></ItemGroup>
</Project>
