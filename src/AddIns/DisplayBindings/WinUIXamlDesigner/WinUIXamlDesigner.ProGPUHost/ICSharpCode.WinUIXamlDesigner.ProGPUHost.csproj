<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <!-- The sources annotate nullability with '?' throughout; the annotation context must be
         enabled for those annotations to be legal, without turning the warning context on for
         legacy files that were never audited. -->
    <Nullable>annotations</Nullable>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcessDependency</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ICSharpCode.WinUIXamlDesigner.ProGPUHost</AssemblyName>
    <RootNamespace>ICSharpCode.WinUIXamlDesigner.ProGPUHost</RootNamespace>
    <OutputPath>..\..\..\..\..\AddIns\DisplayBindings\WinUIXamlDesigner\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\DesignerCanvas\ICSharpCode.DesignerCanvas.csproj" Private="false" />
    <ProjectReference Include="..\WinUIXamlDesigner.AddIn\ICSharpCode.WinUIXamlDesigner.csproj" Private="false" />
    <ProjectReference Include="..\XamlStudio.Toolkit.ProGPU\XamlStudio.Toolkit.ProGPU.csproj" />
    <!-- Same App.xaml -> self-contained dictionary engine the out-of-process hosts use. -->
    <Compile Include="..\WinUIXamlDesigner.UnoDesignHost\AppResourceBuilder.cs" Link="AppResourceBuilder.cs" />
    <PackageReference Include="ProGPU.WinUI" />
    <!-- Packed locally from the same wieslawsoltes/ProGPU commit that produced the published
         preview.47 feed (bab4dbef); upstream marks these packable but never published them. -->
    <PackageReference Include="ProGPU.WinUI.Designer" />
    <PackageReference Include="ProGPU.Xaml" />
    <PackageReference Include="ProGPU.Xaml.Roslyn" />
    <PackageReference Include="ProGPU.Xaml.Workspaces" />
    <!-- Standard controls (Button, TextBlock, ...) resolve their default style via
         FrameworkElement.TryFindResource, which only ever finds one if a Fluent theme
         dictionary has been merged somewhere in the visual tree or into Application.Resources -
         ProGPU.WinUI ships no built-in fallback. Without this, every previewed control renders
         with no template/brush at all, which is indistinguishable from "nothing rendered": the
         page's own (default white) background is all that's visible. -->
    <PackageReference Include="ProGPU.WinUI.Themes.Fluent" />
  </ItemGroup>
  <!-- ICSharpCode.Designer.Presentation.dll comes from the ICSharpCode.DesignerCanvas addin (see
       WinUIXamlDesigner.addin). Private="false" stops only the direct reference; a transitive one
       still copies it here, and a second copy gives the canvas's types two identities. -->
  <Target Name="DropPrivateDesignerPresentationCopy" AfterTargets="Build">
    <Delete Files="$(OutDir)ICSharpCode.Designer.Presentation.dll;$(OutDir)ICSharpCode.Designer.Presentation.pdb" />
  </Target>
</Project>
