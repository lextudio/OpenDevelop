<Project Sdk="Microsoft.NET.Sdk">
  <!-- Microsoft-side build of the WinUI design client. Source-links the same UnoDesignClient; the
       ONLY difference from WinUIXamlDesigner.UnoDesignHost.Remote is that it drops that project's
       build-only ProjectReference to the Uno host binary, which would pull Uno.Sdk into a run whose
       whole point is that the Microsoft adaptation stands alone. The Microsoft test project
       references the Microsoft host instead. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WinUIXamlDesigner.MicrosoftHost.Remote</AssemblyName>
    <RootNamespace>ICSharpCode.WinUIXamlDesigner.UnoDesignHost</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\WinUIXamlDesigner.UnoDesignHost\UnoDesignClient.cs" Link="UnoDesignClient.cs" />
    <PackageReference Include="StreamJsonRpc" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
  </ItemGroup>
</Project>
