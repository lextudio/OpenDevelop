<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds and deploys the Uno profile of Microsoft's XAML language server. It is a separate
       process deployment from Microsoft WinUI, so the profiles cannot mix metadata. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>uno-xaml-ls</AssemblyName>
    <RootNamespace>ICSharpCode.WinUIXamlDesigner.LanguageServer.Uno</RootNamespace>
    <LanguageServerDeployDir>$(MSBuildProjectDirectory)\..\..\..\..\..\AddIns\LanguageServices\UnoXamlLanguageServer</LanguageServerDeployDir>
    <!-- Started by path as a managed dll (dotnet exec), never through an apphost. -->
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>OutOfProcessHost</OpenDevelopAddinKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\externals\winappvsce\server\src\WinUiXaml.LanguageServer\WinUiXaml.LanguageServer.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>
  <!-- Deploy the upstream server and its generator host under the Uno-owned location. -->
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup>
      <LanguageServerOutput Include="$(MSBuildThisFileDirectory)..\..\..\..\..\externals\winappvsce\server\src\WinUiXaml.LanguageServer\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Error Condition="'@(LanguageServerOutput)' == ''" Text="The WinAppVSCE language-server output is missing; build its project before deploying the Uno server." />
    <RemoveDir Directories="$(LanguageServerDeployDir)" />
    <Copy SourceFiles="@(LanguageServerOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(LanguageServerOutput->'$(LanguageServerDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
