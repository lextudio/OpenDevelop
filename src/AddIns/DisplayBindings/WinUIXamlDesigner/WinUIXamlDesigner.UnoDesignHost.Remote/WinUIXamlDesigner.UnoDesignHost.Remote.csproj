<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WinUIXamlDesigner.UnoDesignHost.Remote</AssemblyName>
    <RootNamespace>ICSharpCode.WinUIXamlDesigner.UnoDesignHost</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <!-- The linked client also builds outside the IDE for host-RPC tests. -->
    <DefineConstants>$(DefineConstants);DESIGNER_STANDALONE_CLIENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\WinUIXamlDesigner.UnoDesignHost\UnoDesignClient.cs" Link="UnoDesignClient.cs" />
    <PackageReference Include="StreamJsonRpc" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
    <ProjectReference Include="..\WinUIXamlDesigner.UnoHost\WinUIXamlDesigner.UnoHost.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc pulls MessagePack transitively; reference it directly so NuGet unifies on the
         centrally pinned release instead of resolving the vulnerable 2.5.x (NU1902/NU1903). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
