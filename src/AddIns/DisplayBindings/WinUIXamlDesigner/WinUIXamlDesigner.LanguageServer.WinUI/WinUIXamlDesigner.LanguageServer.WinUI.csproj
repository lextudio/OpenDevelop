<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds and deploys Microsoft's WinUI XAML language server for Microsoft WinUI projects.
       The upstream server is managed here (rather than its Windows-only Native AOT VS Code
       payload), so OpenDevelop can retain its cross-platform dotnet-exec LSP host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>winui-xaml-ls</AssemblyName>
    <RootNamespace>ICSharpCode.WinUIXamlDesigner.LanguageServer.WinUI</RootNamespace>
    <LanguageServerDeployDir>$(MSBuildProjectDirectory)\..\..\..\..\..\AddIns\LanguageServices\WinUIXamlLanguageServer</LanguageServerDeployDir>
    <!-- Started by path as a managed dll (dotnet exec), never through an apphost. -->
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>OutOfProcessHost</OpenDevelopAddinKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\externals\winappvsce\server\src\WinUiXaml.LanguageServer\WinUiXaml.LanguageServer.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>
  <!-- The upstream project copies its generator host beside its build output. Deploy that complete
       runnable directory under the addin-owned location. -->
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup>
      <LanguageServerOutput Include="$(MSBuildThisFileDirectory)..\..\..\..\..\externals\winappvsce\server\src\WinUiXaml.LanguageServer\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Error Condition="'@(LanguageServerOutput)' == ''" Text="The WinAppVSCE language-server output is missing; build its project before deploying the WinUI server." />
    <RemoveDir Directories="$(LanguageServerDeployDir)" />
    <Copy SourceFiles="@(LanguageServerOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(LanguageServerOutput->'$(LanguageServerDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
