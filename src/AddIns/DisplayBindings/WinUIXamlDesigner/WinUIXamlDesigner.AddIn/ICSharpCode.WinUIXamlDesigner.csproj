<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.WinUIXamlDesigner</RootNamespace>
    <AssemblyName>ICSharpCode.WinUIXamlDesigner</AssemblyName>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <OutputPath>..\..\..\..\..\AddIns\DisplayBindings\WinUIXamlDesigner\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\DesignerCanvas\ICSharpCode.DesignerCanvas.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Presentation\Designer.Presentation.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" Private="false" />
    <!-- This addin's XAML language servers (registered by RegisterXamlLanguageServersCommand):
         built, and deployed by their own DeployToAddIns, whenever the addin is. Not referenced -
         they are separate processes. -->
    <ProjectReference Include="..\WinUIXamlDesigner.LanguageServer.WinUI\WinUIXamlDesigner.LanguageServer.WinUI.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <ProjectReference Include="..\WinUIXamlDesigner.LanguageServer.Uno\WinUIXamlDesigner.LanguageServer.Uno.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <ProjectReference Include="..\WinUIXamlDesigner.LanguageServer.ProGpu\WinUIXamlDesigner.LanguageServer.ProGpu.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <!-- The Hot Reload agent (and, on Windows, its native TAPs) this addin's
         WinUIApplicationHotReloadAdapter injects: built with the addin and deployed into its
         HotReload/winui/ by the agent's own DeployAgentToAddIn. Never referenced - it runs inside
         the debuggee, not the IDE. -->
    <ProjectReference Include="..\..\..\..\Main\HotReload\WinUIHotReload.Agent\WinUIHotReload.Agent.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
	<ProjectReference Include="..\..\..\..\Main\Designer\Designer.Shell\Designer.Shell.csproj" Private="false" />
    <!-- IPropertyGridEventSource / the shared Properties pad's Xceed grid (IPropertyGridEventSource). -->
    <ProjectReference Include="..\..\..\..\..\externals\wpftoolkit\ExtendedWPFToolkitSolution\Src\Xceed.Wpf.Toolkit\Xceed.Wpf.Toolkit.csproj" Private="false" />
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup><None Include="WinUIXamlDesigner.addin" /></ItemGroup>
  <!-- ICSharpCode.Designer.Presentation.dll comes from the ICSharpCode.DesignerCanvas addin (see
       WinUIXamlDesigner.addin). Private="false" stops only the direct reference; a transitive one
       still copies it here, and a second copy gives the canvas's types two identities. -->
  <Target Name="DropPrivateDesignerPresentationCopy" AfterTargets="Build">
    <Delete Files="$(OutDir)ICSharpCode.Designer.Presentation.dll;$(OutDir)ICSharpCode.Designer.Presentation.pdb" />
  </Target>
</Project>
