<AddIn name="WinUI and Uno XAML Designer" author="LeXtudio" description="Visual designer for WinUI 3 and Uno Platform XAML." addInManagerHidden="preinstalled">
  <Manifest>
    <Identity name="ICSharpCode.WinUIXamlDesigner" />
    <!-- The shared design canvas (DesignSurface, DesignSurfaceController); see
         doc/technotes/designer-canvas-addin.md. -->
    <Dependency addin="ICSharpCode.DesignerCanvas" requirePreload="true" />
  </Manifest>
  <Runtime>
    <Import assembly="$ICSharpCode.DesignerCanvas/ICSharpCode.DesignerCanvas.dll" />
    <Import assembly=":ICSharpCode.Designer.Presentation" />
    <Import assembly="ICSharpCode.WinUIXamlDesigner.dll" />
    <Import assembly="ICSharpCode.WinUIXamlDesigner.ProGPUHost.dll" />
    <Import assembly="ICSharpCode.WinUIXamlDesigner.UnoDesignHost.dll" />
  </Runtime>
  <Path name="/SharpDevelop/Workbench/DisplayBindings">
    <DisplayBinding id="WinUIXamlDesigner" type="Secondary" class="ICSharpCode.WinUIXamlDesigner.WinUIXamlDesignerDisplayBinding" fileNamePattern="\.xaml$" />
  </Path>
  <Path name="/SharpDevelop/Autostart">
    <Class id="ICSharpCode.WinUIXamlDesigner.RegisterDevFlowActionsCommand" class="ICSharpCode.WinUIXamlDesigner.RegisterDevFlowActionsCommand" />
    <Class id="ICSharpCode.WinUIXamlDesigner.RegisterXamlLanguageServersCommand" class="ICSharpCode.WinUIXamlDesigner.RegisterXamlLanguageServersCommand" />
  </Path>
</AddIn>
