<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <!-- The sources annotate nullability with '?' throughout; the annotation context must be
         enabled for those annotations to be legal, without turning the warning context on for
         legacy files that were never audited. -->
    <Nullable>annotations</Nullable>
    <!-- The desktop head is always built. The iOS head needs the iOS workload and Xcode, which not every
         machine (or CI lane) has, so it is opt-in: -p:UnoDesignHostMobile=true. -->
    <UnoDesignHostMobile Condition="'$(UnoDesignHostMobile)' == ''">false</UnoDesignHostMobile>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(UnoDesignHostMobile)' == 'true'">net10.0-desktop;net10.0-ios;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <!-- Every head renders with Skia. Uno 7 drops the native iOS/Android renderers (its package has no
         net10.0-ios/-android flavour), so the mobile heads are Skia from the start: Uno.UI.dll becomes the Skia
         flavour, whose Application is not a UIApplicationDelegate, so the iOS entry point goes through
         UnoPlatformHostBuilder.UseAppleUIKit() instead of UIApplication.Main(typeof(App)). -->
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <RootNamespace>ICSharpCode.WinUIXamlDesigner.UnoHost</RootNamespace>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>OutOfProcessHost</OpenDevelopAddinKind>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <!-- A device head is one RID-specific app (simulator / emulator ABI), deployed as a bundle or APK rather than
         loaded into the IDE, so the AnyCPU AddIn rule of a distribution build does not apply to it. -->
    <OpenDevelopAllowRidSpecificAddin>true</OpenDevelopAllowRidSpecificAddin>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.lextudio.opendevelop.unodesignhost</ApplicationId>
    <ValidateXcodeVersion Condition="'$(ValidateXcodeVersion)' == ''">false</ValidateXcodeVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!-- A device head is one RID-specific app (simulator / emulator ABI), deployed as a bundle or APK rather than
         loaded into the IDE, so the AnyCPU AddIn rule of a distribution build does not apply to it. -->
    <OpenDevelopAllowRidSpecificAddin>true</OpenDevelopAllowRidSpecificAddin>
    <ApplicationId>com.lextudio.opendevelop.unodesignhost</ApplicationId>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- One ABI, the one this machine's emulators run: the all-ABI debug APK is ~130 MB, which takes minutes to
         adb install into a small AVD. An x64 machine runs x86_64 emulators. -->
    <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">android-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' != 'Arm64'">android-x64</RuntimeIdentifier>
    <!-- A plain "adb install" cannot satisfy Fast Deployment, so the assemblies travel inside the APK. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <!-- Both mobile heads share one application definition (Fluent control resources), like the desktop head does in code. -->
  <ItemGroup>
    <!-- Unconditional: the desktop head must not compile the mobile application definition either (the SDK globs *.xaml into Page). -->
    <Page Remove="Platforms/Mobile/App.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios' Or '$(TargetFramework)' == 'net10.0-android'">
    <ApplicationDefinition Include="Platforms/Mobile/App.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <InterfaceDefinition Include="Platforms/iOS/LaunchScreen.storyboard" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
	<ProjectReference Include="..\..\..\..\Main\Designer\Designer.Server\Designer.Server.csproj" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
  <!-- Deploy the whole runnable child (dll + deps + runtimeconfig + native libs) into the addin's
       own folder, next to ICSharpCode.WinUIXamlDesigner.dll, so the WPF side can find and spawn
       it from the deployed AddIns tree exactly like it does at dev time. -->
  <Target Name="DeployToAddIns" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <ItemGroup>
      <HostOutput Include="$(TargetDir)**" />
    </ItemGroup>
    <!-- Same reason as the Microsoft host: resolve the ".." segments before the Copy task sees
         the path, or a deep CI checkout trips the Windows path-length limit (MSB3021). -->
    <PropertyGroup>
      <_HostDeployRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\..\..\AddIns\DisplayBindings\WinUIXamlDesigner\UnoHost'))</_HostDeployRoot>
    </PropertyGroup>
    <Copy SourceFiles="@(HostOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(HostOutput->'$(_HostDeployRoot)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- The iOS head ships as an app bundle beside the desktop head ("UnoHost.iOS"), where the designer finds it and installs
       it into a simulator on demand. A bundle is a directory tree with symlinks, so it is copied with cp -R, not MSBuild's Copy. -->
  <Target Name="DeployIosHostToAddIns" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0-ios' And $([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <_IosDeployRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../../../AddIns/DisplayBindings/WinUIXamlDesigner/UnoHost.iOS'))</_IosDeployRoot>
    </PropertyGroup>
    <Exec Command="rm -rf &quot;$(_IosDeployRoot)&quot; &amp;&amp; mkdir -p &quot;$(_IosDeployRoot)&quot; &amp;&amp; cp -R &quot;$(OutDir)$(AssemblyName).app&quot; &quot;$(_IosDeployRoot)/&quot;" />
  </Target>

  <!-- The Android head ships as an APK beside the desktop head ("UnoHost.Android"); the designer adb-installs it into the emulator. -->
  <Target Name="DeployAndroidHostToAddIns" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PropertyGroup>
      <_AndroidDeployRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../../../AddIns/DisplayBindings/WinUIXamlDesigner/UnoHost.Android'))</_AndroidDeployRoot>
    </PropertyGroup>
    <MakeDir Directories="$(_AndroidDeployRoot)" />
    <Copy SourceFiles="$(OutDir)$(ApplicationId)-Signed.apk" DestinationFiles="$(_AndroidDeployRoot)/WinUIXamlDesigner.UnoHost.apk" />
  </Target>

  <ItemGroup>
    <!-- StreamJsonRpc pulls MessagePack transitively; reference it directly so NuGet unifies on the
         centrally pinned release instead of resolving the vulnerable 2.5.x (NU1902/NU1903). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
