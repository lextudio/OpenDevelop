<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <!-- The sources annotate nullability with '?' throughout; the annotation context must be
         enabled for those annotations to be legal, without turning the warning context on for
         legacy files that were never audited. -->
    <Nullable>annotations</Nullable>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ICSharpCode.MewUIDesigner</AssemblyName>
    <RootNamespace>ICSharpCode.MewUIDesigner</RootNamespace>
    <OutputPath>..\..\..\..\AddIns\DisplayBindings\MewUIDesigner\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\MewUIXaml.xshd" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MewUIDocumentEditor.cs" />
    <ProjectReference Include="..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.SharpDevelop.Widgets\Project\ICSharpCode.SharpDevelop.Widgets.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" Private="false" />
	  <ProjectReference Include="..\..\..\Main\Designer\Designer.Shell\Designer.Shell.csproj" Private="false" />
    <!-- The shared design canvas and its Presentation assembly come from the ICSharpCode.DesignerCanvas
         addin (see MewUIDesigner.addin), never a private copy. -->
    <ProjectReference Include="..\DesignerCanvas\ICSharpCode.DesignerCanvas.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\Designer\Designer.Presentation\Designer.Presentation.csproj" Private="false" />
    <ProjectReference Include="..\MewUIDesigner.Host\MewUIDesigner.Host.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" />
  </ItemGroup>
  <ItemGroup><None Include="MewUIDesigner.addin" /></ItemGroup>
  <Target Name="DropPrivateDesignerPresentationCopy" AfterTargets="Build">
    <Delete Files="$(OutDir)ICSharpCode.Designer.Presentation.dll;$(OutDir)ICSharpCode.Designer.Presentation.pdb" />
  </Target>
</Project>
