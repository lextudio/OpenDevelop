<Project Sdk="Microsoft.NET.Sdk">
  <!-- Microsoft-side build of the FormsDesigner.Remote client. Source-links the same client; the
       ONLY difference from the original project is that it drops that project's build-only
       ProjectReference to the LibreWinForms host binary, which would otherwise pull LibreWinForms
       into a run whose whole point is that the Microsoft adaptation stands alone. The Microsoft
       test project references the Microsoft host instead. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MicrosoftFormsDesigner.Remote</AssemblyName>
    <RootNamespace>ICSharpCode.FormsDesigner.OutOfProcess</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same single source file the original FormsDesigner.Remote project compiles; it lives in
         the FormsDesigner project tree, not in Remote/. -->
    <Compile Include="..\..\Project\Src\OutOfProcess\FormsDesignerHostClient.cs" Link="FormsDesignerHostClient.cs" />
    <PackageReference Include="StreamJsonRpc" />
    <ProjectReference Include="..\..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
  </ItemGroup>
</Project>
