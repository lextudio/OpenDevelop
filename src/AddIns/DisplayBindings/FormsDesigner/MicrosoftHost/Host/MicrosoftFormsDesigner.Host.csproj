<Project Sdk="Microsoft.NET.Sdk">
  <!-- Microsoft-WindowsDesktop build of the out-of-process WinForms designer host.

       Each project under MicrosoftHost/ gets its OWN directory (Host/, Remote/, Host.Tests/):
       with this project at the MicrosoftHost/ root, its default **/*.cs glob would reach into the
       sibling projects' directories and compile their sources and obj/ generated files
       (CS0101/CS0579 on GitVersionInformation and the assembly attributes). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MicrosoftFormsDesigner.Host</AssemblyName>
    <RootNamespace>ICSharpCode.FormsDesigner.MicrosoftHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Opt out of src/Directory.Build.targets' LibreWinForms substitution. -->
    <UseMicrosoftDesktopRuntime>true</UseMicrosoftDesktopRuntime>
    <DefineConstants>$(DefineConstants);MICROSOFT_WINFORMS</DefineConstants>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>OutOfProcessHost</OpenDevelopAddinKind>
  </PropertyGroup>
  <ItemGroup>
    <!-- The protocol/model implementation is runtime-neutral. These source links deliberately
         compile it against Microsoft WindowsDesktop rather than reference LibreWinForms. -->
    <Compile Include="..\..\Host\Program.cs" Link="Program.cs" />
    <Compile Include="..\..\Host\MultiDocumentDesignerHostService.cs" Link="MultiDocumentDesignerHostService.cs" />
    <Compile Include="..\..\Host\DesignerHostService.cs" Link="DesignerHostService.cs" />
    <Compile Include="..\..\Host\SnapshotDesignerLoader.cs" Link="SnapshotDesignerLoader.cs" />
    <ProjectReference Include="..\..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
    <ProjectReference Include="..\..\..\..\..\Main\Designer\Designer.Server\Designer.Server.csproj" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" />
  </ItemGroup>
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup><HostOutput Include="$(TargetDir)**" /></ItemGroup>
    <Copy SourceFiles="@(HostOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(HostOutput->'$(MSBuildProjectDirectory)\..\..\..\..\..\..\AddIns\DisplayBindings\FormsDesigner\MicrosoftHost\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
