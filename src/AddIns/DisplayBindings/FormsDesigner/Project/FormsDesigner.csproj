<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.FormsDesigner</RootNamespace>
    <AssemblyName>FormsDesigner</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <OutputPath>..\..\..\..\..\AddIns\DisplayBindings\FormsDesigner\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\Main\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Src\OutOfProcess\*.cs" />
    <Compile Include="Src\OutOfProcess\RemoteFormsDesignerControl.cs" />
    <!-- The old NRefactory loader/generators remain excluded. The WinForms designer has been
         exclusively out-of-process since 2026-08 (doc/technotes/winforms-designer.md): the parent
         side only detects designable files (CSharpDesignerSecondaryDisplayBinding/
         VbDesignerSecondaryDisplayBinding), ships the source over JSON-RPC to FormsDesigner.Host,
         and renders the child's snapshot. The in-process fallback (OPENDEVELOP_WINFORMS_OOP=0,
         RoslynDesignerLoader in CSharpBinding, LoadDesigner in FormsDesignerViewContent) was
         removed - see doc/technotes/winforms-designer.md. The files excluded below are the
         remaining in-process-only machinery (designer service implementations, the CodeDom
         loader/generator base classes); they are excluded rather than deleted to preserve the
         migration history, matching the convention for the NRefactory files above. -->
    <Compile Remove="Src\DesignerLoader\NRefactoryDesignerLoader.cs" />
    <Compile Remove="Src\DesignerLoader\AbstractCodeDomDesignerLoader.cs" />
    <Compile Remove="Src\DesignerLoader\CodeDOMVerboseOutputGenerator.cs" />
    <Compile Remove="Src\DesignerGenerator\AbstractDesignerGenerator.cs" />
    <Compile Remove="Src\DesignerGenerator\CSharpDesignerGenerator.cs" />
    <Compile Remove="Src\DesignerGenerator\VBNetDesignerGenerator.cs" />
    <Compile Remove="Src\DesignerGenerator\CodeDOMGenerator.cs" />
    <Compile Remove="Src\DesignerGenerator\IDesignerGenerator.cs" />
    <Compile Remove="Src\UndoRedo\UndoEngine.cs" />
    <Compile Remove="Src\Services\UIService.cs" />
    <Compile Remove="Src\Services\HelpService.cs" />
    <Compile Remove="Src\Services\PropertyValueUIService.cs" />
    <Compile Remove="Src\Services\TypeDiscoveryService.cs" />
    <Compile Remove="Src\Services\TypeSystemHelper.cs" />
    <Compile Remove="Src\Services\DesignerResourceService.cs" />
    <Compile Remove="Src\Services\DefaultMemberRelationshipService.cs" />
    <Compile Remove="Src\Services\DefaultServiceContainer.cs" />
    <Compile Remove="Src\Services\DesignerOptionService.cs" />
    <Compile Remove="Src\Services\EventBindingService.cs" />
    <Compile Remove="Src\Services\DesignerSerializationService.cs" />
    <Compile Remove="Src\Services\SharpDevelopSerializationProvider.cs" />
    <Compile Remove="Src\Services\XmlDesignerNameCreationService.cs" />
    <!-- The in-process resource-editor cluster (Image/Icon property UITypeEditor + project
         resource CodeDom serializers) was only reachable through the removed in-process
         TypeDescriptor registration in LoadDesigner, so it is dead too. ResourceStore.cs and
         ToolboxService.cs stay live (DesignerViewContent still uses both). -->
    <Compile Remove="Src\Gui\ImageResourceEditorDialog.cs" />
    <Compile Remove="Src\Gui\ImageResourceEditorDialog.Designer.cs" />
    <Compile Remove="Src\Services\ImageResourceEditor.cs" />
    <Compile Remove="Src\Services\ProjectResourceService.cs" />
    <Compile Remove="Src\Services\ProjectResourceInfo.cs" />
    <Compile Remove="Src\Services\ProjectResourcesComponentCodeDomSerializer.cs" />
    <Compile Remove="Src\Services\ProjectResourcesMemberCodeDomSerializer.cs" />
    <Compile Remove="Src\Services\TypeSystemHelper.cs" />

    <!-- The legacy drag-from-toolbox side panel is built on
         ICSharpCode.SharpDevelop.Widgets.SideBar/SideTab, a legacy WinForms control that is itself
         excluded from that project's build (SideBar\**\*.cs Compile Remove) as part of the same
         "no legacy WinForms tree/list UI" MVP decision as ClassBrowser and the old ProjectBrowserPad.
         AddComponentsDialog/ConfigureSideBarDialog/RenameCategoryDialog are BaseSharpDevelopForm
         (.xfrm) dialogs configuring that same SideBar, and BaseSharpDevelopForm's whole
         ICSharpCode.SharpDevelop.Gui.XmlForms namespace is excluded from ICSharpCode.SharpDevelop's
         build for the same reason. None of this is needed for the designer SURFACE to work -
         Services\ToolboxService.cs (the real System.Drawing.Design.IToolboxService the .NET Design
         API talks to) has no dependency on any of it and stays live. The old panel was replaced by
         the shared WPF Toolbox Pad. FormsDesignerViewContent exposes that pad through
         IToolsHost; WpfToolbox registers WinForms ToolboxItems with the real IToolboxService and
         bridges drops into the hosted WinForms DesignSurface. The excluded files below are only
         the obsolete SideBar UI/configuration implementation. -->
    <Compile Remove="Src\Commands\SideBarCommands.cs" />
    <Compile Remove="Src\Gui\AddComponentsDialog.cs" />
    <Compile Remove="Src\Gui\ComponentLibraryLoader.cs" />
    <Compile Remove="Src\Gui\ConfigureSideBarDialog.cs" />
    <Compile Remove="Src\Gui\CustomComponentsSideTab.cs" />
    <Compile Remove="Src\Gui\RenameCategoryDialog.cs" />
    <Compile Remove="Src\Gui\SideTabDesigner.cs" />
    <Compile Remove="Src\Gui\SideTabItemDesigner.cs" />
    <Compile Remove="Src\ToolboxProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Libraries\AvalonEdit\ICSharpCode.AvalonEdit\ICSharpCode.AvalonEdit.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="False" />
    <!-- Designer.Remote / Designer.Presentation are not part of the app bin (SharpDevelop.csproj
         does not reference them), so they must be copied next to this addin like the WinUI addin's
         deployment does. -->
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
	<ProjectReference Include="..\..\..\..\Main\Designer\Designer.Shell\Designer.Shell.csproj" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Presentation\Designer.Presentation.csproj" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.Core.WinForms\ICSharpCode.Core.WinForms.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.SharpDevelop.Widgets\Project\ICSharpCode.SharpDevelop.Widgets.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Libraries\ICSharpCode.TypeSystem.Abstractions\ICSharpCode.TypeSystem.Abstractions.csproj" Private="False" />
    <!-- Needed for [DevFlowUIThread]/[DevFlowAction] on FormsDesignerDevFlowActions - see
         WpfDesign.AddIn.csproj for the ProjectReference variant used when wpf-labs is checked out
         locally; that relative path doesn't hold from this AddIn's location, so use the package
         directly here instead. -->
    <ProjectReference Include="..\..\..\..\..\externals\wpftoolkit\ExtendedWPFToolkitSolution\Src\Xceed.Wpf.Toolkit\Xceed.Wpf.Toolkit.csproj" Private="false" />
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="..\Remote\FormsDesigner.Remote.csproj" />
    <ProjectReference Include="..\Host\FormsDesigner.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
    <None Include="FormsDesigner.addin" />
  </ItemGroup>

  <ItemGroup>
    <!-- .xfrm resources for the excluded BaseSharpDevelopForm dialogs above; not needed. -->
    <None Remove="Resources\AddSidebarComponentsDialog.xfrm" />
    <None Remove="Resources\ConfigureSidebarDialog.xfrm" />
    <None Remove="Resources\RenameSidebarCategoryDialog.xfrm" />
    <EmbeddedResource Update="Src\Gui\ImageResourceEditorDialog.resx">
      <DependentUpon>ImageResourceEditorDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Services/ToolboxService.cs implements System.ComponentModel.Design.IToolboxService, whose
    CategoryNames property is typed System.Drawing.Design.CategoryNameCollection - a type that
    LibreWinForms.System.Windows.Forms.dll bundles directly (it merges what upstream .NET splits
    into System.Windows.Forms.Design), while the real netcore System.Drawing.Common (needed
    elsewhere in this project, unrelated to WinForms) happens to define an identically-named,
    identically-shaped type too. Referencing the DLL a second time under an extern alias lets
    ToolboxService.cs disambiguate which CategoryNameCollection it means (see the extern alias at
    the top of that file) without affecting every other unaliased, unambiguous use of
    System.Windows.Forms types throughout this project.
  -->
  <Target Name="_AddAliasedLibreWinFormsReference" AfterTargets="ResolveAssemblyReferences" BeforeTargets="GenerateTemporaryTargetAssembly;CoreCompile"
          Condition="'$(NuGetPackageRoot)' != ''">
    <ItemGroup>
      <_AliasedLibreWinFormsSystemWindowsForms Include="$(NuGetPackageRoot)librewinforms.system.windows.forms/*/lib/net10.0/System.Windows.Forms.dll" />
      <ReferencePath Include="@(_AliasedLibreWinFormsSystemWindowsForms)" Condition="'@(_AliasedLibreWinFormsSystemWindowsForms)' != ''">
        <Aliases>LibreWinForms</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <!--
    Font/Image/Icon/Graphics/Bitmap/ContentAlignment members reached through the real
    LibreWinForms Control/Form/etc. API (e.g. Control.Font, PictureBox.Image) are typed in terms
    of the ProGPU.System.Drawing.Common (0.0.0.0) that LibreWinForms.System.Windows.Forms.dll was
    itself built against - not the real netcore System.Drawing.Common (10.0.9) that ends up on
    this project's ReferencePath purely transitively, via ICSharpCode.SharpDevelop.Widgets'
    PackageReference (used there for its own, WPF-side icon rendering; nothing in FormsDesigner's
    own source touches it directly). Swap it out the same way _ReplaceWindowsDesktopRefPackWinFormsFacades
    (Directory.Build.targets) already does for other projects, just without that target's
    "only if nothing else resolved one" guard - safe here specifically because this project's own
    code never needs the real one.
  -->
  <Target Name="_ReplaceTransitiveRealSystemDrawingCommon" AfterTargets="ResolveAssemblyReferences" BeforeTargets="GenerateTemporaryTargetAssembly;CoreCompile"
          Condition="'$(NuGetPackageRoot)' != ''">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'System.Drawing.Common' And '%(ReferencePath.NuGetPackageId)' == 'System.Drawing.Common'" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" Condition="'%(ReferencePathWithRefAssemblies.Filename)' == 'System.Drawing.Common' And '%(ReferencePathWithRefAssemblies.NuGetPackageId)' == 'System.Drawing.Common'" />
      <_RealProGpuSystemDrawingCommonForFormsDesigner Include="$(NuGetPackageRoot)progpu.system.drawing.common/*/lib/net10.0/System.Drawing.Common.dll" />
      <ReferencePath Include="@(_RealProGpuSystemDrawingCommonForFormsDesigner)" Condition="'@(_RealProGpuSystemDrawingCommonForFormsDesigner)' != ''">
        <NuGetPackageId>ProGPU.System.Drawing.Common</NuGetPackageId>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
