<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The sources annotate nullability with '?' throughout; the annotation context must be
         enabled for those annotations to be legal, without turning the warning context on for
         legacy files that were never audited. -->
    <Nullable>annotations</Nullable>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FormsDesigner.Remote</AssemblyName>
    <RootNamespace>ICSharpCode.FormsDesigner.OutOfProcess</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Project\Src\OutOfProcess\FormsDesignerHostClient.cs" Link="FormsDesignerHostClient.cs" />
    <Compile Include="..\Project\Src\OutOfProcess\WinFormsProjectControlFinder.cs" Link="WinFormsProjectControlFinder.cs" />
    <PackageReference Include="StreamJsonRpc" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
    <ProjectReference Include="..\Host\FormsDesigner.Host.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc pulls MessagePack transitively; reference it directly so NuGet unifies on the
         centrally pinned release instead of resolving the vulnerable 2.5.x (NU1902/NU1903). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
