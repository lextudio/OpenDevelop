<ResourceDictionary x:Class="ICSharpCode.Data.Core.UI.ImageDictionary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ICSharpCode.Data.Core.UI">
    
    <x:Static x:Key="ErrorImage" Member="local:DataImages.Error" />
    <x:Static x:Key="ExclamationImage" Member="local:DataImages.Warning" />
    <x:Static x:Key="RefreshImage" Member="local:DataImages.Refresh" />
    <x:Static x:Key="DatabaseImage" Member="local:DataImages.Database" />
    <x:Static x:Key="DatabaseConnectImage" Member="local:DataImages.ConnectToDatabase" />
    <x:Static x:Key="DatabaseTableImage" Member="local:DataImages.Table" />
    <x:Static x:Key="TableImage" Member="local:DataImages.Column" />
    <x:Static x:Key="TableForeignKeyImage" Member="local:DataImages.ForeignKey" />
    <x:Static x:Key="TableKeyImage" Member="local:DataImages.Key" />
    <x:Static x:Key="ProcedureImage" Member="local:DataImages.StoredProcedure" />
</ResourceDictionary>
