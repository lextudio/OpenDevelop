<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="ICSharpCode.WpfDesign.AddIn.WpfDocumentError" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:ICSharpCode.WpfDesign.AddIn"
	Background="#888">
	<Border
		Background="#DDD"
		BorderBrush="#999"
		BorderThickness="2"
		MaxWidth="900"
		Margin="24">
		<Border.Effect>
			<DropShadowEffect
				BlurRadius="15"
				Color="#777"
				ShadowDepth="2" />
		</Border.Effect>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<!-- The additional-information box is the only row that should absorb extra
				     height as the window grows - a long stack trace needs room to actually show
				     more lines (and stay comfortably mouse-selectable) rather than being capped to
				     a fixed handful of lines regardless of how large the window is. -->
				<RowDefinition Height="*" MinHeight="120" />
			</Grid.RowDefinitions>
			<StackPanel
				Grid.Row="0"
				Orientation="Horizontal"
				Height="50"
				HorizontalAlignment="Left">
				<Image
					Margin="10,10,0,5"
					Name="ErrorIcon"
					Width="32"
					Height="32"
					Source="{x:Static local:WpfDesignImages.Error}"
					HorizontalAlignment="Left"
					VerticalAlignment="Top" />
				<TextBlock
					Text="Problem Loading"
					Foreground="#333"
					FontSize="16"
					Margin="10,10,0,5"
					VerticalAlignment="Center"
					HorizontalAlignment="Left" />
			</StackPanel>
			<Line
				Grid.Row="1"
				Y1="5"
				Y2="5"
				X1="50"
				X2="450"
				Stroke="#444"
				StrokeThickness="0.5"
				HorizontalAlignment="Stretch"
				Stretch="Fill" />
			<TextBlock
				Grid.Row="2"
				TextWrapping="Wrap"
				Text="The document contains errors which should be fixed so that the designer can load. Switch to XAML Tab to fix the errors."
				VerticalAlignment="Top"
				FontSize="14"
				Foreground="#333"
				HorizontalAlignment="Left"
				Margin="50,10,10,10" />
			<TextBlock
				Grid.Row="3"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Margin="50,0,10,10">
				<Hyperlink
					Foreground="Black"
					Click="ViewXaml">View XAML</Hyperlink>
			</TextBlock>
			<GroupBox
				Grid.Row="4"
				x:Name="additionalInfoBox"
				Header="Additional information"
				Margin="50,10,10,20">
				<TextBox
					Margin="3"
					HorizontalScrollBarVisibility="Auto"
					VerticalScrollBarVisibility="Auto"
					x:Name="additionalInfo"
					IsReadOnly="True"
					TextWrapping="NoWrap"
					VerticalAlignment="Stretch"
					HorizontalAlignment="Stretch" />
			</GroupBox>
		</Grid>
	</Border>
</UserControl>
