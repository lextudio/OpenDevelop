<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.WpfDesign.AddIn</RootNamespace>
    <AssemblyName>ICSharpCode.WpfDesign.AddIn</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <OutputPath>..\..\..\..\..\AddIns\DisplayBindings\WpfDesign\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\externals\wpftoolkit\ExtendedWPFToolkitSolution\Src\Xceed.Wpf.Toolkit\Xceed.Wpf.Toolkit.csproj" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\WpfDesigner\WpfDesign.Designer\Project\WpfDesign.Designer.csproj" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\WpfDesigner\WpfDesign.XamlDom\Project\WpfDesign.XamlDom.csproj" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\WpfDesigner\WpfDesign\Project\WpfDesign.csproj" />
    <!-- WPF DDP cutover (see doc/technotes/wpf-designer.md, "Phase 1"): the shared canvas
         presentation helpers and the out-of-process host client, mirroring how FormsDesigner/
         WinUIXamlDesigner reference their own equivalents. -->
    <!-- The shared design canvas and the Presentation assembly it ships are loaded from the
         ICSharpCode.DesignerCanvas addin (see WpfDesign.addin), never from a private copy: two
         copies would give the canvas's types two identities. -->
    <ProjectReference Include="..\..\DesignerCanvas\ICSharpCode.DesignerCanvas.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Presentation\Designer.Presentation.csproj" Private="false" />
	<ProjectReference Include="..\..\..\..\Main\Designer\Designer.Shell\Designer.Shell.csproj" />
    <ProjectReference Include="..\WpfDesign.SurfaceHost.Remote\WpfDesign.SurfaceHost.Remote.csproj" />
    <!-- This addin's XAML language servers (registered by RegisterXamlLanguageServersCommand):
         built, and deployed by their own DeployToAddIns, whenever the addin is. Not referenced -
         they are separate processes. -->
    <ProjectReference Include="..\WpfDesign.LanguageServer.LibreWpf\WpfDesign.LanguageServer.LibreWpf.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\src\XamlLanguageServer.Wpf\XamlLanguageServer.Wpf.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <!-- The Hot Reload agents this addin's WpfApplicationHotReloadAdapter injects: built with the
         addin, and deployed into its HotReload/<runtime>/ by their own DeployAgentToAddIn. Never
         referenced - they run inside the debuggee, not the IDE. -->
    <ProjectReference Include="..\..\..\..\Main\HotReload\WpfHotReload.Agent\WpfHotReload.Agent.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\HotReload\WpfHotReload.Agent.Microsoft\WpfHotReload.Agent.Microsoft.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <ProjectReference Include="..\..\..\..\Libraries\ICSharpCode.TypeSystem.Abstractions\ICSharpCode.TypeSystem.Abstractions.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.Core.WinForms\ICSharpCode.Core.WinForms.csproj" Private="False" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.SharpDevelop.Widgets\Project\ICSharpCode.SharpDevelop.Widgets.csproj" Private="False" />
    <!-- Resolve DevFlow from the published package so this project has no sibling-checkout dependency. -->
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
    <!-- Intentionally NOT CopyToOutputDirectory="Always": MSBuild propagates a project's own
         <None CopyToOutputDirectory> content items into every downstream consumer's own
         OutputPath (via GetCopyToOutputDirectoryItems walking the full transitive P2P closure),
         regardless of Private="false" on intermediate ProjectReference edges (Private only
         suppresses copying this project's own compiled assembly, not its content items). Since
         several unrelated addins (ILSpyAddIn, PackageManagement, CodeCoverage) transitively
         reference this project (e.g. via AvalonEdit.AddIn, which genuinely needs the WpfDesign.*
         assemblies at compile time), that propagation was duplicating "WpfDesign.addin" - and the
         AddInTree assemblies it pulls in - into their output folders too, each registering a
         conflicting duplicate "ICSharpCode.WpfDesigner" AddInTree identity at startup. The
         explicit AfterTargets="Build" copy below achieves the same "copy the manifest into this
         project's own output" result without exposing it as a propagating content item. -->
    <None Include="WpfDesign.addin" />
  </ItemGroup>
</Project>
