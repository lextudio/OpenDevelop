<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deploy the LibreWPF profile of Microsoft's XAML language server. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>librewpf-xaml-ls</AssemblyName>
    <RootNamespace>ICSharpCode.WpfDesign.LanguageServer.LibreWpf</RootNamespace>
    <LanguageServerDeployDir>$(MSBuildProjectDirectory)\..\..\..\..\..\AddIns\LanguageServices\LibreWpfXamlLanguageServer</LanguageServerDeployDir>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>OutOfProcessHost</OpenDevelopAddinKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\externals\winappvsce\server\src\WinUiXaml.LanguageServer\WinUiXaml.LanguageServer.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>
  <!-- Deploy the runnable server into AddIns/LanguageServices/LibreWpfXamlLanguageServer/, where the
       WPF designer addin looks for it (and which dist.ps1 / the macOS bundle keep as an
       out-of-process folder). -->
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup><LanguageServerOutput Include="$(MSBuildThisFileDirectory)..\..\..\..\..\externals\winappvsce\server\src\WinUiXaml.LanguageServer\bin\$(Configuration)\net10.0\**\*" /></ItemGroup>
    <Error Condition="'@(LanguageServerOutput)' == ''" Text="The WinAppVSCE language-server output is missing; build its project before deploying the LibreWPF server." />
    <RemoveDir Directories="$(LanguageServerDeployDir)" />
    <Copy SourceFiles="@(LanguageServerOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(LanguageServerOutput->'$(LanguageServerDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
