<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.WpfDesign.SurfaceHost</RootNamespace>
    <AssemblyName>WpfDesign.SurfaceHost</AssemblyName>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\WpfDesigner\WpfDesign\Project\WpfDesign.csproj" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\WpfDesigner\WpfDesign.XamlDom\Project\WpfDesign.XamlDom.csproj" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\WpfDesigner\WpfDesign.Designer\Project\WpfDesign.Designer.csproj" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" />
    <ProjectReference Include="..\..\..\..\Main\Designer\Designer.Server\Designer.Server.csproj" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <!-- Deploy this whole build output into a "Host" subfolder next to the deployed
       WpfDesign.AddIn, mirroring FormsDesigner.Host.csproj's own DeployToAddIns target
       exactly - WpfSurfaceHostClient's LocateChildDll() looks for it at that same
       relative path. -->
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup>
      <_HostOutput Include="$(TargetDir)**" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(_HostOutput->'$(MSBuildProjectDirectory)\..\..\..\..\..\AddIns\DisplayBindings\WpfDesign\Host\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
