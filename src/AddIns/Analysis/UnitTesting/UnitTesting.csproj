<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.UnitTesting</RootNamespace>
    <AssemblyName>UnitTesting</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <OutputPath>..\..\..\..\AddIns\Analysis\UnitTesting\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Client for Microsoft.Testing.Platform's server-mode JSON-RPC protocol (Mtp/MtpServerProcess.cs)
         - replaces the classic vstest.console/TranslationLayer path entirely. -->
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <!-- StreamJsonRpc pulls MessagePack 2.5.187 transitively (NU1902/NU1903, several known CVEs).
         Pin the patched 3.x version so NuGet unifies to the same build Base uses. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" />
    <ProjectReference Include="..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.SharpDevelop.Widgets\Project\ICSharpCode.SharpDevelop.Widgets.csproj" />
    <ProjectReference Include="..\..\..\Libraries\SharpTreeView\ICSharpCode.TreeView\ICSharpCode.TreeView.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Commands/*.cs" />
    <Compile Include="Configuration/AssemblyInfo.cs" />
    <Compile Include="ImmutableStack.cs" />
    <Compile Include="Interfaces/*.cs" />
    <Compile Include="Model/*.cs" />
    <Compile Include="Mtp/*.cs" />
    <Compile Include="MultiDictionary.cs" />
    <Compile Include="Options/*.cs" />
    <Compile Include="Pad/ITestTreeView.cs" />
    <Compile Include="Pad/TestTreeView.cs" />
    <Compile Include="Pad/UnitTestNode.cs" />
    <Compile Include="Pad/UnitTestNodeFactory.cs" />
    <Compile Include="Pad/UnitTestsPad.cs" />
    <Compile Include="Pad/UnitTestsPadToolPaneModel.cs" />
    <Compile Include="Pad/UnitTestsPadView.xaml.cs">
      <DependentUpon>UnitTestsPadView.xaml</DependentUpon>
    </Compile>
    <Compile Include="Pad/UnitTestsPadViewModel.cs" />
    <Compile Include="Resources/*.cs" />
    <Compile Include="Service/*.cs" />
    <Compile Include="TestRunner/*.cs" />
    <Compile Include="MtpTestDebugger.cs" />
    <Compile Include="MtpTestFramework.cs" />
    <Compile Include="MtpTestProject.cs" />
    <Compile Include="MtpTestRunner.cs" />
    <Compile Include="TestOpenLensProvider.cs" />
    <Compile Include="TestLensMenuContributors.cs" />
    <Compile Include="RegisterTestOpenLensProviderCommand.cs" />
    <Compile Include="RegisterUnitTestsPadToolPaneCommand.cs" />
    <!-- Shared with UnoDevelop.UnitTesting (which links this same file) - see
         doc/technotes/unit-testing.md "Implemented: Roslyn-assisted discovery". Deliberately not
         under Service/*.cs or TestRunner/*.cs above (those wildcards would also pull in the rest
         of Simple/*.cs, which is UnoDevelop's own flat ITestService and not part of this classic
         tree-shaped AddIn). -->
    <Compile Include="Simple/RoslynTestScanner.cs" />
    <Compile Include="..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="UnitTesting.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
