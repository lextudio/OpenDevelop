<UserControl
	x:Class="OpenDevelop.Profiler.AddIn.Views.CountersView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:core="http://icsharpcode.net/sharpdevelop/core">
	<Grid>
		<TextBlock
			x:Name="emptyText"
			Margin="8"
			TextWrapping="Wrap"
			Visibility="Collapsed"
			Text="{core:Localize AddIns.Profiler.Report.NoCounters}" />
		<ScrollViewer x:Name="scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel x:Name="panel" Margin="4" />
		</ScrollViewer>
	</Grid>
</UserControl>
