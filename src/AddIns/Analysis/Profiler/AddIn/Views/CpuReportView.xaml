<UserControl
	x:Class="OpenDevelop.Profiler.AddIn.Views.CpuReportView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:core="http://icsharpcode.net/sharpdevelop/core"
	xmlns:local="clr-namespace:OpenDevelop.Profiler.AddIn.Views"
	PreviewKeyDown="Report_PreviewKeyDown">
	<DockPanel>
		<ToolBarTray DockPanel.Dock="Top" IsLocked="True">
			<ToolBar Band="0" BandIndex="0">
				<ComboBox
					x:Name="viewSelector"
					MinWidth="150"
					ToolTip="{core:Localize AddIns.Profiler.Report.View}"
					SelectionChanged="ViewSelector_SelectionChanged">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<Image Width="16" Height="16" Margin="0,0,6,0" Source="{Binding Icon}" />
								<TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Separator />
				<ToggleButton
					x:Name="justMyCode"
					IsChecked="True"
					ToolTip="{core:Localize AddIns.Profiler.Report.JustMyCode}"
					Click="Filter_Changed">
					<Image Width="16" Height="16" Source="{core:GetBitmap Profiler.JustMyCode}" />
				</ToggleButton>
				<ToggleButton
					x:Name="includeBlocked"
					ToolTip="{core:Localize AddIns.Profiler.Report.IncludeBlocked}"
					Click="Filter_Changed">
					<Image Width="16" Height="16" Source="{core:GetBitmap Profiler.IncludeBlocked}" />
				</ToggleButton>
				<Separator />
				<Image
					Width="16"
					Height="16"
					Margin="2,0,4,0"
					ToolTip="{core:Localize AddIns.Profiler.Report.Thread}"
					Source="{core:GetBitmap Profiler.Thread}" />
				<ComboBox
					x:Name="threadSelector"
					MinWidth="110"
					DisplayMemberPath="Label"
					SelectionChanged="Filter_SelectionChanged" />
				<Separator />
				<Button
					x:Name="expandHotPathButton"
					ToolTip="{core:Localize AddIns.Profiler.Report.ExpandHotPath}"
					Click="ExpandHotPath_Click">
					<Image Width="16" Height="16" Source="{core:GetBitmap Profiler.ExpandHotPath}" />
				</Button>
				<Button
					x:Name="clearRangeButton"
					Visibility="Collapsed"
					ToolTip="{core:Localize AddIns.Profiler.Report.ClearRange}"
					Click="ClearRange_Click">
					<Image Width="16" Height="16" Source="{core:GetBitmap Profiler.ShowWholeCapture}" />
				</Button>
				<Separator />
				<Button
					x:Name="findButton"
					ToolTip="{core:Localize AddIns.Profiler.Report.FindTooltip}"
					Click="FindButton_Click">
					<Image Width="16" Height="16" Source="{core:GetBitmap Profiler.Find}" />
				</Button>
			</ToolBar>
		</ToolBarTray>

		<TextBlock
			x:Name="statusText"
			DockPanel.Dock="Bottom"
			Margin="6,4"
			TextWrapping="Wrap" />

		<local:TimelineControl
			x:Name="timeline"
			DockPanel.Dock="Top"
			Margin="4,4,4,4"
			RangeSelected="Timeline_RangeSelected" />

		<Grid Margin="4,0,4,0">
			<local:CallTreeView x:Name="callTree" ShowCallerCalleeRequested="ShowCallerCalleeRequested" GoToSourceRequested="GoToSourceRequested" />
			<local:FunctionsView x:Name="functions" Visibility="Collapsed" ShowCallerCalleeRequested="ShowCallerCalleeRequested" GoToSourceRequested="GoToSourceRequested" />
			<local:CallerCalleePanel
				x:Name="callerCallee"
				Visibility="Collapsed"
				NavigateRequested="CallerCallee_NavigateRequested"
				BackRequested="CallerCallee_BackRequested" />
			<ScrollViewer
				x:Name="flameScroll"
				Visibility="Collapsed"
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled">
				<local:FlameGraphControl x:Name="flameGraph" FrameActivated="ShowCallerCalleeRequested" />
			</ScrollViewer>
			<local:RingDiagramControl x:Name="ringDiagram" Visibility="Collapsed" FrameActivated="ShowCallerCalleeRequested" />
			<local:FindOverlay x:Name="findOverlay" FindRequested="FindOverlay_FindRequested" Closed="FindOverlay_Closed" />
		</Grid>
	</DockPanel>
</UserControl>
