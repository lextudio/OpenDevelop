<Window
	x:Class="OpenDevelop.Profiler.AddIn.Dialogs.CaptureControlWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	WindowStartupLocation="CenterOwner"
	WindowStyle="ToolWindow"
	ShowInTaskbar="False"
	ResizeMode="NoResize"
	SizeToContent="Height"
	Width="420">
	<StackPanel Margin="12">
		<TextBlock
			x:Name="status"
			FontWeight="SemiBold"
			TextWrapping="Wrap" />
		<ProgressBar
			Margin="0,8,0,0"
			Height="6"
			IsIndeterminate="True" />
		<TextBlock
			x:Name="hint"
			Margin="0,10,0,0"
			TextWrapping="Wrap"
			Visibility="Collapsed" />
		<Button
			x:Name="actionButton"
			Margin="0,12,0,0"
			HorizontalAlignment="Right"
			MinWidth="120"
			IsDefault="True"
			Click="ActionButton_Click" />
	</StackPanel>
</Window>
