<Window
	x:Class="OpenDevelop.Profiler.AddIn.Dialogs.ProcessPickerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:core="http://icsharpcode.net/sharpdevelop/core"
	Title="{core:Localize AddIns.Profiler.Attach.Title}"
	WindowStartupLocation="CenterOwner"
	WindowStyle="ToolWindow"
	ShowInTaskbar="False"
	Height="420"
	Width="520">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock
			x:Name="prompt"
			Grid.Row="0"
			Margin="0,0,0,6"
			TextWrapping="Wrap" />
		<ListView
			x:Name="processList"
			Grid.Row="1"
			SelectionMode="Single"
			MouseDoubleClick="ProcessList_MouseDoubleClick"
			SelectionChanged="ProcessList_SelectionChanged">
			<ListView.View>
				<GridView>
					<GridViewColumn
						Header="{core:Localize Global.Name}"
						Width="300"
						DisplayMemberBinding="{Binding Name}" />
					<GridViewColumn
						Header="{core:Localize Global.ID}"
						Width="80"
						DisplayMemberBinding="{Binding Id}" />
				</GridView>
			</ListView.View>
		</ListView>
		<TextBlock
			x:Name="warning"
			Grid.Row="2"
			Margin="0,8,0,0"
			TextWrapping="Wrap"
			Visibility="Collapsed" />
		<DockPanel
			Grid.Row="3"
			Margin="0,8,0,0"
			LastChildFill="False">
			<Button
				x:Name="refreshButton"
				DockPanel.Dock="Left"
				MinWidth="90"
				Click="Refresh_Click"
				Content="{core:Localize AddIns.Profiler.Attach.Refresh}" />
			<Button
				DockPanel.Dock="Right"
				MinWidth="90"
				IsCancel="True"
				Content="{core:Localize Global.Cancel}" />
			<Button
				x:Name="startButton"
				DockPanel.Dock="Right"
				MinWidth="90"
				Margin="0,0,8,0"
				IsDefault="True"
				IsEnabled="False"
				Click="Start_Click" />
		</DockPanel>
	</Grid>
</Window>
