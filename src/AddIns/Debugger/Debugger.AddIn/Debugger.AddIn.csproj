<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Debugger.AddIn</RootNamespace>
    <AssemblyName>Debugger.AddIn</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\Main\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
    <OutputPath>..\..\..\..\AddIns\Debugger\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <!-- GraphSharp/QuickGraph (used only by the un-ported ObjectGraphVisualizer) are no longer referenced. -->

  <ItemGroup>
    <PackageReference Include="ICSharpCode.AvalonEdit.LibreWPF" />
    <!-- Private (copy-local) unlike the other references here: the main app does not already load
         ICSharpCode.TreeView.dll itself, so it must be deployed into AddIns/Debugger/ for the
         Watch/Locals SharpTreeView-based pads to resolve it at runtime. -->
    <ProjectReference Include="..\..\..\Libraries\SharpTreeView\ICSharpCode.TreeView\ICSharpCode.TreeView.csproj" />
    <ProjectReference Include="..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <!-- DeviceService: the machine-wide device list, used to pick the iOS Simulator to debug in -->
    <ProjectReference Include="..\..\..\Main\Designer\Designer.Shell\Designer.Shell.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\Designer\Designer.Remote\Designer.Remote.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.Core.WinForms\ICSharpCode.Core.WinForms.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Main\ICSharpCode.SharpDevelop.Widgets\Project\ICSharpCode.SharpDevelop.Widgets.csproj" Private="false" />
    <!-- Lets the loaded debugger add-in expose narrow, production-path DevFlow probes for
         integration tests. The probes are discovered after the add-in itself is loaded. -->
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resumes the debuggee's runtime after it was launched suspended (DapLaunchMode.AttachToSuspendedProcess) -
         see DapSession.ConfigurationDoneAsync. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Main\GlobalAssemblyInfo.cs" Link="Properties\GlobalAssemblyInfo.cs" />
    <None Include="Debugger.AddIn.addin" CopyToOutputDirectory="Always" />
    <!-- Local in-process expression evaluation against Debugger.Core.Value is superseded by the DAP
         "evaluate" request (handled by the SharpDbg adapter). Kept on disk for reference, not compiled. -->
    <Compile Remove="NRefactory\ExpressionEvaluationVisitor.cs" />
    <Compile Remove="NRefactory\ExpressionExtensionMethods.cs" />
    <!-- Class Browser integration for the debuggee's loaded modules relied on Debugger.Core's
         NRefactory-based type system reflection; DAP only exposes a flat module list (see
         Pads/LoadedModulesPad.cs). Known capability gap, kept on disk for reference. -->
    <Compile Remove="Pads\ClassBrowserSupport.cs" />
    <!-- The WinForms process picker is excluded (WinForms hosting is out of MVP scope);
         AttachToProcessWindow.xaml replaces it in WPF, and SharpDbg implements the "attach"
         request, so attach-to-process is available. -->
    <Compile Remove="Service\AttachToProcessForm.cs" />
    <!-- WinForms hosting (SD.WinForms/IWinFormsService) was already removed from the SharpDevelop
         shell in this repo ("out of MVP scope"), independent of this migration - so the WinForms
         DebuggeeExceptionForm can no longer be shown modally over the main window. Replaced by a
         MessageService.ShowCustomDialog-based prompt in WindowsDebugger.cs (loses the scrollable
         stack trace view and the "stop breaking on this exception type" checkbox - known gap). -->
    <Compile Remove="Service\DebuggeeExceptionForm.cs" />
    <Compile Remove="Service\DebuggeeExceptionForm.Designer.cs" />
    <EmbeddedResource Remove="Service\DebuggeeExceptionForm.resx" />
    <!-- Debug-console dot-completion (Pads/DebuggerDotCompletion.cs) goes through the SD.LanguageService
         abstraction (Roslyn-backed in this repo), not NRefactory - kept and compiled as-is. -->
    <!-- Text/XML/Grid visualizers rewritten to consume DAP evaluate/variables results (name/value/
         type strings + variablesReference) instead of Debugger.Core.Value reflection - see
         Visualizers/Commands/*VisualizerCommand.cs. ObjectGraphVisualizer (GraphSharp-based live
         object reference graph with cycle detection) is NOT ported: DAP gives no object identity/
         address, so cycle detection and the whole ObjectGraphBuilder reflection walk have no
         equivalent without a custom SharpDbg protocol extension. Known, accepted capability gap -
         kept on disk for reference, not compiled. -->
    <Compile Remove="Visualizers\**\*.cs" />
    <Compile Include="Visualizers\Common\IVisualizerCommand.cs" />
    <Compile Include="Visualizers\Commands\IVisualizerDescriptor.cs" />
    <Compile Include="Visualizers\Commands\VisualizerDescriptors.cs" />
    <Compile Include="Visualizers\Commands\ExpressionVisualizerCommand.cs" />
    <Compile Include="Visualizers\Commands\TextVisualizerCommand.cs" />
    <Compile Include="Visualizers\Commands\XmlVisualizerCommand.cs" />
    <Compile Include="Visualizers\Commands\GridVisualizerCommand.cs" />
    <Compile Include="Visualizers\TextVisualizer\TextVisualizerWindow.xaml.cs" />
    <Compile Include="Visualizers\GridVisualizer\GridVisualizerWindow.xaml.cs" />
    <Page Remove="Visualizers\**\*.xaml" />
    <Page Include="Visualizers\TextVisualizer\TextVisualizerWindow.xaml" />
    <Page Include="Visualizers\GridVisualizer\GridVisualizerWindow.xaml" />
    <Page Include="Visualizers\GridVisualizer\ColumnPicker.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The adapter comes from lextudio's SharpDbg package, published by externals/sharpdbg's own
         workflow (publish-opendevelop-packages.yml). It is an out-of-process program copied next to the
         add-in, so ExcludeAssets="all" keeps it out of this project's own reference closure, and
         GeneratePathProperty is what gives the copy a path into the restored package. -->
    <PackageReference Include="LeXtudio.SharpDbg.Cli" ExcludeAssets="all" GeneratePathProperty="true" />
    <!-- The three NativeAOT Android agents (and the runtime notices they ship), also published by that
         workflow: building them here required the .NET 11 preview SDK, the Android workload and an NDK
         in every job, for content that only changes when the SharpDbg repository does. -->
    <PackageReference Include="LeXtudio.SharpDbg.AndroidAgent" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- BeforeTargets is load-bearing: OpenDevelop.Addin.Sdk's OpenDevelopTrimAddinOutput also runs
       AfterTargets="Build", and it deletes anything from this folder whose filename also exists in
       the host bin. Without a declared order it ran AFTER this copy and stripped the adapter's
       dependencies back out. -->
  <Target Name="CopySharpDbgToAddInOutput" AfterTargets="Build"
          BeforeTargets="OpenDevelopTrimAddinOutput"
          Condition="Exists('$(PkgLeXtudio_SharpDbg_Cli)')">
    <!-- The adapter used to ship Microsoft.VisualStudio.Shared.VSCodeDebugProtocol, whose license
         is not open source. The package carries the MIT OmniSharp fork instead, but an output folder
         built before that change can still hold the old DLL: the copy target never deletes. Drop it,
         or the payload verifier fails the release. See doc/technotes/licensing-audit.md. -->
    <Delete Files="$(OutputPath)Microsoft.VisualStudio.Shared.VSCodeDebugProtocol.dll"
            Condition="Exists('$(OutputPath)Microsoft.VisualStudio.Shared.VSCodeDebugProtocol.dll')" />
    <ItemGroup>
      <SharpDbgFiles Include="$(PkgLeXtudio_SharpDbg_Cli)\lib\net10.0\**\*.*" />
      <!-- SharpDbg.Cli is an OUT-OF-PROCESS program that happens to be deployed inside an
           in-process addin's folder. It resolves its dependencies through its own deps.json, from
           its own directory - it cannot fall back to the host's base directory the way an
           in-process addin can. So every assembly in its closure must survive host trimming, even
           though the host also ships a copy.
           
           This is not hypothetical: Newtonsoft.Json, Microsoft.CodeAnalysis(.CSharp) and two
           Microsoft.Extensions.* assemblies were all being deleted, and the adapter died at
           startup with "Could not load file or assembly 'Newtonsoft.Json'" before answering the
           very first DAP "initialize" request - which surfaced in the IDE only as an
           ObjectDisposedException from the torn-down client, so every debug session failed with
           no usable diagnostic.
           
           Derived from the same item list that does the copy, so it stays correct as SharpDbg's
           dependency closure changes. The SDK matches this list on %(Filename). -->
      <OpenDevelopAlwaysCopy Include="@(SharpDbgFiles)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(SharpDbgFiles)"
          DestinationFolder="$(OutputPath)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Android agents are native, per-device-ABI payloads carried by LeXtudio.SharpDbg.AndroidAgent.
       They are copied, not referenced, so ExcludeAssets="all" keeps the package's content out of this
       project's own closure. -->
  <Target Name="CopyAndroidDebugAgents" AfterTargets="Build" BeforeTargets="OpenDevelopTrimAddinOutput"
          Condition="Exists('$(PkgLeXtudio_SharpDbg_AndroidAgent)')">
    <ItemGroup>
      <AndroidDebugAgentFiles Include="$(PkgLeXtudio_SharpDbg_AndroidAgent)\agent\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AndroidDebugAgentFiles)"
          DestinationFiles="@(AndroidDebugAgentFiles->'$(OutputPath)android\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
