<Popup x:Class="Debugger.AddIn.Breakpoints.BreakpointEditorPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	       xmlns:core="http://icsharpcode.net/sharpdevelop/core"
       xmlns:sd="http://icsharpcode.net/sharpdevelop/core"
       xmlns:controls="clr-namespace:Debugger.AddIn.Pads.Controls"
       xmlns:widgets="http://icsharpcode.net/sharpdevelop/widgets"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Popup.Resources>
		<widgets:BoolToVisibilityConverter x:Key="showWhenTrue" TrueValue="Visible" FalseValue="Collapsed" />
	</Popup.Resources>
	<Border BorderBrush="Black" BorderThickness="1"
	        Background="LightGray">
		<StackPanel Orientation="Vertical" Background="White">
			<ToolBar ToolBarTray.IsLocked="True" ToolBar.OverflowMode="Never">
				<RadioButton x:Name="breakAction"
				             Checked="TypeChecked"
				             Content="{core:Localize BreakpointEditor.Break}"
				             ToolTip="{core:Localize BreakpointEditor.Break.ToolTip}" />
				<RadioButton x:Name="conditionalAction"
				             Checked="TypeChecked"
				             Content="{core:Localize BreakpointEditor.Conditional}"
				             ToolTip="{core:Localize BreakpointEditor.Conditional.ToolTip}" />
				<Separator />
				<CheckBox x:Name="hitCountCheck"
				          Checked="HitCountChecked"
				          Unchecked="HitCountChecked"
				          Content="{core:Localize BreakpointEditor.HitCount}"
				          ToolTip="{core:Localize BreakpointEditor.HitCount.ToolTip}" />
				<CheckBox x:Name="logCheck"
				          Checked="LogChecked"
				          Unchecked="LogChecked"
				          Content="{core:Localize BreakpointEditor.Log}"
				          ToolTip="{core:Localize BreakpointEditor.Log.ToolTip}" />
				<Separator />
				<CheckBox Content="{core:Localize BreakpointEditor.Enabled}"
				          IsChecked="{Binding IsEnabled}"
				          ToolTip="{core:Localize BreakpointEditor.Enabled.ToolTip}" />
			</ToolBar>
			<Border
				Margin="2"
				CornerRadius="2"
				BorderBrush="DarkGray"
				Padding="2"
				Visibility="{Binding IsChecked, ElementName=conditionalAction, Converter={StaticResource showWhenTrue}}"
				BorderThickness="1">
				<controls:AutoCompleteTextBox x:Name="condition" Text="{Binding Condition}" />
			</Border>
			<Border
				Margin="2"
				CornerRadius="2"
				BorderBrush="DarkGray"
				Padding="2"
				Visibility="{Binding IsChecked, ElementName=hitCountCheck, Converter={StaticResource showWhenTrue}}"
				BorderThickness="1">
				<TextBox x:Name="hitCondition" Text="{Binding HitCondition}"
				         ToolTip="{core:Localize BreakpointEditor.HitCountExpression.ToolTip}" />
			</Border>
			<Border
				Margin="2"
				CornerRadius="2"
				BorderBrush="DarkGray"
				Padding="2"
				Visibility="{Binding IsChecked, ElementName=logCheck, Converter={StaticResource showWhenTrue}}"
				BorderThickness="1">
				<TextBox x:Name="logMessage" Text="{Binding LogMessage}"
				         ToolTip="{core:Localize BreakpointEditor.Log.ToolTip}" />
			</Border>
		</StackPanel>
	</Border>
</Popup>
