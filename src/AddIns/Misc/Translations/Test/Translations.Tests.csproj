<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The catalogue, the source contract and the project workflow are pure (no IDE services), so they
         are tested here without the IDE; the addin only adds the commands and DevFlow actions. -->
    <Compile Include="..\Project\Src\PoCatalog.cs" Link="PoCatalog.cs" />
    <Compile Include="..\Project\Src\TranslatableStringSource.cs" Link="TranslatableStringSource.cs" />
    <Compile Include="..\Project\Src\TranslationProject.cs" Link="TranslationProject.cs" />
  </ItemGroup>
</Project>
