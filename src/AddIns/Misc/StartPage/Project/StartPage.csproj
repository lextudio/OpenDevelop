<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.StartPage</RootNamespace>
    <AssemblyName>StartPage</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\Main\ICSharpCode.SharpDevelop.snk</AssemblyOriginatorKeyFile>
    <OutputPath>..\..\..\..\..\AddIns\Misc\StartPage\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
    <Resource Include="Resources\**\*" />
    <!-- CopyToOutputDirectory content propagates through the full transitive project-reference
         closure. SharpDevelop references StartPage and AvalonEdit.AddIn references SharpDevelop,
         so the manifest was also copied into AddIns/DisplayBindings/AvalonEdit and registered the
         ICSharpCode.StartPage identity twice. Keep it as a normal project item and explicitly copy
         it only to StartPage's own output directory. -->
    <None Include="StartPage.addin" />
  </ItemGroup>
  <Target Name="CopyAddInManifest" AfterTargets="Build">
    <Copy SourceFiles="StartPage.addin" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
