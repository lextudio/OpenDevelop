<Window x:Class="ICSharpCode.AndroidSdkManager.AndroidSdkManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tv="http://icsharpcode.net/sharpdevelop/treeview"
        Title="Android SDKs and Tools"
        Height="520" Width="700"
        WindowStartupLocation="CenterOwner">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- SDK location bar -->
		<Grid Grid.Row="0" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock Text="Android SDK Location:" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<ComboBox x:Name="sdkLocationComboBox" Grid.Column="1" IsEditable="True"
			          SelectionChanged="SdkLocationComboBox_SelectionChanged"
			          LostFocus="SdkLocationComboBox_LostFocus"/>
			<Button x:Name="browseButton" Grid.Column="2" Content="..." Width="28" Margin="4,0,0,0"
			        Click="BrowseButton_Click"/>
		</Grid>

		<!-- Platforms / Tools tabs -->
		<TabControl Grid.Row="1" x:Name="tabControl">
			<TabItem Header="Platforms">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="Check or uncheck items to install or remove."
					           Margin="0,4,0,4"/>
					<tv:SharpTreeView x:Name="platformsTreeView" ShowRoot="False" ShowLines="False">
						<ListView.View>
							<tv:SharpGridView>
								<tv:SharpGridView.Columns>
									<GridViewColumn Header="Name" Width="280">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<tv:SharpTreeNodeView/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="Version" Width="90" DisplayMemberBinding="{Binding VersionText}"/>
									<GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}"/>
									<GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding StatusText}"/>
								</tv:SharpGridView.Columns>
							</tv:SharpGridView>
						</ListView.View>
					</tv:SharpTreeView>
				</DockPanel>
			</TabItem>
			<TabItem Header="Tools">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="Check or uncheck items to install or remove."
					           Margin="0,4,0,4"/>
					<tv:SharpTreeView x:Name="toolsTreeView" ShowRoot="False" ShowLines="False">
						<ListView.View>
							<tv:SharpGridView>
								<tv:SharpGridView.Columns>
									<GridViewColumn Header="Name" Width="330">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<tv:SharpTreeNodeView/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="Version" Width="90" DisplayMemberBinding="{Binding VersionText}"/>
									<GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}"/>
									<GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding StatusText}"/>
								</tv:SharpGridView.Columns>
							</tv:SharpGridView>
						</ListView.View>
					</tv:SharpTreeView>
				</DockPanel>
			</TabItem>
		</TabControl>

		<!-- Status / apply bar -->
		<Grid Grid.Row="2" Margin="0,8,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Button x:Name="updatesAvailableButton" Grid.Column="0" Content="0 Updates Available"
			        Padding="8,2" Click="UpdatesAvailableButton_Click"/>
			<TextBlock x:Name="installCountText" Grid.Column="2" Text="Install: 0"
			           VerticalAlignment="Center" Margin="0,0,8,0"/>
			<Button x:Name="applyChangesButton" Grid.Column="3" Content="Apply Changes"
			        Padding="12,4" IsEnabled="False" Click="ApplyChangesButton_Click"/>
		</Grid>
	</Grid>
</Window>
