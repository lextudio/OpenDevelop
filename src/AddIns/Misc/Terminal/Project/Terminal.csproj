<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OpenDevelop.Terminal</RootNamespace>
    <AssemblyName>OpenDevelop.Terminal</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\..\..\..\AddIns\Misc\Terminal\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
    <!-- Porta.Pty's transitive target cannot distinguish LibGhostty.Net's conpty.dll from the
         official package's. Stage LibGhostty's matching host explicitly below instead. -->
    <PortaPtyStageConPtyHost>false</PortaPtyStageConPtyHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\ICSharpCode.Core.Presentation\ICSharpCode.Core.Presentation.csproj" Private="false" />
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" />
    <!-- Only its VT half is used: the PTY is Porta.Pty, because LibGhostty.Net 1.0.2 writes a garbage
         winsize on macOS arm64 (stty size after Resize printed random numbers). -->
    <PackageReference Include="LibGhostty.Net" GeneratePathProperty="true" />
    <PackageReference Include="Porta.Pty" />
    <!-- Porta.Pty's Windows loader finds conpty.dll in the add-in directory, then requires its
         matching OpenConsole.exe under the process architecture directory. LibGhostty supplies
         the paired assets for both supported Windows RIDs. -->
    <None Include="$(PkgLibGhostty_Net)/runtimes/win-x64/native/OpenConsole.exe"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
      <Link>x64/OpenConsole.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(PkgLibGhostty_Net)/runtimes/win-arm64/native/OpenConsole.exe"
          Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
      <Link>arm64/OpenConsole.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
    <None Include="Terminal.addin" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
