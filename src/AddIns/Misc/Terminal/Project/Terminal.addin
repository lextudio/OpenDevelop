<AddIn name        = "Terminal"
       author      = "LeXtudio"
       copyright   = "prj:///doc/copyright.txt"
       description = "Integrated terminal pad"
       addInManagerHidden = "preinstalled">

	<Manifest>
		<Identity name = "OpenDevelop.Terminal"/>
	</Manifest>

	<Runtime>
		<Import assembly = "OpenDevelop.Terminal.dll"/>
	</Runtime>

	<Path name = "/SharpDevelop/Workbench/Pads">
		<Pad id       = "TerminalPad"
		     category = "Main"
		     title    = "Terminal"
		     icon     = "Icons.16x16.Console"
		     class    = "OpenDevelop.Terminal.TerminalPad"
		     defaultPosition = "Bottom, Hidden" />
	</Path>

	<Path name = "/SharpDevelop/Pads/TerminalPad/ToolBar">
		<ToolbarItem id    = "TerminalSessions"
		             class = "OpenDevelop.Terminal.TerminalSessionComboBox"
		             type  = "Custom"/>
		<ToolbarItem id      = "NewTerminal"
		             tooltip = "New Terminal"
		             icon    = "Icons.16x16.Add"
		             class   = "OpenDevelop.Terminal.NewTerminalCommand"/>
		<ToolbarItem id    = "NewTerminalShell"
		             class = "OpenDevelop.Terminal.TerminalNewShellButton"
		             type  = "Custom"/>
		<ToolbarItem id      = "SplitTerminal"
		             tooltip = "Split Terminal Left and Right"
		             icon    = "Icons.16x16.SplitWindowHorizontal"
		             class   = "OpenDevelop.Terminal.SplitTerminalCommand"/>
		<ToolbarItem id      = "SplitTerminalVertical"
		             tooltip = "Split Terminal Above and Below"
		             icon    = "Icons.16x16.SplitScreenVertically"
		             class   = "OpenDevelop.Terminal.SplitTerminalVerticalCommand"/>
		<ToolbarItem id      = "KillTerminal"
		             tooltip = "Kill Terminal"
		             icon    = "Icons.16x16.Delete"
		             class   = "OpenDevelop.Terminal.KillTerminalCommand"/>
		<ToolbarItem type="Separator"/>
		<ToolbarItem id      = "ClearTerminal"
		             tooltip = "Clear"
		             icon    = "Icons.16x16.ClearWindowContent"
		             class   = "OpenDevelop.Terminal.ClearTerminalCommand"/>
		<ToolbarItem id      = "FindTerminal"
		             tooltip = "Find in Terminal (Cmd+F, Ctrl+Shift+F)"
		             icon    = "Icons.16x16.Search"
		             class   = "OpenDevelop.Terminal.FindTerminalCommand"/>
		<ToolbarItem id      = "CopyTerminal"
		             tooltip = "Copy"
		             icon    = "Icons.16x16.Copy"
		             class   = "OpenDevelop.Terminal.CopyTerminalCommand"/>
		<ToolbarItem id      = "PasteTerminal"
		             tooltip = "Paste"
		             icon    = "Icons.16x16.Paste"
		             class   = "OpenDevelop.Terminal.PasteTerminalCommand"/>
		<ToolbarItem type="Separator"/>
		<ToolbarItem id      = "TerminalSettings"
		             tooltip = "Terminal Options"
		             icon    = "Icons.16x16.Settings"
		             class   = "OpenDevelop.Terminal.TerminalSettingsCommand"/>
	</Path>

	<Path name = "/SharpDevelop/Dialogs/OptionsDialog/UIOptions">
		<OptionPanel id    = "TerminalOptions"
		             label = "Terminal"
		             class = "OpenDevelop.Terminal.TerminalOptions"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/MainMenu/Edit">
		<Condition name = "WindowActive" activewindow="ICSharpCode.SharpDevelop.Editor.ITextEditor" action="Disable">
			<MenuItem id    = "SendToTerminal"
			          label = "Send to Terminal"
			          class = "OpenDevelop.Terminal.SendToTerminalCommand"/>
		</Condition>
	</Path>

	<Path name = "/SharpDevelop/ViewContent/TextEditor/ContextMenu">
		<MenuItem id          = "SendToTerminal"
		          label       = "Send to Terminal"
		          insertafter = "Delete"
		          class       = "OpenDevelop.Terminal.SendToTerminalCommand"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/MainMenu/View">
		<MenuItem id           = "Terminal"
		          label        = "Terminal"
		          icon         = "Icons.16x16.Console"
		          shortcut     = "Control|OemTilde"
		          insertbefore = "ViewItemsSeparator"
		          class        = "OpenDevelop.Terminal.ShowTerminalCommand"/>
		<MenuItem id           = "NewTerminal"
		          label        = "New Terminal"
		          shortcut     = "Control|Shift|OemTilde"
		          insertbefore = "ViewItemsSeparator"
		          class        = "OpenDevelop.Terminal.NewTerminalFromMenuCommand"/>
		<MenuItem id           = "NextTerminal"
		          label        = "Next Terminal"
		          insertbefore = "ViewItemsSeparator"
		          class        = "OpenDevelop.Terminal.NextTerminalCommand"/>
		<MenuItem id           = "PreviousTerminal"
		          label        = "Previous Terminal"
		          insertbefore = "ViewItemsSeparator"
		          class        = "OpenDevelop.Terminal.PreviousTerminalCommand"/>
		<MenuItem id           = "RenameTerminal"
		          label        = "Rename Terminal..."
		          insertbefore = "ViewItemsSeparator"
		          class        = "OpenDevelop.Terminal.RenameTerminalCommand"/>
	</Path>

	<Path name = "/SharpDevelop/Autostart">
		<Class id    = "TerminalRegisterServicesCommand"
		       class = "OpenDevelop.Terminal.RegisterTerminalServicesCommand"/>
		<Class id    = "TerminalRegisterDevFlowActionsCommand"
		       class = "OpenDevelop.Terminal.RegisterDevFlowActionsCommand"/>
	</Path>
</AddIn>
