<Window x:Class="ICSharpCode.AndroidDeviceManager.AvdEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Virtual Device Editor"
        Height="580" Width="1000"
        WindowStartupLocation="CenterOwner">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="260"/>
			</Grid.ColumnDefinitions>

			<!-- Basic device summary -->
			<StackPanel Grid.Column="0" Margin="0,0,8,0">
				<Border Width="120" Height="200" BorderBrush="Gray" BorderThickness="2" CornerRadius="16"
				        HorizontalAlignment="Center" Margin="0,0,0,16"/>

				<TextBlock Text="Name:" Margin="0,0,0,2"/>
				<TextBox x:Name="nameTextBox" Margin="0,0,0,10"/>

				<TextBlock Text="Base Device:" Margin="0,0,0,2"/>
				<ComboBox x:Name="baseDeviceComboBox" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>

				<TextBlock Text="Processor:" Margin="0,0,0,2"/>
				<ComboBox x:Name="processorComboBox" Margin="0,0,0,10">
					<ComboBoxItem Content="x86_64" IsSelected="True"/>
					<ComboBoxItem Content="x86"/>
					<ComboBoxItem Content="arm64-v8a"/>
				</ComboBox>

				<TextBlock Text="OS:" Margin="0,0,0,2"/>
				<ComboBox x:Name="systemImageComboBox" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>

				<CheckBox x:Name="googleApisCheckBox" Content="Google APIs" Margin="0,0,0,4"/>
				<CheckBox x:Name="playStoreCheckBox" Content="Google Play Store"/>
			</StackPanel>

			<!-- Advanced hardware property grid -->
			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" Text="Property" FontWeight="Bold" Margin="4,0,0,4"/>
				<ListView x:Name="propertyListView" Grid.Row="1" SelectionChanged="PropertyListView_SelectionChanged">
					<ListView.View>
						<GridView>
							<GridViewColumn Header="Property" Width="200" DisplayMemberBinding="{Binding Title}"/>
							<GridViewColumn Header="Value" Width="220">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<Grid>
											<CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}">
												<CheckBox.Style>
													<Style TargetType="CheckBox">
														<Setter Property="Visibility" Value="Collapsed"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding KindText}" Value="Bool">
																<Setter Property="Visibility" Value="Visible"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</CheckBox.Style>
											</CheckBox>
											<ComboBox ItemsSource="{Binding EnumValues}" Text="{Binding Value, Mode=TwoWay}" IsEditable="True" Width="180">
												<ComboBox.Style>
													<Style TargetType="ComboBox">
														<Setter Property="Visibility" Value="Collapsed"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding KindText}" Value="Enum">
																<Setter Property="Visibility" Value="Visible"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</ComboBox.Style>
											</ComboBox>
											<TextBox Text="{Binding Value, Mode=TwoWay}" Width="180">
												<TextBox.Style>
													<Style TargetType="TextBox">
														<Setter Property="Visibility" Value="Collapsed"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding KindText}" Value="Integer">
																<Setter Property="Visibility" Value="Visible"/>
															</DataTrigger>
															<DataTrigger Binding="{Binding KindText}" Value="Text">
																<Setter Property="Visibility" Value="Visible"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBox.Style>
											</TextBox>
										</Grid>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>
							<GridViewColumn Width="32">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<Button Content="✕" Padding="2" Click="RemovePropertyButton_Click" Tag="{Binding}"/>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>
						</GridView>
					</ListView.View>
				</ListView>
			</Grid>

			<!-- Details panel -->
			<StackPanel Grid.Column="2" Margin="8,0,0,0">
				<TextBlock Text="Details" FontWeight="Bold" Margin="0,0,0,8"/>
				<TextBlock x:Name="detailsTitleText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
				<TextBlock x:Name="detailsDefaultText" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7"/>
				<TextBlock x:Name="detailsDescriptionText" TextWrapping="Wrap"/>
			</StackPanel>
		</Grid>

		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
			<TextBlock Text="Add Property:" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<ComboBox x:Name="addPropertyComboBox" Width="220" DisplayMemberPath="Title"/>
			<Button Content="Add" Padding="8,2" Margin="8,0,0,0" Click="AddPropertyButton_Click"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="cancelButton" Content="Cancel" Padding="12,4" IsCancel="True" Click="CancelButton_Click"/>
			<Button x:Name="saveButton" Content="Save" Padding="12,4" Margin="8,0,0,0" IsDefault="True" Click="SaveButton_Click"/>
		</StackPanel>
	</Grid>
</Window>
