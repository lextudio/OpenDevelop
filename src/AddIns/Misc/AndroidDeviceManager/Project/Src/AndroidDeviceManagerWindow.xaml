<Window x:Class="ICSharpCode.AndroidDeviceManager.AndroidDeviceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
        Title="{core:Localize AndroidDeviceManager.Title}"
        Height="480" Width="760"
        WindowStartupLocation="CenterOwner">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
			<Button x:Name="createButton" Content="+ Create Device..." Padding="8,4" Click="CreateButton_Click"/>
			<Button x:Name="startButton" Content="{core:Localize AndroidDeviceManager.Start}" Padding="8,4" Margin="8,0,0,0" Click="StartButton_Click"/>
			<Button x:Name="editButton" Content="{core:Localize AndroidDeviceManager.Edit}" Padding="8,4" Margin="8,0,0,0" Click="EditButton_Click"/>
			<Button x:Name="deleteButton" Content="{core:Localize AndroidDeviceManager.Delete}" Padding="8,4" Margin="8,0,0,0" Click="DeleteButton_Click"/>
			<Button x:Name="refreshButton" Content="{core:Localize AndroidDeviceManager.Refresh}" Padding="8,4" Margin="8,0,0,0" Click="RefreshButton_Click"/>
		</StackPanel>

		<ListView x:Name="avdListView" Grid.Row="1">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="{core:Localize AndroidDeviceManager.Name}" Width="220" DisplayMemberBinding="{Binding Name}"/>
					<GridViewColumn Header="{core:Localize AndroidDeviceManager.Device}" Width="160" DisplayMemberBinding="{Binding Device}"/>
					<GridViewColumn Header="{core:Localize AndroidDeviceManager.Target}" Width="180" DisplayMemberBinding="{Binding Target}"/>
					<GridViewColumn Header="{core:Localize AndroidDeviceManager.BasedOn}" Width="180" DisplayMemberBinding="{Binding BasedOn}"/>
				</GridView>
			</ListView.View>
		</ListView>
	</Grid>
</Window>
