<AddIn name="Android Device Manager"
       author="OpenDevelop"
       description="Android emulator support for the shared Device Manager: lists, starts, stops and deletes AVDs via the Android command-line tools, and hosts the AVD editor that creates and edits them."
       addInManagerHidden="preinstalled">

	<Manifest>
		<Identity name="ICSharpCode.AndroidDeviceManager" version="@AndroidDeviceManager.dll" />
	</Manifest>

	<Runtime>
		<Import assembly="AndroidDeviceManager.dll"/>
	</Runtime>

	<!-- Autostart: register the provider so every designer and the Device Manager see AVDs without any window opened first. -->
	<Path name="/SharpDevelop/Autostart">
		<Class id="AndroidDeviceProviderRegistration"
		       class="ICSharpCode.AndroidDeviceManager.RegisterDeviceProviderCommand"/>
	</Path>
</AddIn>
