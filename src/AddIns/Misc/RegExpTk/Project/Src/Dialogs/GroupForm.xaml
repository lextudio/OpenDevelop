<Window x:Class="Plugins.RegExpTk.GroupForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core"
        Title="{core:Localize RegExpTk.GroupForm.Title}" Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{x:Null}">
  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListView Grid.Row="0" x:Name="groupsListView"
              Margin="0,0,0,6">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{core:Localize RegExpTk.Value}" Width="250" DisplayMemberBinding="{Binding Value}" />
          <GridViewColumn Header="{core:Localize RegExpTk.Index}" Width="80" DisplayMemberBinding="{Binding Index}" />
          <GridViewColumn Header="{core:Localize RegExpTk.End}" Width="80" DisplayMemberBinding="{Binding End}" />
          <GridViewColumn Header="{core:Localize RegExpTk.Length}" Width="80" DisplayMemberBinding="{Binding Length}" />
        </GridView>
      </ListView.View>
    </ListView>

    <Button Grid.Row="1" Content="{core:Localize Global.Close}" Width="80" Height="24"
            HorizontalAlignment="Right" Click="CloseButton_Click" />
  </Grid>
</Window>
