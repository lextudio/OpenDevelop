<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcessDependency</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.PackageManagement.PowerShell</RootNamespace>
    <AssemblyName>PackageManagement.PowerShell</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <OutputPath>..\..\..\..\..\..\AddIns\Misc\PackageManagement\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <!-- Microsoft.PowerShell.SDK 7.4.0 pulls System.Data.SqlClient 4.8.5 (NU1903, GHSA-98g6-xh36-x2p7).
         Pin the patched 4.8.6 to override the transitive vulnerable version. -->
    <PackageReference Include="System.Data.SqlClient" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\BackendBindings\Scripting\Project\ICSharpCode.Scripting.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <!-- See PackageManagement.csproj: Private=false doesn't stop transitive projects' own .addin
       manifests (e.g. via Scripting -> UnitTesting) from leaking into this shared output folder.
       This project has no manifest of its own; keep only PackageManagement.addin, which also
       builds into this same OutDir and owns it. -->
  <Target Name="RemoveForeignAddinManifests" AfterTargets="Build">
    <ItemGroup>
      <_ForeignAddinManifest Include="$(OutDir)*.addin" Exclude="$(OutDir)PackageManagement.addin" />
    </ItemGroup>
    <Delete Files="@(_ForeignAddinManifest)" />
  </Target>
</Project>
