<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.PackageManagement.Cmdlets</RootNamespace>
    <AssemblyName>PackageManagement.Cmdlets</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <OutputPath>..\..\..\..\..\..\AddIns\Misc\PackageManagement\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NuGet.Core">
      <HintPath>..\..\RequiredLibraries\NuGet.Core.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.4" />
    <!-- Microsoft.PowerShell.SDK 7.6.x pulls System.Data.SqlClient 4.9.1 transitively, which is
         patched (no NU1903) - so the previous explicit 4.8.6 pin is no longer needed. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Project\PackageManagement.csproj" Private="false" />
    <ProjectReference Include="..\..\SharpDevelop.EnvDTE\SharpDevelop.EnvDTE.vbproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <!-- See PackageManagement.csproj: Private=false doesn't stop transitive projects' own .addin
       manifests from leaking into this shared output folder. This project has no manifest of its
       own; keep only PackageManagement.addin, which also builds into this same OutDir and owns it. -->
  <Target Name="RemoveForeignAddinManifests" AfterTargets="Build">
    <ItemGroup>
      <_ForeignAddinManifest Include="$(OutDir)*.addin" Exclude="$(OutDir)PackageManagement.addin" />
    </ItemGroup>
    <Delete Files="@(_ForeignAddinManifest)" />
  </Target>
</Project>
