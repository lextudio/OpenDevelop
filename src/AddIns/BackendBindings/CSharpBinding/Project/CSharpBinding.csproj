<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CSharpBinding</RootNamespace>
    <AssemblyName>CSharpBinding</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <OutputPath>..\..\..\..\..\AddIns\BackendBindings\CSharpBinding\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <!-- Minimal ownership-correct slice (doc/technotes/csharp-vb-binding.md Phase 0). Everything else
       under Src/ (Completion, Refactoring, FormattingStrategy, Parser, CSharpSemanticHighlighter,
       CSharpTextEditorExtension, FormsDesigner, OptionPanels) is NRefactory-based and excluded here,
       not deleted - it's deferred to later migration phases. -->
  <ItemGroup>
    <Compile Include="Src\CSharpLanguageBinding.cs" />
    <Compile Include="Src\CSharpProjectBinding.cs" />
    <Compile Include="Src\RegisterCSharpLanguageServiceCommand.cs" />
    <Compile Include="Src\RegisterCSharpOpenLensProvidersCommand.cs" />
    <Compile Include="Src\Project\CSharpProject.cs" />
    <Compile Include="..\..\..\..\Main\GlobalAssemblyInfo.cs" Link="Configuration\GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CSharpBinding.addin" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="Resources\CSharp-Semantic.xshd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\Libraries\ICSharpCode.TypeSystem.Abstractions\ICSharpCode.TypeSystem.Abstractions.csproj" Private="false" />
  </ItemGroup>
</Project>
