<AddIn name        = "C# Binding"
       author      = "Mike Krueger"
       copyright   = "prj:///doc/copyright.txt"
       description = "Backing binding for C#"
       addInManagerHidden = "preinstalled">

	<!-- Minimal ownership-correct slice - see doc/technotes/csharp-vb-binding.md Phase 0. This
	     addin now owns .cs/.csproj identity and the Roslyn Parser/CodeCompletionBinding
	     registrations that used to live in AvalonEdit.AddIn.addin. Everything NRefactory-based
	     (Completion/Refactoring/FormattingStrategy/Semantic Highlighting/IssueProviders/
	     ContextActions/WinForms Designer) is deferred to later phases - see doc for the full list. -->
	<Manifest>
		<Identity name = "ICSharpCode.CSharpBinding"/>
	</Manifest>

	<Runtime>
		<Import assembly = "CSharpBinding.dll"/>
		<Import assembly = ":ICSharpCode.SharpDevelop"/>
	</Runtime>

	<Path name = "/SharpDevelop/Workbench/DisplayBindings">
		<!-- WinForms Designer for .cs was listed as a Phase 5 deferred item (see
		     doc/technotes/csharp-vb-binding.md's "Migration phases"/"Definition of done") because
		     the original FormsDesignerSecondaryDisplayBinding/CSharpDesignerLoaderProvider
		     (Src/FormsDesigner/, excluded from this project's Compile items - see the comment
		     above) depend on the old NRefactory-based SD.ParserService, which this csproj no
		     longer compiles at all. RoslynFormsDesignerSecondaryDisplayBinding is a new,
		     Roslyn-based replacement (bounded scope: it only translates the small subset of C#
		     shapes real designer-generated InitializeComponent methods use - see
		     RoslynToCodeDomTranslator.cs's own doc comment). -->
		<DisplayBinding id="WinFormsDesigner"
		                type="Secondary"
		                class="CSharpBinding.FormsDesigner.RoslynFormsDesignerSecondaryDisplayBinding"
		                fileNamePattern="\.cs$" />
	</Path>

	<Path name = "/SharpDevelop/MSBuildEngine/CompileTaskNames">
		<!-- Makes SharpDevelop show the text 'Compiling ProjectName...' when the task is started -->
		<String id="csc" text = "csc"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/FileFilter">
		<FileFilter id = "C#"
		            insertbefore="AllFiles"
		            name = "${res:SharpDevelop.FileFilter.CSharpFiles}"
		            extensions = "*.cs"
		            mimeType = "text/plain"/>
	</Path>

	<Path name = "/SharpDevelop/Workbench/Combine/FileFilter">
		<FileFilter id         = "CSharpProject"
		            insertbefore="AllFiles"
		            name       = "${res:SharpDevelop.FileFilter.CSharpPrjFiles} (*.csproj)"
		            extensions = "*.csproj"/>
	</Path>

	<!-- Real (Roslyn-backed) language service for .cs - moved here from AvalonEdit.AddIn.addin so
	     disabling this addin actually stops C# parsing/completion. Same RoslynParser/
	     RoslynCodeCompletionBinding classes VBBinding.addin uses for .vb. -->
	<Path name = "/SharpDevelop/Parser">
		<Parser id    = "C#-Roslyn"
		        supportedfilenamepattern="\.cs$"
		        class = "ICSharpCode.SharpDevelop.Roslyn.RoslynParser" />
	</Path>

	<Path name = "/SharpDevelop/ViewContent/TextEditor/CodeCompletion">
		<CodeCompletionBinding id = "C#-Roslyn" extensions = ".cs" class = "ICSharpCode.SharpDevelop.Roslyn.RoslynCodeCompletionBinding"/>
	</Path>

	<Path name="/SharpDevelop/Autostart">
		<Class id="CSharpLanguageService" class="CSharpBinding.RegisterCSharpLanguageServiceCommand"/>
		<Class id="CSharpOpenLensProviders" class="CSharpBinding.RegisterCSharpOpenLensProvidersCommand"/>
	</Path>

	<Path name = "/SharpDevelop/BackendBindings/Templates">
		<!-- The contents of the template categories is provided by the data/templates folder
			in which SharpDevelop looks by default. We explicitly list the category only in order to assign
			the sortOrder.
		-->
		<TemplateCategory id = "C#">
			<TemplateCategory id = "${res:Templates.File.Categories.WindowsApplications}" sortOrder="10" />
		</TemplateCategory>
	</Path>

	<Path name="/SharpDevelop/Workbench/LanguageBindings">
		<LanguageBinding
			id="CSharp"
			class="CSharpBinding.CSharpLanguageBinding"
			extensions=".cs" />
	</Path>

	<Path name = "/SharpDevelop/ViewContent/AvalonEdit/SyntaxModes">
		<SyntaxMode id="C#" name="C#" extensions=".cs" resource="CSharpBinding.Resources.CSharp-Semantic.xshd" />
	</Path>

	<Path path = "/SharpDevelop/BackendBindings/ProjectOptions/C#">
		<OptionPanel id    = "Application"
		             label = "${res:Dialog.ProjectOptions.ApplicationSettings}"
		             class = "ICSharpCode.SharpDevelop.Gui.OptionPanels.ApplicationSettings"/>
		<OptionPanel id    = "ReferencePaths"
		             label = "${res:Dialog.ProjectOptions.ReferencePaths}"
		             class = "ICSharpCode.SharpDevelop.Gui.OptionPanels.ReferencePaths"/>
		<OptionPanel id    = "Signing"
		             label = "${res:Dialog.ProjectOptions.Signing}"
		             class = "ICSharpCode.SharpDevelop.Gui.OptionPanels.Signing"/>
		<OptionPanel id    = "BuildEvents"
		             label = "${res:Dialog.ProjectOptions.BuildEvents}"
		             class = "ICSharpCode.SharpDevelop.Gui.OptionPanels.BuildEvents"/>
		<OptionPanel id    = "DebugOptions"
		             label = "${res:Dialog.ProjectOptions.DebugOptions}"
		             class = "ICSharpCode.SharpDevelop.Gui.OptionPanels.DebugOptions"/>
		<OptionPanel id    = "AssemblyInfo"
		             label = "${res:Dialog.ProjectOptions.AssemblyInfo}"
		             class = "ICSharpCode.SharpDevelop.Gui.OptionPanels.AssemblyInfoPanel"/>
		<Include id = "AllManaged" path="/SharpDevelop/BackendBindings/ProjectOptions/AllManaged"/>
	</Path>

	<Path name = "/Workspace/Icons">
		<!-- C# -->
		<Icon id         = "C#Prj"
		      language   = "C#"
		      resource   = "C#.ProjectIcon"/>

		<Icon id         = "C#File"
		      extensions = ".cs"
		      resource   = "C#.FileIcon"/>
	</Path>

	<Path path = "/SharpDevelop/Workbench/ProjectBindings">
		<ProjectBinding id                   = "C#"
		                guid                 = "{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}"
		                supportedextensions  = ".cs"
		                projectfileextension = ".csproj"
		                class                = "CSharpBinding.CSharpProjectBinding" />
	</Path>
</AddIn>
