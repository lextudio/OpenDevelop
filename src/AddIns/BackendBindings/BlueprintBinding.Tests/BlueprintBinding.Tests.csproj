<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The locator and the compiler runner are pure (no IDE services), so they are tested here; a test that needs the real
         blueprint-compiler skips itself when none is installed. -->
    <Compile Include="..\BlueprintBinding\BlueprintCompilerLocator.cs" Link="BlueprintCompilerLocator.cs" />
    <Compile Include="..\BlueprintBinding\BlueprintCompiler.cs" Link="BlueprintCompiler.cs" />
  </ItemGroup>
</Project>
