<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <!-- Keep this sample a real Uno project: the language server needs the Uno metadata closure,
         not merely a package name, to answer completion and hover requests. -->
    <TargetFramework>net10.0-desktop</TargetFramework>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
  </PropertyGroup>
  <!-- Device previews: the iOS Simulator and Android emulator journeys share this project. The Uno designer offers a
       device only when the project file names that platform's TFM, and ProjectTargets reads TargetFramework(s) from the
       XML while ignoring conditions, so these are visible to the designer even though no build evaluates them: a normal
       build stays desktop-only and needs no mobile workload. -->
  <PropertyGroup Condition="'$(EnableDevicePreviews)' == '1'">
    <TargetFrameworks>net10.0-ios;net10.0-android;net10.0-desktop</TargetFrameworks>
  </PropertyGroup>
</Project>
