<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <!-- Keep this sample a real Uno project: the language server needs the Uno metadata closure,
         not merely a package name, to answer completion and hover requests. -->
    <TargetFramework>net10.0-desktop</TargetFramework>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
  </PropertyGroup>
</Project>
