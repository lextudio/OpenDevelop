<AddIn name        = "NRConsistencyCheck"
       author      = "Daniel Grunwald"
       url         = ""
       description = "TODO: Put description here">
	
	<Runtime>
		<Import assembly = "NRConsistencyCheckAddIn.dll"/>
	</Runtime>
	
	<Path name="/SharpDevelop/Workbench/Tools">
		<MenuItem id="NR Consistency Check"
		          type="Menu"
		          label="${res:NRConsistencyCheck.Menu.Title}">
			<MenuItem label="${res:NRConsistencyCheck.RunAllTests}" class="ICSharpCode.NRefactory.ConsistencyCheck.RunAllTestsCommand" />
			<MenuItem label="${res:NRConsistencyCheck.ResolverTest}" class="ICSharpCode.NRefactory.ConsistencyCheck.ResolverTestCommand" />
			<MenuItem label="${res:NRConsistencyCheck.ResolverTestNoUnresolvedFile}" class="ICSharpCode.NRefactory.ConsistencyCheck.ResolverTestWithoutUnresolvedFileCommand" />
			<MenuItem label="${res:NRConsistencyCheck.ResolverTestRandomizedOrder}" class="ICSharpCode.NRefactory.ConsistencyCheck.ResolverTestRandomizedOrderCommand" />
		</MenuItem>
	</Path>
</AddIn>
