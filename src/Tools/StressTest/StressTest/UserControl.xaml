<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="StressTest.UserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="http://icsharpcode.net/sharpdevelop/core">
	<ScrollViewer>
		<StackPanel>
			<StackPanel Orientation="Horizontal"><Label>Repetitions:</Label><TextBox Name="repetitionsTextBox" Text="1" Width="40"/></StackPanel>
			<Expander Header="{core:Localize StressTest.Editor}" IsExpanded="True">
				<StackPanel>
					<Button
						Content="{core:Localize StressTest.OpenFile}"
						Height="23"
						Click="openFileButton_Click" />
					<StackPanel Orientation="Horizontal">
						<TextBox Name="typeCommentTextBox">This is a comment</TextBox>
						<Button
							Content="{core:Localize StressTest.TypeComment}"
							Height="23"
							Click="TypeTextButton_Click" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<CheckBox Name="eraseTextBackwards">Backwards</CheckBox>
						<Button
							Content="{core:Localize StressTest.EraseText}"
							Height="23"
							Click="EraseTextButton_Click" />
					</StackPanel>
					<Button
						Content="{core:Localize StressTest.Typing}"
						Height="23"
						Click="TypeCodeButton_Click" />
				</StackPanel>
			</Expander>
			<Expander Header="{core:Localize StressTest.Workbench}" IsExpanded="True">
				<StackPanel>
					<Button
						Content="{core:Localize StressTest.SwitchLayout}"
						Height="23"
						Click="SwitchLayoutButton_Click" />
				</StackPanel>
			</Expander>
		</StackPanel>
	</ScrollViewer>
</UserControl>