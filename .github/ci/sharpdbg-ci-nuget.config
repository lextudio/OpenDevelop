<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore configuration for the SharpDbg adapter that OpenDevelop builds out of externals/sharpdbg.

  SharpDbg's own nuget.config clears the source list and keeps only nuget.org plus OpenDevelop's local
  feed (artifacts/openavalon-feed). That is right on a developer machine, where sync-openavalon-feed.ps1
  fills the feed, but a CI checkout has no feed. The adapter now uses lextudio's OmniSharp DAP fork, and
  OpenDevelop's NuGet.config maps OmniSharp.Extensions.* to that feed, so the nested `dotnet build` in
  Debugger.AddIn's BuildSharpDbg target failed with NU1101.

  In GitHub Actions Debugger.AddIn passes this file with -p:RestoreConfigFile, and the workflow's
  NuGetPackageSourceCredentials_lextudio_github variable authenticates the GitHub Packages source with
  the job token. Local builds keep using SharpDbg's own configuration and the local feed.

  Keep the patterns in step with the lextudio_github block of OpenDevelop's NuGet.config; the Android
  agent action writes the same source list for the same reason.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="lextudio_github" value="https://nuget.pkg.github.com/lextudio/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="lextudio_github">
      <package pattern="OmniSharp.Extensions.*" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
