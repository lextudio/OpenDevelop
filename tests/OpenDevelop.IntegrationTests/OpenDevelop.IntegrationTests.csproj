<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end integration tests that launch OpenDevelop and drive it over the DevFlow REST API
       (port 9223 by default, overridable via DEVFLOW_AGENT_PORT).

       OpenDevelop must be built in Debug before running:
         dotnet build src/Main/SharpDevelop/SharpDevelop.csproj -c Debug

       Then run the suite explicitly (slow, boots the full app). This is an xunit.v3, Microsoft.Testing.Platform
       project, so the build output is itself a self-testing executable: "dotnet run" works directly,
       no VSTest host needed (plain "dotnet test" still works too, via TestingPlatformDotnetTestSupport):
         dotnet run "-project" tests/OpenDevelop.IntegrationTests "-no-build"
         (i.e. dotnet run with the usual double-hyphen project/no-build switches)

       All test classes share ONE assembly-level OpenDevelopAppFixture: one SharpDevelop process and
       one DevFlow port. Named collections plus the assembly orderers in AssemblyInfo.cs guarantee a
       stable fixture-oriented sequence even for filtered runs. Don't run two invocations of this
       project at the same time; they would both try to own the same DevFlow port. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3's runner is Microsoft.Testing.Platform-native: the build output is a
         self-testing executable runnable directly via `dotnet run`. This flag keeps
         `dotnet test` working too (it shells out to the same MTP executable). -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- AltCover.targets (in the AltCover package) only imports its instrumentation logic when
         IsTestProject is true - a property VSTest-era test SDKs set automatically but that this
         MTP-native project (no Microsoft.NET.Test.Sdk reference) never sets on its own. See
         AltCover.Mtp.targets for the rest of the MTP-compatibility wiring. -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Code coverage: run
         dotnet build -t:Coverage -p:AltCover=true -p:AltCoverInPlace=true
       Do NOT use "dotnet test /p:AltCover=true" - it collides with this project's own MTP test
       target ("VSTest" is owned by two competing packages here); see AltCover.Mtp.targets for the
       full explanation and the "Coverage" target this actually runs. Produces coverage.xml
       (OpenCover format) and coverage.cobertura.xml in this project's directory. -->
  <PropertyGroup Condition="'$(AltCover)' == 'true'">
    <AltCoverReport>$(MSBuildProjectDirectory)/coverage.xml</AltCoverReport>
    <AltCoverCobertura>$(MSBuildProjectDirectory)/coverage.cobertura.xml</AltCoverCobertura>
    <AltCoverAssemblyExcludeFilter>xunit|AltCover\.|Microsoft\.|System\.</AltCoverAssemblyExcludeFilter>
    <AltCoverShowSummary>Foreground</AltCoverShowSummary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AltCover" />
  </ItemGroup>

  <!-- These designers deploy outside the host app's output tree. Build them with the
       integration runner so a filtered designer test can never launch stale addin DLLs.
       This used to be Condition="false"; while it was disabled the five GtkDesigner_*/
       MewUIDesigner_* tests could only ever fail with od.gtk-designer.status /
       od.mewui-designer.status 404 (the addin, and therefore its DevFlow actions, was never
       deployed) - a symptom that reads like a missing action rather than a missing build. -->
  <ItemGroup>
    <_DesignerAddinProject Include="../../src/AddIns/DisplayBindings/GtkDesigner/GtkDesigner.csproj" />
    <_DesignerAddinProject Include="../../src/AddIns/DisplayBindings/MewUIDesigner/MewUIDesigner.csproj" />
  </ItemGroup>
  <Target Name="BuildDesignerAddinsForIntegrationTests" BeforeTargets="Build">
    <MSBuild Projects="@(_DesignerAddinProject)" Targets="Build" BuildInParallel="true"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
  </Target>

  <!-- Same deal for the language-service addins: FSharpBinding.csproj deploys its LSP-backed
       backend to AddIns/BackendBindings/FSharpBinding/, and AvalonEdit.AddIn.csproj deploys the
       generic text-editor DisplayBinding to AddIns/DisplayBindings/AvalonEdit/ (which is what
       actually attaches any language service's completion/format/diagnostics binding to a real
       editor view - without it, files fall back to an empty SimpleViewContent and every
       language-service test looks like "the LSP isn't available" when it's really just an
       undeployed addin). SharpDevelop.csproj doesn't reference either as a ProjectReference
       since they're runtime-discovered plugins, not compile-time dependencies - so building
       only the main app never produces them. Build them here so a filtered language-service
       test run never launches against a stale/missing addin. -->
  <ItemGroup>
    <_LanguageAddinProject Include="../../src/AddIns/BackendBindings/FSharpBinding/FSharpBinding.csproj" />
    <_LanguageAddinProject Include="../../src/AddIns/DisplayBindings/AvalonEdit.AddIn/AvalonEdit.AddIn.csproj" />
    <!-- RegisterDevFlowActionsCommand (WinUIXamlDesigner.AddIn) resolves these two in-process
         runtime-host bootstraps via Type.GetType("...,AssemblyName") at startup, which only
         succeeds if the named assembly already sits deployed next to the addin's own DLL - and
         WinUIXamlDesigner.AddIn.csproj does not reference either as a ProjectReference (they are
         runtime-discovered plugins, exactly like FSharpBinding/AvalonEdit above). Without
         ProGPUHost in particular, EVERY WinUI/Uno document fails with "runtime host is not
         installed", including Uno ones - ProGPU is supposed to be the always-available fallback
         when the out-of-process Uno/Microsoft children aren't deployed, but it can't fall back if
         it was never registered in the first place. -->
    <_LanguageAddinProject Include="../../src/AddIns/DisplayBindings/WinUIXamlDesigner/WinUIXamlDesigner.ProGPUHost/ICSharpCode.WinUIXamlDesigner.ProGPUHost.csproj" />
    <_LanguageAddinProject Include="../../src/AddIns/DisplayBindings/WinUIXamlDesigner/WinUIXamlDesigner.UnoDesignHost/ICSharpCode.WinUIXamlDesigner.UnoDesignHost.csproj" />
    <!-- VBBinding.vbproj deploys to AddIns/BackendBindings/VBBinding/ - without it, every VB.NET
         language-service test fails with "no language service for file" instead of exercising
         anything, for the same undeployed-addin reason as FSharpBinding above. -->
    <_LanguageAddinProject Include="../../src/AddIns/BackendBindings/VBBinding/Project/VBBinding.vbproj" />
  </ItemGroup>
  <Target Name="BuildLanguageAddinsForIntegrationTests" BeforeTargets="Build">
    <MSBuild Projects="@(_LanguageAddinProject)" Targets="Build" BuildInParallel="true"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
  </Target>

  <!-- The WinForms and WinUI/Uno designers render through out-of-process child hosts that are
       separate deployables from their addin's own DLL (they self-copy into a subfolder next to
       it via each project's own DeployToAddIns target). Without them, every designer test fails at
       the point it waits for a real render - "The out-of-process WinForms designer is not loaded"
       / "WinUI/Uno runtime host is not installed" - which reads like a runtime/rendering bug but
       is really just a missing build step, exactly like the language addins above. The Microsoft
       WinUI child (WinUIXamlDesigner.MicrosoftHost) is intentionally not built here - it requires
       VS's MSBuild for its UseWinUI/PRI toolchain (see the repo's WinUI section for the
       Windows-only build command) and only matters for WinUIOnly_*/DesignerBackend=Microsoft
       tests, not the cross-platform Uno/LibreWinForms path this project builds by default. -->
  <ItemGroup>
    <_OutOfProcessHostProject Include="../../src/AddIns/DisplayBindings/FormsDesigner/Host/FormsDesigner.Host.csproj" />
    <_OutOfProcessHostProject Include="../../src/AddIns/DisplayBindings/WinUIXamlDesigner/WinUIXamlDesigner.UnoHost/WinUIXamlDesigner.UnoHost.csproj" />
  </ItemGroup>
  <Target Name="BuildOutOfProcessHostsForIntegrationTests" BeforeTargets="Build">
    <MSBuild Projects="@(_OutOfProcessHostProject)" Targets="Build" BuildInParallel="true"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
  </Target>

  <!-- The rest of the addins this suite's tests actually exercise, none referenced as
       ProjectReferences by SharpDevelop.csproj for the same runtime-discovered-plugin reason as
       every group above - on a checkout where only the main app was ever built, their tests fail
       with symptoms that read like real bugs (e.g. "no language service for file" for C#,
       AddInsList_ContainsGitAddIn / UnitTestingService_IsAvailable coming back empty, a WPF/ILSpy/
       NuGet/ASP.NET Core pad never appearing) but are really just this same missing-deployment
       problem. Deliberately NOT the whole solution: this repo also carries a number of legacy
       net45-targeting addins (Reporting, Data/EDMDesigner, Profiler, MachineSpecifications,
       CodeAnalysis, AspNet.Mvc, ...) that were never migrated and fail NU1201 against the
       modernized net10.0 Core/Base projects - only add a project here once a test actually needs
       it. -->
  <ItemGroup>
    <_CoreAddinProject Include="../../src/AddIns/BackendBindings/CSharpBinding/Project/CSharpBinding.csproj" />
    <_CoreAddinProject Include="../../src/AddIns/VersionControl/GitAddIn/GitAddIn.csproj" />
    <_CoreAddinProject Include="../../src/AddIns/Analysis/UnitTesting/UnitTesting.csproj" />
    <_CoreAddinProject Include="../../src/AddIns/DisplayBindings/ClassDiagram/ClassDiagramAddin/ClassDiagramAddin.csproj" />
    <_CoreAddinProject Include="../../src/AddIns/DisplayBindings/WpfDesign/WpfDesign.AddIn/WpfDesign.AddIn.csproj" />
    <_CoreAddinProject Include="../../src/AddIns/DisplayBindings/ILSpyAddIn/ILSpyAddIn.csproj" />
    <_CoreAddinProject Include="../../src/AddIns/Misc/PackageManagement/Project/PackageManagement.csproj" />
    <_CoreAddinProject Include="../../src/AddIns/BackendBindings/AspNetCore/Binding/AspNetCore.AddIn.csproj" />
    <!-- XamlBinding owns od.xaml-outline.status (XamlOutlineDevFlowActions) and the XAML outline
         the WPF/XAML tests inspect; undeployed, that action 404s rather than failing an
         assertion. -->
    <_CoreAddinProject Include="../../src/AddIns/BackendBindings/XamlBinding/XamlBinding/XamlBinding.csproj" />
    <!-- SearchAndReplace owns od.search.find/od.search.replace, which the designer tests use to
         edit XAML source from outside the designer. -->
    <_CoreAddinProject Include="../../src/AddIns/Misc/SearchAndReplace/Project/SearchAndReplace.csproj" />
    <!-- CodeCoverage provides ICodeCoverageService; undeployed, its three tests report
         "CodeCoverage addin not available" rather than exercising a coverage run. -->
    <_CoreAddinProject Include="../../src/AddIns/Analysis/CodeCoverage/Project/CodeCoverage.csproj" />
  </ItemGroup>
  <Target Name="BuildCoreAddinsForIntegrationTests" BeforeTargets="Build">
    <MSBuild Projects="@(_CoreAddinProject)" Targets="Build" BuildInParallel="true"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
  </Target>

  <!-- Fixture apps that tests assert are ALREADY built (they run/decompile the real output rather
       than just reading source): DebugTestApp is loaded as an assembly by the ILSpy tests, and
       SampleTestProject's test assembly is executed by the unit-test-runner tests. Nothing else
       builds them, so on a fresh checkout those tests fail with "expected the fixture to already
       be built" / "Can't execute ...dll" - which reads like a product bug rather than a missing
       prerequisite. -->
  <ItemGroup>
    <_FixtureProject Include="../fixtures/DebugTestApp/DebugTestApp.csproj" />
    <_FixtureProject Include="../fixtures/SampleTestProject/SampleTestProject.csproj" />
  </ItemGroup>
  <!-- Restored in its own MSBuild invocation before Build: unlike the addin projects above these
       are standalone (deliberately outside the solution, since the IDE under test opens them as
       user projects), so nothing has ever restored them and Build alone fails with NETSDK1004. -->
  <Target Name="BuildFixturesForIntegrationTests" BeforeTargets="Build">
    <MSBuild Projects="@(_FixtureProject)" Targets="Restore" BuildInParallel="true"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
    <MSBuild Projects="@(_FixtureProject)" Targets="Build" BuildInParallel="true"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
  </Target>

  <!-- The NuGet addin tests install a package from an offline feed, which means the feed needs a
       real .nupkg in it: OpenDevelopAppFixture.LocateLocalNuGetFeed looks for
       tests/fixtures/LocalNuGetFeed/OpenDevelop.TestPackage.1.0.0.nupkg. Pack the fixture's own
       source project straight into the feed directory - nothing else produces that file, so both
       NuGet tests otherwise fail on a missing fixture rather than on the flow they test. -->
  <Target Name="PackLocalNuGetFeedFixture" BeforeTargets="Build"
          Inputs="../fixtures/LocalNuGetFeed/PackageSource/OpenDevelop.TestPackage.csproj"
          Outputs="../fixtures/LocalNuGetFeed/OpenDevelop.TestPackage.1.0.0.nupkg">
    <MSBuild Projects="../fixtures/LocalNuGetFeed/PackageSource/OpenDevelop.TestPackage.csproj"
             Targets="Restore" Properties="RestoreIgnoreFailedSources=true" />
    <MSBuild Projects="../fixtures/LocalNuGetFeed/PackageSource/OpenDevelop.TestPackage.csproj"
             Targets="Pack"
             Properties="Configuration=$(Configuration);PackageOutputPath=$(MSBuildProjectDirectory)/../fixtures/LocalNuGetFeed;RestoreIgnoreFailedSources=true" />
  </Target>

  <!-- One integration-test process owns one IDE process and drives all three Microsoft hosts.
       Keep this entry point in the test project (rather than a sidecar script) so the same
       fixture, artifacts and xUnit reporting are used in CI and locally. The backend choices
       are strict: WinForms opens only WinForms fixtures, WPF only WPF fixtures and WinUI only
       WinUI fixtures; none may fall back to Libre/Uno. -->
  <Target Name="RunMicrosoftDesignerIntegration" DependsOnTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="set &quot;OD_FORMS_RUNTIME=microsoft&quot; &amp;&amp; set &quot;OD_WPF_RUNTIME=microsoft&quot; &amp;&amp; set &quot;OD_WINUI_RUNTIME=microsoft&quot; &amp;&amp; dotnet &quot;$(TargetPath)&quot; -trait &quot;DesignerBackend=Microsoft&quot;" />
  </Target>

  <!-- Serialize test collections: every collection shares ONE assembly-scoped app process
       (port 9299) and the same on-disk fixture directories, so parallel collections race on
       both - e.g. one collection's od.build-solution observes another's ScratchBroken.cs, or
       two unit-test runs queue on the same TestService and blow the streaming-observation
       window. xUnit v3 defaults to parallelizeTestCollections=true; this restores v2-style
       serial collections (tests inside a collection were always serial). -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="AltCover.Mtp.targets" />

</Project>
