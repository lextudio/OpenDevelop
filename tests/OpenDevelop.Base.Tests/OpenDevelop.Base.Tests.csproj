<Project Sdk="LibreWPF.Sdk">

  <!-- Fast, in-process unit tests against ICSharpCode.SharpDevelop.dll (the "Base" project) -
       no app boot, no DevFlow REST API, unlike tests/OpenDevelop.IntegrationTests. Run with:
         dotnet test tests/OpenDevelop.Base.Tests
       or directly (xunit.v3 is Microsoft.Testing.Platform-native, so the build output is itself
       a self-testing executable):
         dotnet run "-project" tests/OpenDevelop.Base.Tests "-no-build" -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The resource payload rewriter is deliberately framework-independent. Link its source so
         the maintained Base test suite can exercise the exact implementation without loading the
         Forms designer add-in or a design host. -->
    <Compile Include="..\..\src\AddIns\DisplayBindings\FormsDesigner\Project\Src\Services\ResxImageResourceEditor.cs"
             Link="FormsDesigner\ResxImageResourceEditor.cs" />
    <ProjectReference Include="..\..\src\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" />
    <ProjectReference Include="..\..\src\Main\LanguageServices\Roslyn.Host\Roslyn.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\AddIns\Analysis\UnitTesting\UnitTesting.csproj" />
    <!-- The Hot Reload adapters live in their framework addins; the end-to-end tests drive them. -->
    <ProjectReference Include="..\..\src\AddIns\DisplayBindings\WpfDesign\WpfDesign.AddIn\WpfDesign.AddIn.csproj" />
    <ProjectReference Include="..\..\src\AddIns\DisplayBindings\WinUIXamlDesigner\WinUIXamlDesigner.AddIn\ICSharpCode.WinUIXamlDesigner.csproj" />
    <!-- Pure designer presentation logic (DesignerVerbMenuPlanner, ...), testable without booting
         any design surface. -->
    <ProjectReference Include="..\..\src\Main\Designer\Designer.Presentation\Designer.Presentation.csproj" />
  </ItemGroup>

  <Target Name="PrepareRoslynTestHost" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Main\LanguageServices\Roslyn.Host\Roslyn.Host.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_RoslynTestHostAssembly" />
    </MSBuild>
    <ItemGroup>
      <_RoslynTestHostFiles Include="%(_RoslynTestHostAssembly.RootDir)%(_RoslynTestHostAssembly.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RoslynTestHostFiles)"
          DestinationFiles="@(_RoslynTestHostFiles->'$(TargetDir)RoslynHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- The WPF Hot Reload test launches this fixture for real and hot-reloads it, so it needs the
       built application, not just its source. It is standalone (outside the solution) and nothing
       else builds it, so without this the test can only skip - and a test that silently never runs
       is worse than no test. Restored in its own invocation because a standalone project has never
       been restored and Build alone then fails with NETSDK1004. -->
  <ItemGroup>
    <_HotReloadFixtureProject Include="../fixtures/WpfHotReloadFixture/WpfHotReloadFixture.csproj" />
  </ItemGroup>
  <Target Name="BuildHotReloadFixture" BeforeTargets="Build">
    <MSBuild Projects="@(_HotReloadFixtureProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
    <MSBuild Projects="@(_HotReloadFixtureProject)" Targets="Build"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true" />
  </Target>

  <!-- The agent the test injects into the fixture. Built here rather than copied so the test runs
       against the same assembly the IDE deploys; it is handed to the fixture's runtime through
       DOTNET_STARTUP_HOOKS and is never loaded into the test host itself. -->
  <Target Name="BuildHotReloadAgentForTests" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/Main/HotReload/WpfHotReload.Agent/WpfHotReload.Agent.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <!-- The Microsoft WPF agent variant. Nothing else builds it, so a Windows run of the Hot Reload
       journey would otherwise find no agent to inject. Gated to Windows: on macOS/Linux only the
       LibreWPF variant can actually run, and building the Windows Desktop one there adds nothing
       (it still compiles locally via EnableWindowsTargeting when built directly). -->
  <Target Name="BuildMicrosoftHotReloadAgentForTests" BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/Main/HotReload/WpfHotReload.Agent.Microsoft/WpfHotReload.Agent.Microsoft.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <!-- WinUI Hot Reload: the agent (which also builds its native TAP for x86/x64/ARM64 through
       Visual Studio's MSBuild) and the fixture application, once per architecture this machine can
       run - ARM64 Windows runs all three, x64 Windows runs x64 and x86. Windows only: WinUI does
       not run anywhere else, and WinUIHotReloadEndToEndTests skips there. -->
  <PropertyGroup>
    <_HostIsArm64>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().Equals('Arm64'))</_HostIsArm64>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <_WinUIHotReloadFixtureArch Include="x64" Rid="win-x64" />
    <_WinUIHotReloadFixtureArch Include="x86" Rid="win-x86" />
    <_WinUIHotReloadFixtureArch Include="ARM64" Rid="win-arm64" Condition="'$(_HostIsArm64)' == 'true'" />
  </ItemGroup>
  <Target Name="BuildWinUIHotReloadForTests" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/Main/HotReload/WinUIHotReload.Agent/WinUIHotReload.Agent.csproj"
             Targets="Restore" Properties="Configuration=$(Configuration);_RestoreOnly=true" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/Main/HotReload/WinUIHotReload.Agent/WinUIHotReload.Agent.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="../fixtures/WinUIHotReloadFixture/WinUIHotReloadFixture.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);RestoreIgnoreFailedSources=true;_RestoreOnly=true" />
    <MSBuild Projects="../fixtures/WinUIHotReloadFixture/WinUIHotReloadFixture.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);Platform=%(_WinUIHotReloadFixtureArch.Identity);RuntimeIdentifier=%(_WinUIHotReloadFixtureArch.Rid)" />
  </Target>

  <Target Name="RemoveDesktopRuntimeFramework" AfterTargets="ProcessFrameworkReferences" BeforeTargets="FixupRuntimeFrameworkVersions">
    <ItemGroup>
      <RuntimeFramework Remove="@(RuntimeFramework)" Condition="'%(RuntimeFramework.Identity)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveTransitiveDesktopFramework" AfterTargets="ResolvePackageAssets" BeforeTargets="AddTransitiveFrameworkReferences">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="@(TransitiveFrameworkReference)" Condition="'%(TransitiveFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
  </Target>

</Project>
