<Project>
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <Configuration>Debug</Configuration>
    <TestRoot>$(MSBuildThisFileDirectory)obj/sdk-test/</TestRoot>
    <OutputPath>$(TestRoot)AddIns/Sample/</OutputPath>
    <OpenDevelopHostBin>$(TestRoot)Host/</OpenDevelopHostBin>
    <OpenDevelopHostManifest>$(OpenDevelopHostBin)OpenDevelop.host-assemblies.txt</OpenDevelopHostManifest>
    <OpenDevelopDistributionBuild>true</OpenDevelopDistributionBuild>
    <OpenDevelopDistributionRidFamily>osx</OpenDevelopDistributionRidFamily>
  </PropertyGroup>
  <ItemGroup>
    <OpenDevelopAddinManifest Include="$(MSBuildThisFileDirectory)Sample.addin" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets" />
  <Target Name="Build" DependsOnTargets="Prepare;OpenDevelopDeployAddinManifest;OpenDevelopTrimAddinOutput;OpenDevelopPruneAddinDeploymentAssets;Assert">
  </Target>
  <Target Name="Prepare">
    <MakeDir Directories="$(OutputPath);$(OpenDevelopHostBin);$(OutputPath)ref;$(OutputPath)runtimes/win-x64;$(OutputPath)runtimes/osx" />
    <WriteLinesToFile File="$(OpenDevelopHostManifest)" Lines="Host.Shared.dll" Overwrite="true" />
    <WriteLinesToFile File="$(OpenDevelopHostBin)Host.Shared.dll" Lines="host" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)Host.Shared.dll" Lines="duplicate" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)Addin.Private.dll" Lines="private" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)Addin.Private.xml" Lines="documentation" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)Layout.xml" Lines="runtime layout" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)ref/Reference.dll" Lines="reference" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)runtimes/win-x64/native.dll" Lines="foreign" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)runtimes/osx/native.dylib" Lines="current" Overwrite="true" />
  </Target>
  <Target Name="Assert">
    <Error Condition="Exists('$(OutputPath)Host.Shared.dll')" Text="Host-provided DLL was not trimmed." />
    <Error Condition="!Exists('$(OutputPath)Addin.Private.dll')" Text="Addin-private DLL was incorrectly trimmed." />
    <Error Condition="!Exists('$(OutputPath)Sample.addin')" Text="Addin manifest was not deployed." />
    <Error Condition="Exists('$(OutputPath)Addin.Private.xml')" Text="Assembly XML documentation was not pruned." />
    <Error Condition="!Exists('$(OutputPath)Layout.xml')" Text="Runtime XML layout was incorrectly pruned." />
    <Error Condition="Exists('$(OutputPath)ref/Reference.dll')" Text="Reference asset was not pruned." />
    <Error Condition="Exists('$(OutputPath)runtimes/win-x64/native.dll')" Text="Foreign runtime asset was not pruned." />
    <Error Condition="!Exists('$(OutputPath)runtimes/osx/native.dylib')" Text="Current-platform runtime asset was incorrectly pruned." />

    <!-- F5-debug support (see doc/technotes/stride-game-studio.md "Part 1"): the SDK must make an
         InProcess addin startable by emitting the same Start* properties DotNetStartBehavior reads,
         without requiring OutputType=Exe - a Library becomes startable purely because StartAction
         is Program and StartProgram is non-empty; OutputType is never consulted. -->
    <Error Condition="'$(StartAction)' != 'Program'" Text="StartAction was not set to Program; F5 would not know how to launch this addin ($(StartAction))." />
    <Error Condition="'$(StartProgram)' == ''" Text="StartProgram is empty; F5 would launch nothing." />
    <Error Condition="!$(StartProgram.EndsWith('OpenDevelop'))" Text="StartProgram did not resolve to the host apphost under OpenDevelopHostBin ($(StartProgram))." />
    <Error Condition="!$(StartArguments.Contains('-addindir:'))" Text="StartArguments is missing -addindir:, so the child instance would never load this addin ($(StartArguments))." />
    <Error Condition="!$(StartArguments.Contains('-configdir:'))" Text="StartArguments is missing -configdir:, so the child instance would clobber the developer's own profile ($(StartArguments))." />
    <Error Condition="!$(StartArguments.Contains('-devflow:off'))" Text="StartArguments is missing -devflow:off, so the child instance would fight the parent for the DevFlow port ($(StartArguments))." />
    <!-- The trailing-quote/backslash mangling SplashScreenForm.SetCommandLineArgs does on a
         directory argument that ends in a separator (see SharpDevelopMain.cs) - StartArguments
         must never hand it one. -->
    <Error Condition="$(StartArguments.Contains('&quot;/&quot;')) or $(StartArguments.Contains('\&quot;'))" Text="A StartArguments directory value has a trailing separator before its closing quote, which SplashScreenForm mangles into a stray backslash ($(StartArguments))." />

    <Message Importance="high" Text="OpenDevelop Addin SDK deployment test passed." />
  </Target>
</Project>
