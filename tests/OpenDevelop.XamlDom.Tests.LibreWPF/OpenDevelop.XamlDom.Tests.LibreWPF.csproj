<Project Sdk="LibreWPF.Sdk">

  <!-- Host for the shared XamlDom tests (../OpenDevelop.XamlDom.Tests.Shared) that runs them against LibreWPF
       (portable LibreWPF.Transport) on Windows and macOS. XamlDom is the net10.0-windows build, which LibreWPF.Sdk
       compiles against LibreWPF. The Microsoft WPF counterpart is OpenDevelop.XamlDom.Tests.MicrosoftWPF.
       Run with the dotnet test command on this project (Microsoft.Testing.Platform). -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OpenDevelop.XamlDom.Tests.Shared\**\*.cs" LinkBase="Shared" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\..\externals\vscode-wpf\external\WpfDesigner\WpfDesign.XamlDom\Project\WpfDesign.XamlDom.csproj" />
  </ItemGroup>
</Project>
