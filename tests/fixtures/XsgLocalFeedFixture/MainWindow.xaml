<Window x:Class="XsgLocalFeedFixture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XsgLocalFeedFixture"
        Title="XSG local-feed fixture">
  <Grid Loaded="OnLoadedA">
    <StackPanel x:DataType="local:Probe">
      <TextBlock x:Name="Status" Text="{= 'Hot reload ready'}" />
      <TextBlock x:Name="Marker" Text="not loaded" />
      <TextBlock x:Name="Spare" Text="spare" />
      <TextBlock x:Name="Classic" Text="{Binding Age}" />
      <TextBlock x:Name="Simple" Text="{Label}" />
      <TextBlock x:Name="Explicit" Text="{.Label}" />
      <TextBlock x:Name="LambdaRan" Text="not run" Loaded="{(s, e) => LambdaRan!.Text = 'lambda ran'}" />
      <TextBlock x:Name="Computed" Text="{Age + 1}" />
      <TextBlock x:Name="Described" Text="{$'{Label}: {Age}'}" />
    </StackPanel>
  </Grid>
</Window>
