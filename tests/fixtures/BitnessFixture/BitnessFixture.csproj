<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- A debuggee's bitness is the bitness of the process the debugger starts. With a dll it is
         always the runner's own dotnet; the journeys need the per-RID apphost instead. -->
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <!-- One fixture, one RID per debugger journey: the release check passes
       -p:RuntimeIdentifier=<rid> -p:SelfContained=false, which produces an apphost of that
       architecture and still resolves the runtime the way the product does (we ship the app, the
       user installs the .NET runtime). The check installs the target architecture's runtime on the
       runner rather than bundling one here. -->
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
