<Project Sdk="Microsoft.NET.Sdk">

  <!-- A small WPF application for the Profiler tests: a timer keeps the UI thread busy in a known method, so a
       capture sees a dispatcher thread with framework frames above user code. Windows only. Standalone; built by
       the integration test project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
