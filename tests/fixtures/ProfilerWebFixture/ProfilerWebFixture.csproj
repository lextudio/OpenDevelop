<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A minimal ASP.NET Core service for the Profiler tests: GET /work spins in a known hot method, so a capture
       under request load has the Kestrel pipeline above it and user code below. Standalone; built by the
       integration test project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
