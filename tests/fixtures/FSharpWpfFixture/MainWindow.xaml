<Window x:Class="Sample.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:FSharpWpfFixture.Lib;assembly=FSharpWpfFixture.Lib" Title="F# XSG" Width="360" Height="220" x:DataType="lib:Person">
  <Window.Resources>
    <lib:UpperConverter x:Key="Upper" />
    <DataTemplate x:Key="Row"><TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" /></DataTemplate>
  </Window.Resources>
  <StackPanel Margin="8">
    <TextBlock x:Name="greeting" Style="{StaticResource Title}" Text="{lib:Hello World}" />
    <TextBlock x:Name="who" Text="{Binding Name}" />
    <TextBox x:Name="edit" Text="{Binding Age, Mode=TwoWay}" />
    <ListBox x:Name="list" ItemTemplate="{StaticResource Row}" />
    <Button x:Name="ok" Content="OK" Click="OnOk" />
  </StackPanel>
</Window>
