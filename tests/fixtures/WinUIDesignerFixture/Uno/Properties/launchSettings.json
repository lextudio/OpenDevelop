{
  "profiles": {
    // Uno's own desktop profile and its WSL2 sibling, which this IDE does not start and must not list.
    "UnoXamlSample (Desktop)": {
      "commandName": "Project",
      "compatibleTargetFramework": "desktop"
    },
    "UnoXamlSample (Desktop WSL2)": {
      "commandName": "WSL2",
      "commandLineArgs": "{ProjectDir}/bin/Debug/net10.0-desktop/UnoXamlSample.dll",
      "distributionName": "",
      "compatibleTargetFramework": "desktop"
    },
    // Uno's templates ship no mobile profiles; this IDE writes them with the same field.
    "UnoXamlSample (iOS)": {
      "commandName": "Project",
      "compatibleTargetFramework": "ios"
    },
    "UnoXamlSample (Android)": {
      "commandName": "Project",
      "compatibleTargetFramework": "android"
    }
  }
}
