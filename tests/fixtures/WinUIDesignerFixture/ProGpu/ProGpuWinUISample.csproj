<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Independent ProGPU WinUI fixture.  The package marker selects the WinUI XAML
         language model; OD_WINUI_RUNTIME=progpu selects the ProGPU preview backend. -->
    <UseProGpuWinUI>true</UseProGpuWinUI>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Uno.WinUI" Version="5.0.0" ExcludeAssets="all" />
  </ItemGroup>
</Project>
