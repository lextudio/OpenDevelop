<Project Sdk="LibreWPF.Sdk">

  <!-- The executable the class library's debug options launch. It is not part of the solution the
       test opens; the integration test project builds it ahead of time. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotReloadClassLibHost</RootNamespace>
    <AssemblyName>HotReloadClassLibHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Lib/HotReloadClassLib.csproj" />
  </ItemGroup>

</Project>
