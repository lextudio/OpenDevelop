<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="resourceWindow">
    <property name="title">GResource preview</property>
    <property name="default-width">240</property>
    <property name="default-height">160</property>
    <child>
      <object class="GtkImage" id="resourceImage">
        <property name="resource">/org/opendevelop/gtk-designer-fixture/fixture-mark.svg</property>
      </object>
    </child>
  </object>
</interface>
