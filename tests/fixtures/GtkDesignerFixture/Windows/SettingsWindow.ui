<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="settingsWindow">
    <property name="title">Settings</property>
    <property name="default-width">480</property>
    <property name="default-height">320</property>
    <child>
      <object class="GtkBox" id="settingsBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="settingsHeading">
            <property name="label">Preferences</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="displayNameEntry">
            <property name="placeholder-text">Display name</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
