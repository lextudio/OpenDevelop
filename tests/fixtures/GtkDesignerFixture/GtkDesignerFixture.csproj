<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Windows/MainWindow.ui" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Windows/SettingsWindow.ui" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Windows/ResourceWindow.ui" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Windows/TemplatePanel.ui" CopyToOutputDirectory="PreserveNewest" />
    <!-- The nested-selection journey's GtkBuilder document; it deliberately has two top-level objects
         and an id-referencing property, so it stays a document of its own rather than replacing MainWindow.ui. -->
    <None Update="ui/mainWindow.ui" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Windows/TemplatePanel.ui" />
    <None Update="Windows/Resources.gresource.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Windows/fixture-mark.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
  </ItemGroup>
</Project>
