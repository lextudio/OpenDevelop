<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The starting point of RuntimeUpgradeIntegrationTests, which retargets this file to net11.0
         and checks it still builds and debugs. Keep this value on its own line - the test rewrites it. -->
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- Explicit Compile item: this repo's MSBuildBasedProject/RoslynWorkspaceHelper reads
       project.GetItemsOfType(ItemType.Compile) to build the Roslyn workspace, and does not expand
       the SDK's implicit-glob Compile items - without this, ParserService.Parse() (and therefore
       DevFlow's od.open-file/od.debug.set-breakpoint) fails with a NullReferenceException. -->
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
