<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application WinUIHotReloadEndToEndTests launches and hot-reloads for real. Unpackaged and
       Windows App SDK self-contained, so it runs straight from bin with no runtime installed and no
       MSIX deployment - the shape the WinUI Hot Reload agent supports today. Built once per
       architecture (OpenDevelop.Base.Tests drives that) because the agent must load the TAP that
       matches the application process, and x86/x64/ARM64 each need proving. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinUIHotReloadFixture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

</Project>
