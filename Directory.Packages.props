<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Vendored UI libraries retain their upstream package policy. Avoid placing
       configuration files inside their working trees/submodules. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\\', '/').Contains('/src/Libraries/AvalonDock')) Or $([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\\', '/').Contains('/src/Libraries/AvalonEdit'))">
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AltCover" Version="9.0.102" />
    <PackageVersion Include="DataGridExtensions" Version="2.9.1" />
