<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Force transitive dependencies onto the versions pinned here; without it a package can
         drag in an older, vulnerable release (NU1902/NU1903) behind our back. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- The lextudio GitHub Packages build of 1.0.2 contains native assets for every supported Terminal RID. -->
    <LibGhosttyNetVersion>1.0.2</LibGhosttyNetVersion>
    <!-- lextudio's SharpDbg build: the DAP adapter and its whole dependency closure, published by
         the sharpdbg repository's own workflow (publish-opendevelop-packages.yml). The debugger add-in used
         to build that project from source on every build; it now restores this package and copies the
         adapter out, like the other lextudio packages below. -->
    <SharpDbgCliVersion>1.0.0-lextudio.42442298700.1</SharpDbgCliVersion>
    <!-- lextudio's SharpDbg Android debug agents (three NativeAOT ABIs) plus the license and SBOM
         metadata OpenDevelop redistributes with them. Built once by the same sharpdbg workflow, so
         no OpenDevelop job needs the .NET 11 preview SDK, the Android workload or an NDK. -->
    <SharpDbgAndroidAgentVersion>1.0.0-lextudio.42442298700.1</SharpDbgAndroidAgentVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AltCover" Version="9.0.102" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="DataGridExtensions" Version="2.9.1" />
    <!-- Published by the AvalonDock fork's workflow, like the AvalonEdit package below; both replaced a vendored
         submodule that carried its own provider pins. -->
    <PackageVersion Include="Dirkster.AvalonDock.Core" Version="5.0.1" />
    <PackageVersion Include="Dirkster.AvalonDock.LibreWPF" Version="5.0.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS.LibreWPF" Version="5.0.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS2013.LibreWPF" Version="5.0.1" />
    <!-- Published by the AvalonEdit fork's own workflow (nuget.pkg.github.com/lextudio). It replaced the
         src/Libraries/AvalonEdit submodule, whose vendored global.json pinned its own LibreWPF.Sdk and had to be
         bumped with every provider release; the package carries that pin instead. -->
    <PackageVersion Include="ICSharpCode.AvalonEdit.LibreWPF" Version="6.3.1.122" />
    <!-- The lextudio/wpftoolkit fork (the community edition, Ms-PL, of the toolkit originally published by Xceed Software
         Inc.; the id carries no Xceed name because Ms-PL 3(A) grants no trademark rights, but the assembly is still
         Xceed.Wpf.Toolkit). Published by the fork's own workflow to GitHub Packages; it replaced the
         externals/wpftoolkit submodule. -->
    <PackageVersion Include="LeXtudio.Wpf.Toolkit" Version="3.7.2" />
    <!-- ILSpy's decompiler and its non-UI service layer, taken from the published packages instead
         of from the externals/ilspy submodule. The two OpenDevelop patches that used to force a
         source build now live on this side of the boundary: see Dom/ITreeNodeModelOwner.cs
         (SharpTreeNode.Model/GetModel) and Controls/TreeView/RangeCollapsingItemsSource.cs
         (TreeFlattener's ranged-notification fix). ICSharpCode.ILSpyX also carries the
         ICSharpCode.ILSpyX.TreeView types, which are not published as a package of their own. -->
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.0.0.9375" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.0" />
    <PackageVersion Include="ICSharpCode.ILSpyX" Version="11.0.0.9375" />
    <PackageVersion Include="GirCore.Gtk-4.0" Version="0.8.1" />
    <PackageVersion Include="GirCore.Adw-1" Version="0.8.1" />
    <PackageVersion Include="GuiLabs.Language.Xml" Version="1.2.93" />
    <!-- Derives the assembly version from git tags; see GitVersion.yml. -->
    <PackageVersion Include="GitVersion.MsBuild" Version="6.5.1" />
    <PackageVersion Include="LeXtudio.DevFlow.Agent.Core" Version="0.3.1" />
    <!-- Published by the sharpdbg repository's publish-opendevelop-packages.yml to GitHub Packages. -->
    <PackageVersion Include="LeXtudio.SharpDbg.Cli" Version="$(SharpDbgCliVersion)" />
    <PackageVersion Include="LeXtudio.SharpDbg.AndroidAgent" Version="$(SharpDbgAndroidAgentVersion)" />
    <!-- Published by the lextudio/libghostty-net fork to GitHub Packages. -->
    <PackageVersion Include="LibGhostty.Net" Version="$(LibGhosttyNetVersion)" />
    <PackageVersion Include="Porta.Pty" Version="2.2.3" />
    <PackageVersion Include="LeXtudio.DevFlow.Agent.LibreWpf" Version="0.3.1" />
    <PackageVersion Include="WpfHotReload.Runtime" Version="0.1.0-ci.1" />
    <!-- <PackageVersion Include="LeXtudio.DevFlow.Agent.Wpf" Version="0.3.0" /> -->
    <PackageVersion Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- Transitive via Uno; 0.21.2 is flagged NU1903. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageVersion Include="Microsoft.Build" Version="18.8.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.8.2" />
    <PackageVersion Include="Microsoft.Build.Runtime" Version="18.8.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <!-- Reads a memory dump of the profiled process for the content-based heap insights (duplicate strings, sparse
         arrays) that the GC heap events cannot give; see doc/technotes/profiler.md. -->
    <PackageVersion Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <!-- Reads the EventPipe .nettrace files the Profiler add-in captures (CPU samples and the
         GC heap-snapshot events); see doc/technotes/profiler.md. -->
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Msagl" Version="1.1.6" />
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.4.0" />
    <PackageVersion Include="Microsoft.TemplateEngine.Abstractions" Version="10.0.302" />
    <PackageVersion Include="Microsoft.TemplateEngine.Edge" Version="10.0.302" />
    <PackageVersion Include="Microsoft.TemplateEngine.IDE" Version="10.0.302" />
    <PackageVersion Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="10.0.302" />
    <PackageVersion Include="Microsoft.TemplateEngine.Utils" Version="10.0.302" />
    <!-- Microsoft.VisualStudio.Text.Data/Logic/UI and CoreUtility are NOT Microsoft's NuGet packages: those
         are licensed under "MICROSOFT SOFTWARE LICENSE TERMS - MICROSOFT VISUAL STUDIO ADD-ONs and
         EXTENSIONS" (Visual Studio use only, no redistribution inside another application), while the source
         repository is MIT. These are the lextudio/vs-editor-api fork's MIT builds, published to GitHub Packages
         under the same ids (version 17.3.198.1: the August 2022 sources, a subset of Microsoft's 17.3.198).
         NuGet.Config maps the four ids to the lextudio sources only, never nuget.org. -->
    <PackageVersion Include="Microsoft.VisualStudio.CoreUtility" Version="17.3.198.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Text.Data" Version="17.3.198.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Text.Logic" Version="17.3.198.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Text.UI" Version="17.3.198.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading" Version="17.13.2" />
    <PackageVersion Include="Microsoft.VisualStudio.Validation" Version="17.13.22" />
    <PackageVersion Include="System.ComponentModel.Composition" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageVersion Include="Mono.TextTemplating" Version="3.0.0" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnitLite" Version="4.4.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.6" />
    <!-- Not referenced by any project here. It is a transitive pin: StreamJsonRpc, Microsoft.TemplateEngine.*
         and NuGet.Packaging each ask only for 13.0.3, and this lifts them all to 13.0.4. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Not directly used by app code - Microsoft.Build.NuGetSdkResolver.dll (from
         Microsoft.Build.Runtime) loads this by reflection at a fixed version
         (Version=7.6.0.0 as of Microsoft.Build 18.8.2) to resolve NuGet-based custom
         MSBuild Sdks (e.g. Sdk="LibreWPF.Sdk") in-process. Without an explicit reference
         it is never copied to output, so any in-process project open/evaluate that hits
         such an Sdk throws "SDK Resolver Failure: ... Could not load file or assembly
         'NuGet.Commands, Version=7.6.0.0...'" - see SharpDevelop.csproj's reference. -->
    <PackageVersion Include="NuGet.Commands" Version="7.6.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.6.0" />
    <PackageVersion Include="ProGPU.System.Drawing.Common" Version="0.1.0-preview.69" />
    <!-- Only the Microsoft WinUI host references this explicitly; it pins the same version
         Uno.Sdk already brings into WinUIXamlDesigner.UnoHost, so the DesignHost.cs both hosts
         share encodes exported PNGs through one identical Skia build. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="System.CodeDom" Version="10.0.10" />
    <!-- Must match what the ILSpy addin binds to. Transitive pinning is off, so ILSpyAddIn's
         dependency chain (TomsToolbox.Composition) resolves 10.0.11 while this pin gave the shell
         10.0.10. Both load into one process and the shell's output directory is the probing base,
         so the addin's MEF composition died at startup with "Could not load ...
         System.Composition.AttributedModel, Version=10.0.0.11" - surfacing as every od.ilspy.*
         action failing inside ICSharpCode.ILSpy.App.Initialize(). -->
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.11" />
    <PackageVersion Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageVersion Include="System.IO.Packaging" Version="11.0.0-preview.5.26302.115" />
    <!-- Patched releases of transitive deps pulled in by LibreWPF; 10.0.11 trips NU1902/NU1903. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Net.Http.Json" Version="11.0.0-preview.5.26302.115" />
    <PackageVersion Include="System.Windows.Extensions" Version="11.0.0-preview.5.26302.115" />
    <PackageVersion Include="TomsToolbox.Composition.Analyzer" Version="2.24.0" />
    <!-- ICSharpCode.Core references this directly for MessageBus<T>'s WeakEventSource<T> (moved
         from ILSpyAddIn's own MessageBus.cs, which used the same package transitively via
         TomsToolbox.Wpf) - it's a dependency-free, non-WPF module, safe for the foundational Core
         project. Pinned to match the sibling TomsToolbox.* packages below. -->
    <PackageVersion Include="TomsToolbox.Essentials" Version="2.24.0" />
    <PackageVersion Include="TomsToolbox.Composition.MicrosoftExtensions" Version="2.24.0" />
    <PackageVersion Include="TomsToolbox.Wpf.Composition.AttributedModel" Version="2.24.0" />
    <PackageVersion Include="TomsToolbox.Wpf.Styles" Version="2.24.0" />
    <PackageVersion Include="UiPath.Workflow" Version="6.0.3" />
    <PackageVersion Include="log4net" Version="3.3.2" />
    <!-- xUnit v3 UI-thread attributes for the maintained WPF/AvalonEdit unit tests. Version 3.0.13
         depends on xunit.v3.extensibility.core 3.0.0, satisfied by the repository's xunit.v3 3.2.2. -->
    <PackageVersion Include="Xunit.StaFact" Version="3.0.13" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
