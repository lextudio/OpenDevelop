    <PackageVersion Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Microsoft.Build" Version="18.8.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.8.2" />
    <PackageVersion Include="Microsoft.Build.Runtime" Version="18.8.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
