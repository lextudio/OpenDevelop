<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- LibGhostty.Net 1.0.3 contains the verified Windows ARM64 terminal assets and is used where win-arm64 assets are built or shipped only
         (Directory.Packages.props); other builds restore 1.0.2, which nuget.org also serves, so LibGhostty.Net is mapped
         to both sources. OpenAvalon CI also publishes the LibreWPF family to this organization feed. -->
    <add key="lextudio-github" value="https://nuget.pkg.github.com/lextudio/index.json" />
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="dotnet-libraries-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-libraries-transport/nuget/v3/index.json" />
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
    <add key="dotnet11-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11-transport/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="LeXtudio.DevFlow.*" />
      <package pattern="LibGhostty.Net" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="lextudio-github">
      <package pattern="LibGhostty.Net" />
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.*" />
    </packageSource>
    <!-- Submodules that carry their own nuget.config with <clear/> (currently externals/sharpdbg,
         which added one upstream) see only the sources that config declares, while this file's
         mapping is still merged in - so every pattern here points at a source key that no longer
         exists for them and restore fails with NU1100 naming sources that were never even
         considered. Mapping the submodule's own key ("nuget", plain nuget.org) restores it.
         Inert for this repo's own restore: the packages still match nuget.org's "*" above. A
         package matching several patterns is resolved from the sources of its most specific
         (longest) matching pattern, and from the union of the sources that share that pattern; so
         the "*" entries of nuget.org and "nuget" are unioned, while an exact or longer pattern on
         one source (the GitHub Packages dependencies on lextudio-github) wins
         over "*" - restore reports the sources it did not consider (NU1101) when it fails. -->
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-libraries-transport">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11-transport">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
