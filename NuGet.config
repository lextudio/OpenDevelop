<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- LibGhostty.Net deliberately retains upstream's version.  Keep this checkout's extracted
         packages out of the user-wide cache so a bare project-level test command cannot reuse
         nuget.org's same-version package instead of the verified fork. -->
    <add key="globalPackagesFolder" value="artifacts/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The OpenAvalon closure is synchronized from GitHub Packages by sync-openavalon-feed.ps1.
         Builds consume this project-local directory and therefore never need a package token. -->
    <add key="opendevelop-openavalon-local" value="artifacts/openavalon-feed" />
    <!-- LibGhostty.Net 1.0.2 is the lextudio fork with native assets for every supported Terminal platform. -->
    <add key="lextudio-github" value="https://nuget.pkg.github.com/lextudio/index.json" />
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="dotnet-libraries-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-libraries-transport/nuget/v3/index.json" />
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
    <add key="dotnet11-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11-transport/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="LeXtudio.DevFlow.*" />
      <!-- These WinUI designer packages are outside OpenAvalon's published native closure. They
           intentionally remain on nuget.org at their compatible published versions. -->
      <package pattern="ProGPU.WinUI.Designer" />
      <package pattern="ProGPU.WinUI.Themes.Fluent" />
      <package pattern="ProGPU.Xaml" />
      <package pattern="ProGPU.Xaml.Roslyn" />
      <package pattern="ProGPU.Xaml.Workspaces" />
      <!-- Exact package mappings below take precedence over this fallback; in particular,
           LibGhostty.Net is eligible only from the local/GitHub OpenAvalon sources. -->
      <package pattern="*" />
    </packageSource>
    <packageSource key="lextudio-github">
      <!-- Published by the AvalonDock and AvalonEdit forks, which used to be submodules here. Exact ids,
           listed identically on the local source below: a package is resolved from the sources of its
           most specific pattern, and from the union of the sources that share it, so CI restores them
           from GitHub Packages with its token and a local build from the synchronized feed without one. -->
      <package pattern="Dirkster.AvalonDock.Core" />
      <package pattern="Dirkster.AvalonDock.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Serializer.Xml" />
      <package pattern="Dirkster.AvalonDock.Themes.VS.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Themes.VS2013.LibreWPF" />
      <package pattern="ICSharpCode.AvalonEdit.LibreWPF" />
      <package pattern="LibGhostty.Net" />
      <!-- CI restores the same explicit OpenAvalon closure from GitHub Packages with its ephemeral
           GITHUB_TOKEN. Local dist wrappers first synchronize these packages into the source below. -->
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.Avalonia" />
      <package pattern="ProGPU.Backend" />
      <package pattern="ProGPU.Backend.Dawn" />
      <package pattern="ProGPU.Backend.Dx12" />
      <package pattern="ProGPU.Backend.Native" />
      <package pattern="ProGPU.Native.Sdk" />
      <package pattern="ProGPU.Compute" />
      <package pattern="ProGPU.DirectX" />
      <package pattern="ProGPU.Layout" />
      <package pattern="ProGPU.Media" />
      <package pattern="ProGPU.Media.Scene" />
      <package pattern="ProGPU.Scene" />
      <package pattern="ProGPU.SkiaSharp" />
      <package pattern="ProGPU.System.Drawing.Common" />
      <package pattern="ProGPU.Text" />
      <package pattern="ProGPU.Text.Shaping" />
      <package pattern="ProGPU.Transpiler" />
      <package pattern="ProGPU.Vector" />
      <package pattern="ProGPU.Virtualization" />
      <package pattern="ProGPU.WinRT" />
      <package pattern="ProGPU.WinUI" />
    </packageSource>
    <packageSource key="opendevelop-openavalon-local">
      <package pattern="LibGhostty.Net" />
      <package pattern="Dirkster.AvalonDock.Core" />
      <package pattern="Dirkster.AvalonDock.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Serializer.Xml" />
      <package pattern="Dirkster.AvalonDock.Themes.VS.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Themes.VS2013.LibreWPF" />
      <package pattern="ICSharpCode.AvalonEdit.LibreWPF" />
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.Avalonia" />
      <package pattern="ProGPU.Backend" />
      <package pattern="ProGPU.Backend.Dawn" />
      <package pattern="ProGPU.Backend.Dx12" />
      <package pattern="ProGPU.Backend.Native" />
      <package pattern="ProGPU.Native.Sdk" />
      <package pattern="ProGPU.Compute" />
      <package pattern="ProGPU.DirectX" />
      <package pattern="ProGPU.Layout" />
      <package pattern="ProGPU.Media" />
      <package pattern="ProGPU.Media.Scene" />
      <package pattern="ProGPU.Scene" />
      <package pattern="ProGPU.SkiaSharp" />
      <package pattern="ProGPU.System.Drawing.Common" />
      <package pattern="ProGPU.Text" />
      <package pattern="ProGPU.Text.Shaping" />
      <package pattern="ProGPU.Transpiler" />
      <package pattern="ProGPU.Vector" />
      <package pattern="ProGPU.Virtualization" />
      <package pattern="ProGPU.WinRT" />
      <package pattern="ProGPU.WinUI" />
    </packageSource>
    <!-- Submodules that carry their own nuget.config with <clear/> (currently externals/sharpdbg,
         which added one upstream) see only the sources that config declares, while this file's
         mapping is still merged in - so every pattern here points at a source key that no longer
         exists for them and restore fails with NU1100 naming sources that were never even
         considered. Mapping the submodule's own key ("nuget", plain nuget.org) restores it.
         Inert for this repo's own restore: the packages still match nuget.org's "*" above. A
         package matching several patterns is resolved from the sources of its most specific
         (longest) matching pattern, and from the union of the sources that share that pattern; so
         the "*" entries of nuget.org and "nuget" are unioned, while an exact or longer pattern on
         one source (the GitHub Packages dependencies on lextudio-github) wins
         over "*" - restore reports the sources it did not consider (NU1101) when it fails. -->
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-libraries-transport">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11-transport">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
