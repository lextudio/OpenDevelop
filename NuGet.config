<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local LibreWPF build carrying the macOS menu-popup fixes (input coordinates,
         popup DPI clamp, native popup shadow). Remove once these ship on nuget.org. -->
    <add key="librewpf-local" value="/Users/lextm/wpf-tools/openavalon/artifacts/local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="dotnet-libraries-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-libraries-transport/nuget/v3/index.json" />
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
    <add key="dotnet11-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11-transport/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Most specific pattern wins, so only these resolve locally. -->
    <packageSource key="librewpf-local">
      <package pattern="LibreWPF.Interop" />
      <package pattern="LibreWPF.ProGPU" />
      <package pattern="LibreWPF.Sdk" />
      <package pattern="LibreWPF.Transport" />
      <!-- Carries the stroke-thickness fix for scaled strokes (wieslawsoltes/ProGPU#86); without
           it the drop-target compass glyphs render as solid blocks. Drop this line and the local
           package once a ProGPU release containing that fix is on nuget.org.

           This pattern also covers ProGPU.Xaml, ProGPU.Xaml.Roslyn, ProGPU.Xaml.Workspaces and
           ProGPU.WinUI.Designer, which the WinUI/Uno designer needs but upstream never published.
           They are packed locally from the very commit that produced the published preview.47
           feed (wieslawsoltes/ProGPU bab4dbef993f2b2d722ff46689021604c2e9b947, recorded in the
           ProGPU.WinUI nuspec), so there is no version skew against LibreWPF.ProGPU preview.41:

             git clone https://github.com/wieslawsoltes/ProGPU.git && cd ProGPU
             git worktree add ../progpu-p47 bab4dbef993f2b2d722ff46689021604c2e9b947
             # that commit's global.json pins SDK 10.0.201; relax it if only 10.0.200 is installed
             for p in ProGPU.Xaml ProGPU.Xaml.Roslyn ProGPU.Xaml.Workspaces ProGPU.WinUI.Designer; do
               dotnet pack ../progpu-p47/src/$p/$p.csproj -c Release -o <this local feed>
             done

           Delete the locally packed copies once ProGPU publishes these four packages itself. -->
      <package pattern="ProGPU.*" />
      <!-- Portable WinForms compat + WPF host, built from the LibreWinForms submodule
           (external/LibreWinForms in the librewpf checkout). Not published anywhere yet. -->
      <package pattern="LibreWinForms.System.Windows.Forms" />
      <package pattern="LibreWinForms.WindowsFormsIntegration" />

    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="LeXtudio.DevFlow.*" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-libraries-transport">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet11-transport">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
